theory FidoHardened
begin

/*
  PROFILE FidoHardened -- the same signature-based push-MFA WITH number matching (ROADMAP #7).
  Number matching = the shutout mitigation: every prompt requires an engaged-user value, so a reflexive
  (habituated) AUTO-approval is blocked (ShutoutBlocksAutoApprove). An engaged Attentive user can still
  approve its own login. Contrast FidoVuln (no number matching): there the injected login is authenticated.
  The pair proves, ON THE REAL SIGNATURE PROTOCOL, the RFC requirement REQ-MFA-NUMBER-MATCH.
  Run: check.py --prove ceremonies/fido_auth/FidoHardened.spthy
*/

builtins: signing

#include "../../core/types.spthy"
#include "protocol.spthy"

// -- shared human layer --
#include "../../core/transitions/mask_state.spthy"
#include "../../core/transitions/answered_once.spthy"
#include "../../core/masks/outcome_policy.spthy"
#include "../../core/masks/confirm_behavior.spthy"
#include "../../core/stressors/habituation.spthy"

// -- the mitigation: number matching on every prompt -> the challenge is Shutout-protected, so the
//    ShutoutBlocksAutoApprove restriction (core/mitigations.spthy) forbids a reflexive auto-approval. --
#include "../../core/mitigations.spthy"
rule Number_matching:
    [ !ChallengeShown('Alex', n) ]
  --[ Shutout(n) ]->
    [ ]

// number matching is MANDATORY: every prompt is shutout-protected (the system enforces it, not an option).
restriction NumberMatchingMandatory:
  "All n kind #c. Challenge(n, kind)@c ==> (Ex #s. Shutout(n)@s)"

// the ceremony still works for an engaged user: a legitimate (self) login is authenticated.
lemma FidoHardened_legit_auth_ok:
  exists-trace
  "Ex n #a #c. Authenticated('Alex', n)@a & Challenge(n, 'self')@c"

// THE GUARANTEE: an attacker-triggered (injected) login can NEVER be authenticated -- number matching
// blocks the reflexive auto-approval that the takeover relied on.
lemma FidoHardened_no_injected_auth:
  all-traces
  "All n #a #j. Authenticated('Alex', n)@a & Injected(n)@j ==> F"

end
