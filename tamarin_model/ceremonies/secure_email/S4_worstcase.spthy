theory SecureEmail_S4_Worstcase
begin
/*
  S4 -- WORST CASE on the real interface: three stressors pushing three different masks at once
  (sigma6 -> Naive, sigma2 -> Careless, sigma_ANXIETY -> Fearful), with every opt-in outcome row armed:
  the skipped fingerprint check, the OUT-OF-ORDER send, and the TLS misroute. PROPERTIES adds the
  agnostic attribution invariants -- including UP_premature_requires_degrade, which pins the ORDER
  violation to a prior degrade (an Attentive human can never take that route).
*/
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA6_ABSTRACTION
#define SIGMA2_CONCURRENCY
#define SIGMA_ANXIETY
#define OUTCOME_CARELESS_SKIPCHECK
#define OUTCOME_PREMATURE
#define OUTCOME_CARELESS_MISROUTE
#define PROPERTIES

#include "base.spthy"

lemma S4_abstraction_onset: exists-trace "Ex #i. Abstraction('Alex')@i"
lemma S4_distract_onset:    exists-trace "Ex #i. Distract('Alex')@i"
lemma S4_anxiety_onset:     exists-trace "Ex #i. SecurityAnxiety('Alex')@i"

lemma S4_premature_send: exists-trace "Ex #i. SendPremature('Alex')@i"
lemma S4_tls_misroute:   exists-trace "Ex m #i. PlaintextAtProvider(m)@i"

lemma S4_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)
     | (Ex p #d. MisaddressedSend(p)@d)"

lemma S4_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

// ---- (C) T5, the STRONG (ordered) form: the ceremony completes DESPITE the onset. ----
// The weak form ("Ex Send & Read") is satisfied by a trace in which the stressor NEVER FIRED, so in a
// STRESSED profile it says almost nothing. These pin the onset strictly BEFORE the stressed party's own
// completion step, so the witness is a trace where the human was ALREADY degraded and still finished.

lemma S4_worstcase_completes_under_sigma6:
  exists-trace
  "Ex m #o #s #r.
     Abstraction('Alex')@o & Send('Alex','PGP', m)@s & Read('Blake', m)@r
   & #o < #s"

lemma S4_worstcase_completes_under_sigma2:
  exists-trace
  "Ex m #o #s #r.
     Distract('Alex')@o & Send('Alex','PGP', m)@s & Read('Blake', m)@r
   & #o < #s"

lemma S4_worstcase_completes_under_anxiety:
  exists-trace
  "Ex m #o #s #r.
     SecurityAnxiety('Alex')@o & Send('Alex','PGP', m)@s & Read('Blake', m)@r
   & #o < #s"

end
