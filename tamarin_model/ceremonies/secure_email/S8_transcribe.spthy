theory SecureEmail_S8_Transcribe
begin

/*
  S8 -- the TRANSCRIBE profile, and the sigma10 CLOSURE. The field-entry action class is the whole story,
  and this profile proves the LOOP the plan asked for, end to end and IN ORDER:

      two co-present 'med' fields (To A2 + subject A5)  -- the additive-load surface (Sweller)
        -> SIGMA_ADDITIVE -> BUSY
        -> a field entry SLIPS (a fresh wrong value is committed) -> !Failed
        -> SIGMA10 RepeatedFailure -> CARELESS
        -> the subject entry is now EXPORTED (TranscribeLeak) -> Out(m) at send   [SubjectLeak]

  So the TWO outcomes of ONE action class are causally chained: the Busy slip is a SAFE-FAIL that does not
  leak -- but it is exactly what degrades the human into the Careless state where the next field entry DOES
  leak. That is the claim the transcribe class exists to make, and it is the loop the plan called for.

  Both masks (Busy AND Careless) are live here. That only fits the prover budget because the PATHWAY is
  gated -- with both pathways compiled in this profile did not terminate. See docs/DIVERGENCES.md.

  Also armed: OUTCOME_CARELESS_MISROUTE, so the Careless state additionally reaches the encryption
  selector's "Standard (TLS only)" exit -> PlaintextAtProvider (a NAMED unsafe outcome, never an Out).
  Run: check.py --prove ceremonies/secure_email/S8_transcribe.spthy
*/

#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA_ADDITIVE
#define SIGMA10_REPEATFAIL
#define OUTCOME_CARELESS_MISROUTE

#include "base.spthy"

// ---- onset coverage (lesson 16): one exists-trace per armed stressor ----
lemma S8_additive_onset:
  exists-trace "Ex #i. AdditiveLoad('Alex')@i"

lemma S8_repeatfail_onset:
  exists-trace "Ex #i. RepeatedFailure('Alex')@i"

// ---- THE SIGMA10 CLOSURE. DECOMPOSED, because carrying the whole chain in one exists-trace made the
// search wander (the profile sat 8s from the timeout). The two halves compose to exactly the same claim:
//   (a) the DEGRADATION causes the leak -- exists-trace: RepeatedFailure strictly BEFORE SubjectLeak
//   (b) the SLIP causes the degradation -- all-traces: sigma10 fires only on !Failed, and only a Slip
//       raises !Failed, so a RepeatedFailure ALWAYS has a Slip before it. This half is a THEOREM, not a
//       witness -- strictly STRONGER than pinning it inside one trace.
// Together: slip -> repeated-failure -> leak. (The AdditiveLoad onset is covered by S8_additive_onset;
// carrying it inside the chain only gave the search a fourth event to interleave.) ----
lemma S8_sigma10_closure:
  exists-trace
  "Ex #r #l. RepeatedFailure('Alex')@r & SubjectLeak('Alex')@l & #r < #l"

lemma S8_repeatfail_always_follows_a_slip:
  all-traces
  "All p #r. RepeatedFailure(p)@r ==> (Ex #s. Slip(p)@s & #s < #r)"

// ---- WHAT A SLIP IS, EXACTLY. A slip is not intrinsically a breach -- it is a wrong value in a field.
// Whether it breaches depends ENTIRELY on WHICH field:
//   * subject / passphrase : a wrong value is a SAFE-FAIL (the step just fails; nothing leaves)
//   * the To ADDRESS field : a wrong value MISADDRESSES the message -> it leaves the boundary
// Adding the A2 route made the old blanket claim "a slip alone is safe" FALSE -- and it should be false.
// The precise statement is the one below: a slip is not a leak route IN ITSELF; every K(m) still traces to
// one of the NAMED routes on the boundary list (of which the misaddressed send is now one).
lemma S8_slip_is_not_itself_a_leak:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
     & not (Ex p #d. SubjectLeak(p)@d)
     & not (Ex p #d. SendPremature(p)@d)
     & not (Ex p #d. ForwardedOutside(p)@d)
     & not (Ex p #d. MisaddressedSend(p)@d)
     & not (Ex p #d. LeakPw(p)@d)
     & not (Ex p #d. MisdeliveredPw(p)@d)
   ==> (Ex p vid #d. Mistake(p, vid)@d)"

// ...and the TWO ways a slip can hurt are now BOTH proved, which is the whole point of the class:
//   DIRECTLY  -- a slip in the address field misaddresses the message  (S8_to_field_misaddressed)
//   INDIRECTLY -- a slip anywhere raises !Failed -> sigma10 -> Careless -> the NEXT entry leaks
//                 (S8_sigma10_closure). The indirect route is the one no prior model could express.

// the OTHER outcome of the same field-entry class: a BUSY slip in the To field commits a fresh WRONG
// address, so the message is sent to someone who is not the correspondent (A2 finally drives an outcome).
// A leak route is not "modelled" until a profile proves it REACHABLE.
lemma S8_to_field_misaddressed:
  exists-trace "Ex #i. MisaddressedSend('Alex')@i"

// the Careless state also reaches the TLS exit -- a NAMED outcome, never an Out.
lemma S8_tls_misroute_chain:
  exists-trace "Ex m #i. PlaintextAtProvider(m)@i"

// ---- (S) T6: only the correspondents know m -- consumes the H_leak_routes [reuse] boundary list ----
lemma S8_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)
     | (Ex p #d. MisaddressedSend(p)@d)"

lemma S8_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

// ---- (C) T5, the STRONG (ordered) form: the ceremony completes DESPITE the onset ----
lemma S8_completes_under_onset:
  exists-trace
  "Ex m #o #s #r.
     AdditiveLoad('Alex')@o & Send('Alex','PGP', m)@s & Read('Blake', m)@r & #o < #s"

end
