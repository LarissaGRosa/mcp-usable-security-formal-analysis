/*
  protocol.spthy -- the secure_email ceremony layer (wire + UI prompts). Holds the rules SHARED by both
  variants (participants, stress targeting, NeqRecipient) and then conditionally includes ONE full flow
  (Alex sender + Blake recipient):

     sender_screens.spthy   (full-interface Screens A/B/C -- RELAYER; the only flow)
     #else              ->  sender_legacy.spthy    (method choice + ambient surfaces + pick/verify/send
                                                    + the legacy Blake receiver rules)

  The sender is SPLIT into two files (rather than gated with a nested #ifdef here) because tamarin's
  preprocessor cannot skip a nested #ifdef: the legacy sender's inner #ifdef SIGMA* blocks would break
  the skip. A conditionally-INCLUDED file is only inserted in the TAKEN branch, so its inner #ifdefs are
  always processed in an entered context (never skipped through). Retired to a single file in step 10.

  SIMPLIFIED MODEL (2026-07-10) -- built to isolate the stressor machinery as the ONLY route to a breach:
    * Out() means "information left the secure email boundary" and fires ONLY on a HUMAN MISTAKE made
      through a mask. Correct email is delivered on a PRIVATE Mailbox, the passphrase on a private OobPw.
    * Alex and Blake are each initiated ONCE; every human step is once-bounded (lesson 5).
    * CRYPTO is ABSTRACTED. The fingerprint offered to Alex is ADVERSARY-MEDIATED In(offered); the OOB
      reference is the correspondent identity. Tamperedness is DERIVED from the committed recipient
      (= 'Blake' -> genuine; else -> mistake), not a genuine/tampered rule branch (lesson 14).
*/

// ===================== participants (each initiated ONCE) =====================
rule P_init_alex [color=#1f6fd0]:
    [ Fr(~idA) ] --[ Start('Alex') ]-> [ AlexInit(~idA), !Party('Alex', ~idA) ]

rule P_init_blake [color=#1f6fd0]:
    [ Fr(~idB) ] --[ Start('Blake') ]-> [ BlakeInit(~idB), !Party('Blake', ~idB) ]

// shared by BOTH variants: a delivered/addressed recipient that is not the correspondent is a misdirect.
restriction NeqRecipient:
  "All r #i. Neq(r, 'Blake')@i ==> not (r = 'Blake')"

// ===================== stress targeting =====================
// Gated per party (STRESS_ALEX / STRESS_BLAKE) so a profile can stress ONE party: an unstressed party
// stays Attentive, so ITS degraded rules are unreachable and get PRUNED from the source precomputation
// (keeps the two-party full-interface surface within the prover budget). base.spthy defines BOTH for the
// legacy variant (preserving S0-S7 behaviour); screens profiles pick.
#ifdef STRESS_ALEX
rule Enable_Stress_Alex [color=#9b51e0]:
    [ !Party('Alex', id) ] --[ StressOn('Alex') ]-> [ !StressEnable('Alex') ]

restriction OnceStressAlex:
  "All #i #j. StressOn('Alex')@i & StressOn('Alex')@j ==> #i = #j"
#endif

#ifdef STRESS_BLAKE
rule Enable_Stress_Blake [color=#9b51e0]:
    [ !Party('Blake', id) ] --[ StressOn('Blake') ]-> [ !StressEnable('Blake') ]

restriction OnceStressBlake:
  "All #i #j. StressOn('Blake')@i & StressOn('Blake')@j ==> #i = #j"
#endif

// ===================== the full-interface flow (Screens A/B/C) =====================
#include "sender_screens.spthy"
