theory SecureEmail_S7_RecoveryCareless
begin
/*
  S7 -- the CARELESS recovery pair on Screen A. Competing co-present controls (sigma2) make Alex Careless
  and she skips the fingerprint check; a WARNING re-engagement recovers her to Attentive. The matched
  pair: the recovery is REACHABLE, and it REQUIRES the warning.
*/
#define IF_SCREENS
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA2_CONCURRENCY
#define OUTCOME_CARELESS_SKIPCHECK
#define MASK_RECOVERY
#define RECOVERY_WARNING
#define RECOVERY_MODEBREAK

#include "base.spthy"

lemma S7_distract_onset: exists-trace "Ex #i. Distract('Alex')@i"

lemma S7_recovers_to_attentive:
  exists-trace "Ex #d #r. Distract('Alex')@d & SetMask('Alex','Attentive')@r & #d < #r"

lemma S7_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)"

lemma S7_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

lemma S7_completes: exists-trace "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"
end
