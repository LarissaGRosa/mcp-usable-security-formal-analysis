/*
  experiments/S0_secure_email.spthy -- Profile S0 lemmas for the secure_email ceremony (C1).
  Profile = < C1 (both PGP and password pathways), {Attentive, Naive, Careless, Busy},
              {sigma6 Abstraction, sigma2 ExternalDistraction, sigma3 TimePressure}, on Alex AND Blake >.

  Headline goal (user): can a secure email reach the RIGHT recipient, and ONLY them read the
  content, in the presence of degraded masks? The lemmas answer it three ways:
    - the secure delivery is reachable on EACH pathway (happy paths);
    - secrecy holds whenever no degraded behaviour occurs (attentive_keeps_secret), and any
      adversary access is ATTRIBUTABLE to one named weak point (message_secrecy_attribution) --
      exactly the guide's caveats: skipped fingerprint verification, or an out-of-band password
      that wasn't (in-band leak / misdelivery);
    - each failure is genuinely reachable, at EITHER end (leak_* lemmas, incl. a recipient-side one).
*/

// ---- reachability: each pathway can deliver securely to Blake ----

lemma S0_happy_pgp:
  exists-trace
  "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

lemma S0_happy_pw:
  exists-trace
  "Ex m #s #r. Send('Alex','PW', m)@s & Read('Blake', m)@r"

// ---- only the intended recipient ever reads the plaintext (no honest misdelivery) ----

lemma S0_only_recipient_reads:
  all-traces
  "All p m #i. Read(p, m)@i ==> p = 'Blake'"

// ---- HEADLINE positive guarantee: with no degraded behaviour, the secret never leaks ----

lemma S0_attentive_keeps_secret:
  all-traces
  "All m #s.
     Secret(m)@s
     & not (Ex p vid #d. Mistake(p, vid)@d)
     & not (Ex p #d. LeakPw(p)@d)
     & not (Ex p #d. MisdeliveredPw(p)@d)
   ==> not (Ex #k. K(m)@k)"

// ---- HEADLINE attribution: any adversary access traces to ONE named weak point ----

lemma S0_message_secrecy_attribution:
  all-traces
  "All m #s #k.
     Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d)
     | (Ex p #d. LeakPw(p)@d)
     | (Ex p #d. MisdeliveredPw(p)@d)"

// ---- each degraded outcome is genuinely reachable ----

// PGP: skipping fingerprint verification (Naive under Abstraction) -> encrypt to the adversary.
lemma S0_leak_pgp_reachable:
  exists-trace
  "Ex m vid #s #d #k. Send('Alex','PGP', m)@s & Mistake('Alex', vid)@d & K(m)@k"

// Password, sender in-band leak (Careless) -> adversary decrypts; recipient still reads.
lemma S0_leak_pw_inband_reachable:
  exists-trace
  "Ex m #s #d #k. Send('Alex','PW', m)@s & LeakPw('Alex')@d & K(m)@k"

// Password, sender wrong-recipient slip (Busy) -> adversary decrypts, recipient locked out.
lemma S0_leak_pw_misdeliver_reachable:
  exists-trace
  "Ex m #s #d #k. Send('Alex','PW', m)@s & MisdeliveredPw('Alex')@d & K(m)@k"

// BOTH PARTIES MASKED: an Attentive send still leaks if the RECIPIENT is phished into
// re-disclosing the password (Blake degraded). Blake reads first, then leaks.
lemma S0_recipient_leak_reachable:
  exists-trace
  "Ex m #s #r #d #k.
     Send('Alex','PW', m)@s & Read('Blake', m)@r & LeakPw('Blake')@d & K(m)@k"
