/*
  experiments/S1_interface.spthy -- Profile S1 lemmas: the SENDING INTERFACE generates the stressors.
  Same secure-email ceremony as S0, but every stressor is INFERRED from an objective composer step
  (protocol/compose_ui.spthy) via the core detectors -- no designer flag. The lemmas show:
    - secure delivery is still reachable on each pathway (happy paths);
    - ANALYZER GUARANTEE: every mask degradation is generated by a named interface step;
    - each interface step's characteristic leak is reachable (confirm_key -> PGP key-substitution,
      set_passphrase -> password slip, choose_method -> decision-fatigue in-band leak);
    - the positive guarantee from S0 still holds (no degrade => no leak).
*/

// ---- reachability: each pathway still delivers securely to Blake ----

lemma S1_happy_pgp:
  exists-trace
  "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

lemma S1_happy_pw:
  exists-trace
  "Ex m #s #r. Send('Alex','PW', m)@s & Read('Blake', m)@r"

// ---- HEADLINE: every mask degradation is GENERATED BY a preceding interface step ----
// (there is no recovery edge here, so every SetMask is a degrade.)
lemma S1_degrade_from_interface_step:
  all-traces
  "All p m #s.
     SetMask(p, m)@s & not(m = 'Attentive')
   ==> (Ex step #u. UIStep(p, step)@u & #u < #s)"

// ---- the positive guarantee still holds: no degraded behaviour => the secret never leaks ----
lemma S1_attentive_keeps_secret:
  all-traces
  "All m #s.
     Secret(m)@s
     & not (Ex p vid #d. Mistake(p, vid)@d)
     & not (Ex p #d. LeakPw(p)@d)
     & not (Ex p #d. MisdeliveredPw(p)@d)
   ==> not (Ex #k. K(m)@k)"

// ---- each interface step's characteristic failure is reachable ----

// confirm_key step (sigma6 Abstraction, inferred from the 'verify' op) -> accept substituted key.
lemma S1_confirm_step_leaks_pgp:
  exists-trace
  "Ex m vid #u #d #s #k.
     UIStep('Alex','confirm_key')@u & Mistake('Alex', vid)@d & Send('Alex','PGP', m)@s & K(m)@k"

// set_passphrase step (sigma1 HighCognitiveLoad, inferred from the 'kdf' op) -> Busy slip.
lemma S1_passphrase_step_leaks_pw:
  exists-trace
  "Ex m #u #d #s #k.
     UIStep('Alex','set_passphrase')@u & MisdeliveredPw('Alex')@d & Send('Alex','PW', m)@s & K(m)@k"

// choose_method step (sigma9 AlertVolume, inferred from decision density) -> Careless in-band leak.
lemma S1_method_menu_leaks_pw:
  exists-trace
  "Ex m #u #d #s #k.
     UIStep('Alex','choose_method')@u & LeakPw('Alex')@d & Send('Alex','PW', m)@s & K(m)@k"
