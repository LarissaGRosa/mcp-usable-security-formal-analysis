/*
  experiments/S3_trio_mixed.spthy -- the MIXED trio {sigma6, sigma3-deadline, Anxiety}: one
  failure per pathway plus the Fearful freeze (the degradation that HELPS secrecy).
*/

#include "helpers.spthy"

// ---- security properties under this trio ----

// (the "attentive keeps secret" guarantee is this lemma's CONTRAPOSITIVE -- no degraded
// outcome => no adversary access -- so it holds by the same proof and is not proven twice.)
lemma S3_message_secrecy_attribution:
  all-traces
  "All m #s #k.
     Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d)
     | (Ex p #d. LeakPw(p)@d)
     | (Ex p #d. MisdeliveredPw(p)@d)"

// ---- one chain per stressor ----

// sigma6 on the PGP pathway.
lemma S3_abstraction_naive_substitution:
  exists-trace
  "Ex m vid #u #o #v #d #s.
     UIStep('Alex','btn_verify_fp')@u & Abstraction('Alex')@o
   & Verify('Alex', vid, 'Naive')@v & Mistake('Alex', vid)@d
   & Send('Alex','PGP', m)@s"

// sigma3-deadline on the password pathway.
lemma S3_deadline_pressure_misdelivery:
  exists-trace
  "Ex m #u #o #h #d #s #k.
     UIStep('Alex','btn_share_signal')@u & TimePressure('Alex')@o
   & Share('Alex','Busy')@h & MisdeliveredPw('Alex')@d
   & Send('Alex','PW', m)@s & K(m)@k"

// Anxiety on the send authorize: the Fearful sender freezes -- NO message ever leaves.
lemma S3_anxiety_fearful_freeze:
  exists-trace
  "Ex aid #u #o #a.
     UIStep('Alex','btn_send')@u & SecurityAnxiety('Alex')@o & Abort('Alex', aid)@a
   & not (Ex method m #s. Send('Alex', method, m)@s)"
