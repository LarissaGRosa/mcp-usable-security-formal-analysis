/*
  experiments/S4_worstcase.spthy -- the worst-case canary: all seven detectors, both parties,
  both opt-in rows. Baseline reachability + the secrecy pair + the analyzer guarantee; the
  per-stressor chains live in the trios (each a subset of this profile).
*/

#include "helpers.spthy"

lemma S4_happy_pgp:
  exists-trace
  "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

lemma S4_happy_pw:
  exists-trace
  "Ex m link #s #u #r.
     Send('Alex','PW', m)@s & Unlocked('Blake', link)@u & Read('Blake', m)@r"

// (the "attentive keeps secret" guarantee is this lemma's CONTRAPOSITIVE -- no degraded
// outcome => no adversary access -- so it holds by the same proof and is not proven twice.)
lemma S4_message_secrecy_attribution:
  all-traces
  "All m #s #k.
     Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d)
     | (Ex p #d. LeakPw(p)@d)
     | (Ex p #d. MisdeliveredPw(p)@d)"

lemma S4_degrade_from_interface_step:
  all-traces
  "All p m #s.
     SetMask(p, m)@s & not(m = 'Attentive')
   ==> (Ex step #u. UIStep(p, step)@u & #u < #s)"
