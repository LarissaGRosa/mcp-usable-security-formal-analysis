/*
  experiments/S2_trio_pw.spthy -- the PASSWORD trio {sigma1, sigma3-deadline, sigma9}: the
  password's channel is the whole game. Includes the EMERGENT phishing chain: Eve's password
  request arrives over the open mail channel and a Load-degraded recipient misdelivers.
*/

#include "helpers.spthy"

// ---- security properties under this trio ----

// (the "attentive keeps secret" guarantee is this lemma's CONTRAPOSITIVE -- no degraded
// outcome => no adversary access -- so it holds by the same proof and is not proven twice.)
lemma S2_message_secrecy_attribution:
  all-traces
  "All m #s #k.
     Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d)
     | (Ex p #d. LeakPw(p)@d)
     | (Ex p #d. MisdeliveredPw(p)@d)"

lemma S2_degrade_from_interface_step:
  all-traces
  "All p m #s.
     SetMask(p, m)@s & not(m = 'Attentive')
   ==> (Ex step #u. UIStep(p, step)@u & #u < #s)"

// ---- one chain per stressor ----

// sigma1: the passphrase compute is MentalDemand-hi -> Busy -> misdelivered password.
lemma S2_load_busy_misdelivery:
  exists-trace
  "Ex m #u #o #h #d #s #k.
     UIStep('Alex','set_passphrase')@u & Load('Alex')@o
   & Share('Alex','Busy')@h & MisdeliveredPw('Alex')@d
   & Send('Alex','PW', m)@s & K(m)@k"

// sigma3 v2: the share control is presented UNDER THE LINK TIMER -> Busy -> misdelivery.
lemma S2_deadline_pressure_misdelivery:
  exists-trace
  "Ex m #u #o #h #d #s #k.
     UIStep('Alex','btn_share_signal')@u & TimePressure('Alex')@o
   & Share('Alex','Busy')@h & MisdeliveredPw('Alex')@d
   & Send('Alex','PW', m)@s & K(m)@k"

// sigma9: weighing the method options fatigues -> Careless in-band leak: the SILENT compromise
// (adversary reads AND Blake still reads).
lemma S2_alertvolume_inband_silent:
  exists-trace
  "Ex m #u #o #h #d #s #k #r.
     UIStep('Alex','method_toggle')@u & AlertVolume('Alex')@o
   & Share('Alex','Careless')@h & LeakPw('Alex')@d
   & Send('Alex','PW', m)@s & K(m)@k & Read('Blake', m)@r"

// EMERGENT PHISHING: Eve's password request (open mail channel; no lure rule) renders as a
// reply prompt; the Load-degraded recipient misdelivers the password AFTER a successful read.
lemma S2_recipient_phish_emergent:
  exists-trace
  "Ex m #s #r #u #o #h #d #k.
     Send('Alex','PW', m)@s & Read('Blake', m)@r
   & UIStep('Blake','reply_pw_request')@u & Load('Blake')@o
   & Share('Blake','Busy')@h & MisdeliveredPw('Blake')@d & K(m)@k"

// ...and the ATTENTIVE recipient defeats the same mail: the reply prompt can be SHOWN with no
// degradation and no leak ever following (the recipient check holds the line).
lemma S2_attentive_defeats_phish:
  all-traces
  "All m #s #k.
     Secret(m)@s & K(m)@k & not (Ex p vid #d. Mistake(p, vid)@d)
   ==> (Ex p mask #h. Share(p, mask)@h & not (mask = 'Attentive'))"
