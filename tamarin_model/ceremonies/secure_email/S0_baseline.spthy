theory SecureEmail_S0_Baseline
begin

/*
  S0 -- BASELINE (full-interface screens, NO stressor). Every co-present control on Screens A/B/C is
  answered Attentively: both pathways (PGP / password) deliver end to end, the response ORDER is
  respected (address before send, verify before send, unlock before read), and secrecy is absolute.
  Arms both pathways + the screen action classes; no stressor, so no party is even stress-enabled.
  Run: check.py --prove ceremonies/secure_email/S0_baseline.spthy
*/

#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define MASK_CONFIRM
#define PATH_PGP
#define PATH_PW

#include "base.spthy"

// (C) both pathways complete end to end through the real screens.
lemma S0_happy_pgp:
  exists-trace
  "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

lemma S0_happy_pw:
  exists-trace
  "Ex m link #s #u #r.
     Send('Alex','PW', m)@s & Unlocked('Blake', link)@u & Read('Blake', m)@r"

// (S) no stressor -> no SetMask -> no degraded row can fire -> the secret NEVER leaks.
lemma S0_secrecy_absolute:
  all-traces
  "All m #s. Secret(m)@s ==> not (Ex #k. K(m)@k)"

// only the correspondent ever reads the message.
lemma S0_read_only_blake:
  all-traces
  "All p m #r. Read(p, m)@r ==> p = 'Blake'"

end
