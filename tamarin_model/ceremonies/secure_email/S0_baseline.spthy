theory SecureEmail_S0_Baseline
begin

/*
  S0 -- BASELINE: the full five-layer pipeline with NO stressor. Every prompt is answered Attentively,
  both methods (PGP / password) deliver end to end, and secrecy is absolute. The Eve endpoint + open
  mail channel are present, but an Attentive recipient's share check defeats the emergent phish.
  Arms: (nothing) -- no stressor.  Run: check.py --prove ceremonies/secure_email/S0_baseline.spthy
*/

#include "base.spthy"

lemma S0_happy_pgp:
  exists-trace
  "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

lemma S0_happy_pw:
  exists-trace
  "Ex m link #s #u #r.
     Send('Alex','PW', m)@s & Unlocked('Blake', link)@u & Read('Blake', m)@r"

// no stressor -> no SetMask -> no degraded row can fire -> the secret NEVER leaks,
// even with Eve's password-request mail and the DY-controlled keyserver in play.
lemma S0_secrecy_absolute:
  all-traces
  "All m #s. Secret(m)@s ==> not (Ex #k. K(m)@k)"

end
