/*
  sender_screens.spthy -- the FULL-INTERFACE Alex sender (RELAYER). Real co-present controls replace the
  ambient stubs + the legacy pick/verify/send rules. Included by protocol.spthy ONLY when IF_SCREENS is
  armed. See secure_email/INTERFACE_MAP.md. A profile that arms IF_SCREENS ALSO arms MASK_TRANSCRIBE /
  MASK_COMPUTE / MASK_DECIDE (MASK_COMPARE / MASK_COMPARE_KEYCHECKED / MASK_SHARE / MASK_AUTHORIZE are
  constant in base.spthy).

  TRACTABILITY (prover budget <2min, no swap). Mirrors the legacy sender's shape so the sources stay as
  shallow as legacy:
    * ONE persistent shallow anchor !AlexScreen(P,idA,subjId,sendId) off AlexInit -- every pathway prompt
      is posed off it (never off a deep linear chain), exactly as legacy poses verify/send off the
      persistent !AlexSession. This keeps sigma2's source product a product of SHALLOW sources.
    * the send EFFECT joins ONE free-valued !StepData (the recipient from the fingerprint compare, as
      legacy) -- never a second To !StepData; the To transcribe is a real performed control (density +
      Busy slip -> !Failed feeds sigma10) whose committed value drives nothing.
    * message m leaks ONLY through routes that carry an EncTo(m,rcpt) shape (badkey) -- so the legacy
      H_encto_shape [reuse] helper prunes K(m). SUBJECT_LEAK (an Out(m) with no EncTo shape) is a separate
      opt-in gate, added with its own [reuse] helper in the step-7 spine.
*/

// ---- Screen A: compose window (Alex). ONE rule poses all co-present controls off AlexInit, once-
// bounded: To (A2) + subject (A5) transcribe, encryption selector (A6/A7) decide, Send (A15) authorize.
// Emits the persistent shallow anchor + a linear MethodChoice the decide resolves.
rule IF_screen_composer [color=#f2994a]:
    [ AlexInit(idA), Fr(~toId), Fr(~subjId), Fr(~methId), Fr(~sendId) ]
  --[ UIStep('Alex','compose'), UIStep('Alex','btn_send'), PoseComposer('Alex') ]->
    [ Prompt('Alex', ~toId,   'transcribe'), !Demand('Alex', ~toId,   'transcribe'), !Displayed('Alex', ~toId,   'Blake'),
      Prompt('Alex', ~subjId, 'transcribe'), !Demand('Alex', ~subjId, 'transcribe'), !Displayed('Alex', ~subjId, 'generic-subject'),
      Prompt('Alex', ~methId, 'decide'),     !Demand('Alex', ~methId, 'decide'),
      Prompt('Alex', ~sendId, 'authorize'),  !Demand('Alex', ~sendId, 'authorize'),
      // the compose window shows >=2 co-present controls -> the single sigma2 concurrency marker
      // (grounded here in a REAL screen; no N^2 !Demand product for the source saturation).
      !Copresent('Alex'),
      !AlexScreen('Alex', idA, ~subjId, ~sendId),
      MethodChoice(idA, ~methId) ]

restriction OncePoseComposer:
  "All p #i #j. PoseComposer(p)@i & PoseComposer(p)@j ==> #i = #j"

// method decide routing: HANDLED -> SecureFlag (the secure sends require it); MISROUTE
// (OUTCOME_CARELESS_MISROUTE) -> 'Standard (TLS only)' -> the NAMED unsafe outcome PlaintextAtProvider
// (NOT Out). Both consume the linear MethodChoice, so exactly one fires.
rule IF_method_secure [color=#1f6fd0]:
    [ MethodChoice(idA, methId), DecisionDone('Alex', methId) ]
  --[ ComposeSecure('Alex', methId) ]->
    [ SecureFlag(idA) ]

restriction SecureComposeNotMisrouted:
  "All p d #i. ComposeSecure(p, d)@i ==> not (Ex q #j. DecisionMisrouted(q, d)@j)"

#ifdef OUTCOME_CARELESS_MISROUTE
rule IF_method_tls_misroute [color=#c0392b]:
    [ MethodChoice(idA, methId), DecisionMisrouted('Alex', methId), Fr(~m) ]
  --[ Send('Alex','TLS', ~m), Secret(~m), PlaintextAtProvider(~m), MisdirectedTo('Alex','provider') ]->
    [ ]
#endif

// ---- Screen A (PGP mode): fingerprint compare (verify), posed off the SHALLOW persistent !AlexScreen
// (as legacy IF_verify_fp is posed off !AlexSession). The recipient is the compare's committed key. ----
rule IF_screen_pgp [color=#f2994a]:
    [ !AlexScreen('Alex', idA, subjId, sendId), In(offered), Fr(~vid), Fr(~sk) ]
  --[ UIStep('Alex','btn_verify_fp'), KeyGenerated('Alex'), OwnSkGen('Alex', ~sk), PosePgpScreen('Alex') ]->
    [ Prompt('Alex', ~vid, 'compare'), !Demand('Alex', ~vid, 'compare'), !Displayed('Alex', ~vid, <offered, 'Blake'>),
      AlexVerifying(idA, ~vid) ]

restriction OncePosePgpScreen:
  "All p #i #j. PosePgpScreen(p)@i & PosePgpScreen(p)@j ==> #i = #j"

// good: decide handled (SecureFlag) + verify done (KeyChecked) + accepted 'Blake' + Send granted.
rule IF_send_pgp_screen_good [color=#1f6fd0]:
    [ SecureFlag(idA), !AlexScreen('Alex', idA, subjId, sendId), AlexVerifying(idA, vid),
      Granted('Alex', sendId), !KeyChecked('Alex', vid), !StepData('Alex', vid, 'Blake'), Fr(~m) ]
  --[ Send('Alex','PGP', ~m), Secret(~m), EncTo(~m,'Blake'), SentOK('Alex') ]->
    [ Mailbox('Blake', ~m), SentMsg(idA, ~m, subjId) ]

// leak (bad key): a credulous fingerprint compare accepted a non-'Blake' key -> Out. (Mistake at compare;
// carries EncTo shape so H_encto_shape prunes K(m).)
rule IF_send_pgp_screen_badkey [color=#c0392b]:
    [ SecureFlag(idA), !AlexScreen('Alex', idA, subjId, sendId), AlexVerifying(idA, vid),
      Granted('Alex', sendId), !KeyChecked('Alex', vid), !StepData('Alex', vid, rcpt), Fr(~m) ]
  --[ Send('Alex','PGP', ~m), Secret(~m), EncTo(~m, rcpt), Neq(rcpt,'Blake'), MisdirectedTo('Alex', rcpt) ]->
    [ Out(~m), SentMsg(idA, ~m, subjId) ]

// premature (OUTCOME_PREMATURE): Send granted BEFORE verify (GrantedUnchecked, NO KeyChecked join).
#ifdef OUTCOME_PREMATURE
rule IF_send_pgp_screen_premature [color=#c0392b]:
    [ SecureFlag(idA), !AlexScreen('Alex', idA, subjId, sendId), GrantedUnchecked('Alex', sendId), Fr(~m) ]
  --[ Send('Alex','PGP', ~m), Secret(~m), SendPremature('Alex'), MisdirectedTo('Alex','unverified') ]->
    [ Out(~m), SentMsg(idA, ~m, subjId) ]
#endif

// ---- Screen A (password mode): passphrase compute (A8) + pw share, off the shallow !AlexScreen. ----
rule IF_screen_pw [color=#f2994a]:
    [ !AlexScreen('Alex', idA, subjId, sendId), Fr(~pwId), Fr(~shId), Fr(~pw) ]
  --[ PosePwScreen('Alex'), PwCreated(~pw) ]->
    [ Prompt('Alex', ~pwId, 'compute'), !Demand('Alex', ~pwId, 'compute'), !Displayed('Alex', ~pwId, ~pw), !UnderDeadline(~pwId),
      Prompt('Alex', ~shId,  'share'),   !Demand('Alex', ~shId,  'share'),   !Displayed('Alex', ~shId, <'Blake','Blake', ~pw>),
      PwPending(idA, ~shId, ~pw) ]

restriction OncePosePwScreen:
  "All p #i #j. PosePwScreen(p)@i & PosePwScreen(p)@j ==> #i = #j"

// send: decide handled + Send granted -> deliver the ENCRYPTED message to Blake's private mailbox
// (recipient fixed); the pw travels separately via the share (below), the PW pathway's leak channel.
rule IF_send_pw_screen_good [color=#1f6fd0]:
    [ SecureFlag(idA), !AlexScreen('Alex', idA, subjId, sendId), PwPending(idA, shId, pw),
      Granted('Alex', sendId), !StepData('Alex', pwId, pwc), Fr(~m) ]
  --[ Send('Alex','PW', ~m), Secret(~m), EncTo(~m,'Blake'), SentOK('Alex') ]->
    [ Mailbox('Blake', ~m), SentMsg(idA, ~m, subjId), PwEnvelope(idA, shId, pw) ]

// pw share routing (mirrors legacy PW_deliver_*; only the pw travels here). oob -> private OobPw;
// misdeliver -> Out(pw); inband-leak -> OobPw + Out(pw).
rule IF_pw_share_oob [color=#1f6fd0]:
    [ PwEnvelope(idA, shId, pw), ShareOutcome('Alex', shId, 'oob') ]
  --[ ShareRoute('Alex','oob') ]->
    [ OobPw('Blake', pw) ]

rule IF_pw_share_misdeliver [color=#c0392b]:
    [ PwEnvelope(idA, shId, pw), ShareOutcome('Alex', shId, 'misdeliver') ]
  --[ ShareRoute('Alex','misdeliver'), MisdirectedTo('Alex','wrong-contact') ]->
    [ Out(pw) ]

rule IF_pw_share_inband [color=#c0392b]:
    [ PwEnvelope(idA, shId, pw), ShareOutcome('Alex', shId, 'inband-leak') ]
  --[ ShareRoute('Alex','inband-leak') ]->
    [ OobPw('Blake', pw), Out(pw) ]

// subject leak: a Careless subject transcribe exported the subject -> the message's cleartext metadata
// leaks -> Out(m). This Out(m) has NO EncTo shape, but with the single-marker sigma2 the source graph
// stays tractable and the secrecy lemma's SubjectLeak disjunct covers it directly (no extra helper).
rule IF_subject_leak [color=#c0392b]:
    [ SentMsg(idA, m, subjId), TranscribeLeaked('Alex', subjId, leaked) ]
  --[ SubjectLeak('Alex'), MisdirectedTo('Alex','subject') ]->
    [ Out(m) ]
