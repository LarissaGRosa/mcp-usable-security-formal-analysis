/*
  sender_screens.spthy -- the FULL-INTERFACE flow (RELAYER). Holds Screen A's COMPOSE window (shared by
  both pathways) and then conditionally includes ONE OR BOTH pathways:

     #ifdef PATH_PGP  ->  screens_pgp.spthy   (Alex verify+send, Blake Screen C inbox)
     #ifdef PATH_PW   ->  screens_pw.spthy    (Alex passphrase+share, Blake Screen B password page)

  Included by protocol.spthy when IF_SCREENS is armed. See secure_email/INTERFACE_MAP.md.

  A profile arms: IF_SCREENS + MASK_TRANSCRIBE / MASK_COMPUTE / MASK_DECIDE (MASK_COMPARE /
  MASK_COMPARE_KEYCHECKED / MASK_SHARE / MASK_AUTHORIZE are constant in base.spthy), at least one PATH_*,
  and STRESS_ALEX and/or STRESS_BLAKE. A PATH_PW profile must ALSO arm MASK_CONFIRM (Screen B hangs off
  the link-confirm).

  WHY THE PATHWAYS ARE SPLIT -- the budget. With BOTH pathways compiled into every profile, each theory
  carried the whole two-pathway, two-party surface and only ONE stressor fitted in the 3-min budget (Busy
  alone ~90s; any two stressors overran). Compiled alone a pathway is roughly half the surface, so a
  profile can arm a stressor TRIO again, exactly as the legacy profiles do -- which is what lets the whole
  matrix move onto the screen standard instead of stranding the trios on the legacy rules.
  (They are separate FILES, not nested #ifdefs, because tamarin's preprocessor cannot SKIP a nested
  #ifdef: a conditionally-included file is only inserted in the TAKEN branch, so its inner #ifdefs -- the
  OUTCOME_* levers -- are always processed in an entered context.)

  TRACTABILITY invariants the screens keep (learned the hard way):
    * ONE persistent shallow anchor !AlexScreen off AlexInit -- every pathway prompt is posed off it,
      never off a deep linear chain (that is what legacy's persistent !AlexSession does).
    * the send EFFECT joins ONE free-valued !StepData (the recipient from the compare) -- never a second.
    * density detectors read SINGLE markers (!Copresent / !CopresentDecide), never "any N of M !Demand".
    * exposure-only controls emit !Demand WITHOUT a Prompt: COUNTED by density, never PERFORMED, so they
      cost nothing (lesson 15a/15b).
*/

// ---- Screen A: compose window (Alex). ONE rule poses all co-present controls off AlexInit, once-
// bounded: To (A2) + subject (A5) transcribe, encryption selector (A6/A7) decide, Send (A15) authorize.
// Emits the persistent shallow anchor + a linear MethodChoice the decide resolves.
rule IF_screen_composer [color=#f2994a]:
    [ AlexInit(idA), Fr(~toId), Fr(~subjId), Fr(~methId), Fr(~sendId) ]
  --[ UIStep('Alex','compose'), UIStep('Alex','btn_send'), PoseComposer('Alex') ]->
    [ Prompt('Alex', ~toId,   'transcribe'), !Demand('Alex', ~toId,   'transcribe'), !Displayed('Alex', ~toId,   'Blake'),
      Prompt('Alex', ~subjId, 'transcribe'), !Demand('Alex', ~subjId, 'transcribe'), !Displayed('Alex', ~subjId, 'generic-subject'),
      Prompt('Alex', ~methId, 'decide'),     !Demand('Alex', ~methId, 'decide'),
      Prompt('Alex', ~sendId, 'authorize'),  !Demand('Alex', ~sendId, 'authorize'),
      // the compose window shows >=2 co-present controls -> the single sigma2 concurrency marker.
      !Copresent('Alex'),
      !AlexScreen('Alex', idA, ~subjId, ~sendId),
      MethodChoice(idA, ~methId) ]

restriction OncePoseComposer:
  "All p #i #j. PoseComposer(p)@i & PoseComposer(p)@j ==> #i = #j"

// method decide routing: HANDLED -> SecureFlag (the secure sends require it); MISROUTE
// (OUTCOME_CARELESS_MISROUTE) -> 'Standard (TLS only)' -> the NAMED unsafe outcome PlaintextAtProvider
// (NOT Out -- it never yields K(m), which is what keeps breach <-> mistake honest; an RFC lemma forbids
// it). Both adapters consume the same linear MethodChoice, so exactly one pathway proceeds.
rule IF_method_secure [color=#1f6fd0]:
    [ MethodChoice(idA, methId), DecisionDone('Alex', methId) ]
  --[ ComposeSecure('Alex', methId) ]->
    [ SecureFlag(idA) ]

restriction SecureComposeNotMisrouted:
  "All p d #i. ComposeSecure(p, d)@i ==> not (Ex q #j. DecisionMisrouted(q, d)@j)"

#ifdef OUTCOME_CARELESS_MISROUTE
rule IF_method_tls_misroute [color=#c0392b]:
    [ MethodChoice(idA, methId), DecisionMisrouted('Alex', methId), Fr(~m) ]
  --[ Send('Alex','TLS', ~m), Secret(~m), PlaintextAtProvider(~m), MisdirectedTo('Alex','provider') ]->
    [ ]
#endif

// subject leak (both pathways): a Careless subject transcribe exported the subject -> the message's
// cleartext metadata leaks -> Out(m). Consumes the generic TranscribeLeaked token from core; SentMsg is
// produced by whichever pathway sent.
rule IF_subject_leak [color=#c0392b]:
    [ SentMsg(idA, m, subjId), TranscribeLeaked('Alex', subjId, leaked) ]
  --[ SubjectLeak('Alex'), MisdirectedTo('Alex','subject') ]->
    [ Out(m) ]

// ===================== pathway selection =====================
#ifdef PATH_PGP
#include "screens_pgp.spthy"
#endif

#ifdef PATH_PW
#include "screens_pw.spthy"
#endif
