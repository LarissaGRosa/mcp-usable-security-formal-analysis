/*
  bundles/interface_inferred.spthy -- the INTERFACE-DRIVEN stressor repertoire for profile S1.
  Pairs with protocol/compose_ui.spthy (the producer of the objective facts) + protocol/deliver.spthy
  (the outcomes). Every stressor here is INFERRED from an objective interface operation, not a flag:

    sigma6 Abstraction      <- 'compare' !Step + lexicon (agnostic, not 'verify' op) from confirm_key -> Naive
    sigma1 HighCognitiveLoad<- !Op(_,'kdf',_)      posed by the set_passphrase step-> Busy
    sigma3 TimePressure     <- 'compute' !Step + lexicon (agnostic, not SHARE_PW) from set_passphrase -> Busy
    sigma9 AlertVolume      <- three 'decide' !Steps from the choose_method decisions -> Careless

  The masks that ANSWER the resulting state are the same as S0: attentive/naive verify (PGP key
  check), attentive/careless/busy share (password handling), and attentive confirm (turns each
  method-menu !Decision into a handled !Did the density detector counts).
*/

// -- masks (the f_H that answer the trigger facts) --
// agnostic compare behaviour + !KeyChecked adapter (replaces attentive_verify / naive_verify);
// outcome_policy comes from the profile entry (S1).
#include "../../../core/masks/compare_behavior.spthy"
#include "../../../core/masks/compare_keychecked.spthy"
#include "../../../core/masks/attentive_share.spthy"
#include "../../../core/masks/careless_share.spthy"
#include "../../../core/masks/busy_share.spthy"
#include "../../../core/masks/attentive_confirm.spthy"

// -- inferred detectors (the f_U that read the objective interface operations) --
// agnostic sigma6 (was abstraction_inferred): reads the 'compare' !Step + lexicon, not the 'verify' op
#include "../../../core/stressors/abstraction.spthy"
// agnostic sigma1 (was cognitive_load_inferred): reads the 'compute' !Step + lexicon, not the 'kdf' op
#include "../../../core/stressors/cognitive_load.spthy"
#include "../../../core/stressors/alert_volume.spthy"
// Agnostic sigma3 (was time_pressure_share): reads the 'compute' !Step posed by set_passphrase + the
// lexicon, instead of the 'SHARE_PW' task name. See AGNOSTIC_STRESSOR_INTERFACE.md.
#include "../../../core/lexicon_tlx.spthy"
#include "../../../core/stressors/time_pressure.spthy"
