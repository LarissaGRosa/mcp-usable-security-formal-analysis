theory SecureEmail_S5_CuePhish
begin
/*
  S5 -- the PERSUASION axis (sigma_CUE + CUE_PHISH) on the real fingerprint compare. The adversary's only
  power here is psychological: an AUTHORITY cue on the key-verification step ("your admin vouches for this
  key") over-trusts the human into a credulous compare. The MISTAKE is still the sole leak route -- the cue
  only degrades the mask.
*/
#define IF_SCREENS
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA_CUE
#define CUE_PHISH

#include "base.spthy"

lemma S5_persuaded_onset: exists-trace "Ex p pr #i. Persuaded(p, pr)@i"

lemma S5_cue_drives_mistake:
  exists-trace "Ex p vid #o #d. Persuaded(p, 'authority')@o & Mistake(p, vid)@d"

lemma S5_naive_requires_persuasion:
  all-traces
  "All p #i. RespMask(p, 'Naive')@i ==> (Ex pr #o. Persuaded(p, pr)@o & #o < #i)"

lemma S5_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)"

lemma S5_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

lemma S5_completes: exists-trace "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"
end
