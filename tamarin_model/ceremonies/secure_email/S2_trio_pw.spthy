theory SecureEmail_S2_TrioPW
begin
/*
  S2 -- the PASSWORD pair {sigma1 Load, sigma3 Deadline} -> BUSY on the REAL Screens A/B.
  The passphrase compute is MentalDemand-hi and sits under the link timer; the password's CHANNEL is the
  whole game. A BUSY share MISDELIVERS the passphrase to the wrong contact -> Out(pw). The companion
  Careless in-band leak lives in S10_pw_inband_leak: arming Busy AND Careless together overruns the
  budget, so the two share outcomes are split by mask (as the transcribe story is across S8/S9).
*/
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define MASK_CONFIRM
#define PATH_PW

#define STRESS_ALEX
#define SIGMA1_LOAD
#define SIGMA3_DEADLINE

#include "base.spthy"

lemma S2_load_onset:     exists-trace "Ex #i. Load('Alex')@i"
lemma S2_deadline_onset: exists-trace "Ex #i. TimePressure('Alex')@i"
lemma S2_misdelivered_pw: exists-trace "Ex p #i. MisdeliveredPw(p)@i"

// A9/B2 -- WITHOUT the show-password reveal the typed passphrase is dots on the screen and therefore
// UNCHECKABLE: a Busy slip on the passphrase compute is committed BLIND and travels to the send. The
// message goes out protected by a passphrase Alex never intended. (Vulnerable half of the IF_REVEAL pair;
// S13_pw_reveal proves it unreachable once the reveal exists.)
lemma S2_slipped_pw_sent: exists-trace "Ex #i. SlippedPwSent('Alex')@i"

lemma S2_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)
     | (Ex p #d. MisaddressedSend(p)@d)"

lemma S2_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

// ---- (C) T5, the STRONG (ordered) form: the ceremony completes DESPITE the onset. ----
// The weak form ("Ex Send & Read") is satisfied by a trace in which the stressor NEVER FIRED, so in a
// STRESSED profile it says almost nothing. These pin the onset strictly BEFORE the stressed party's own
// completion step, so the witness is a trace where the human was ALREADY degraded and still finished.

lemma S2_trio_pw_completes_under_sigma1:
  exists-trace
  "Ex m link #o #s #u #r.
     Load('Alex')@o & Send('Alex','PW', m)@s & Unlocked('Blake', link)@u & Read('Blake', m)@r
   & #o < #s"

lemma S2_trio_pw_completes_under_sigma3:
  exists-trace
  "Ex m link #o #s #u #r.
     TimePressure('Alex')@o & Send('Alex','PW', m)@s & Unlocked('Blake', link)@u & Read('Blake', m)@r
   & #o < #s"

end
