theory SecureEmail_S1_TrioPGP
begin
/*
  S1 -- the PGP trio {sigma6 Abstraction, sigma2 Concurrency} + the skip-check row, on the REAL Screens
  A/C. The fingerprint compare is the canonical weak point: an effortful comparison (sigma6) plus
  competing co-present controls (sigma2) degrade the mask, the check is skipped, and the message goes to
  a non-correspondent. The ORDER lever is armed too: a degraded Send can fire BEFORE the verify at all
  (SendPremature) -- something the old model could not even express.
*/
#define IF_SCREENS
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA6_ABSTRACTION
#define SIGMA2_CONCURRENCY
#define OUTCOME_CARELESS_SKIPCHECK
#define OUTCOME_PREMATURE

#include "base.spthy"

lemma S1_abstraction_onset: exists-trace "Ex #i. Abstraction('Alex')@i"
lemma S1_distract_onset:    exists-trace "Ex #i. Distract('Alex')@i"

lemma S1_skipcheck_misdirects:
  exists-trace "Ex p vid r #d #m. Mistake(p, vid)@d & MisdirectedTo('Alex', r)@m"

lemma S1_premature_send:
  exists-trace "Ex #i. SendPremature('Alex')@i"

lemma S1_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)"

lemma S1_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

lemma S1_completes: exists-trace "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"
end
