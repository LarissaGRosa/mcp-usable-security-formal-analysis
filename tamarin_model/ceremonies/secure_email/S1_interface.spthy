theory SecureEmail_S1
begin

/*
  PROFILE S1 -- secure_email ceremony (C1), the SENDING INTERFACE generates the stressors.
  Same two pathways and outcomes as S0, but the stressors are no longer declared: each composer
  step (protocol/compose_ui.spthy) records the OBJECTIVE operation it performs, and the core
  inferred detectors read its tag and infer the stressor (analyzer direction, repo MEMORY.md #12).
    choose_method  -> sigma9 AlertVolume (Careless)   set_passphrase -> sigma1 Load / sigma3 TimePressure (Busy)
    confirm_key    -> sigma6 Abstraction (Naive)      send           -> the SHARE_PW deadline (sigma3)
  Both parties stressable. Run: check.py --prove ceremonies/secure_email/S1_interface.spthy
*/

// -- crypto + framework declarations (builtins/functions first) --
#include "protocol/crypto.spthy"
#include "../../core/types.spthy"

// -- protocol spine: parties + the interface-step producers + shared outcomes --
#include "protocol/init.spthy"
#include "protocol/compose_ui.spthy"
#include "protocol/deliver.spthy"

// -- human-layer plumbing + stress BOTH parties --
#include "bundles/human_common.spthy"
#include "protocol/stress_blake.spthy"

// -- outcome policy (the mask behaviour matrix): the agnostic compare masks read it --
#include "../../core/masks/outcome_policy.spthy"

// -- interface-driven (inferred) stressors + the masks that answer them --
#include "bundles/interface_inferred.spthy"

#include "experiments/S1_interface.spthy"

end
