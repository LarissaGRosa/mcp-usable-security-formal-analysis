theory SecureEmail_S11_Hardened
begin
/*
  S11 -- the HARDENED interface: the same screens, the same stressors, but with the design levers in
  place. It is the "removed_by" half of the RFC lever PAIRS (template T4): each bad outcome that is
  REACHABLE in a baseline profile is UNREACHABLE here, and the proof of unreachability is what turns a
  design lever into a normative requirement.

  Levers armed:
    * SEND DISABLED UNTIL VERIFY  -- the Send control cannot be granted before the fingerprint compare
      completes, so the out-of-order route does not exist (OUTCOME_PREMATURE not armed)
      => SendPremature UNREACHABLE.
    * NO PLAINTEXT FALLBACK / FORWARD GUARD -- the encryption selector has no "Standard (TLS only)" exit,
      and Forward re-encrypts or blocks (OUTCOME_CARELESS_MISROUTE not armed)
      => PlaintextAtProvider and ForwardedOutside UNREACHABLE.
    * HARDENED VERIFY (IF_HARDENED) -- the fingerprint view is a visual diff, so the compare is Effort-'lo'
      and sigma6 cannot fire => the credulous compare (Mistake) is UNREACHABLE.

  The stressors are STILL armed (sigma6 + sigma2): the point is that the human is under exactly the same
  pressure and the interface no longer lets the pressure become a breach.
*/
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define PATH_PGP

#define STRESS_ALEX
#define SIGMA6_ABSTRACTION
#define SIGMA2_CONCURRENCY
#define IF_HARDENED

#include "base.spthy"

// the stressor still fires -- the human is under the same pressure.
lemma S11_distract_onset: exists-trace "Ex #i. Distract('Alex')@i"

// ---- the four unreachability results (the "removed_by" half of the RFC pairs) ----
lemma S11_no_premature_send:
  all-traces "not (Ex p #i. SendPremature(p)@i)"

lemma S11_no_plaintext_fallback:
  all-traces "not (Ex m #i. PlaintextAtProvider(m)@i)"

lemma S11_no_forward_outside:
  all-traces "not (Ex p #i. ForwardedOutside(p)@i)"

// hardened verify: the effortful compare cannot degrade, so no credulous acceptance.
lemma S11_no_abstraction:
  all-traces "not (Ex p #i. Abstraction(p)@i)"

// ---- and the ceremony still completes + stays secret ----
lemma S11_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)
     | (Ex p #d. MisaddressedSend(p)@d)"

// ---- (C) T5, the STRONG (ordered) form: the ceremony completes DESPITE the onset. ----
// The weak form ("Ex Send & Read") is satisfied by a trace in which the stressor NEVER FIRED, so in a
// STRESSED profile it says almost nothing. These pin the onset strictly BEFORE the stressed party's own
// completion step, so the witness is a trace where the human was ALREADY degraded and still finished.

// NOTE: there is deliberately NO S11_..._completes_under_sigma6. IF_HARDENED seeds the FULL lexicon, so
// the abstraction onset CANNOT fire -- S11_no_abstraction proves exactly that. A "completes under sigma6"
// witness would contradict it. The hardening lever REMOVES the stressor rather than surviving it, which is
// a STRONGER outcome than completing under it, and the sigma2 witness below shows the profile is not
// merely stressor-free.
lemma S11_hardened_completes_under_sigma2:
  exists-trace
  "Ex m #o #s #r.
     Distract('Alex')@o & Send('Alex','PGP', m)@s & Read('Blake', m)@r
   & #o < #s"

end
