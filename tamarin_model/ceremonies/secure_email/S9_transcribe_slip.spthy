theory SecureEmail_S9_TranscribeSlip
begin

/*
  S9 -- the TRANSCRIBE-SLIP companion to S8. Under load, a BUSY field entry SLIPS: the human commits a
  fresh WRONG value into a real text field (To / subject / passphrase). The slip raises !Failed, which is
  what sigma10 RepeatedFailure would feed on -- and it is a SAFE-FAIL: a mistyped field does not export
  the secret, it just breaks the step. That asymmetry (Busy -> slip -> safe-fail vs Careless -> leak ->
  breach) is the point of separating the two field-entry outcomes.

  Arms sigma1 (Busy) + STRESS_ALEX. SPLIT from S8 (Careless) because arming both masks on the full
  screens overruns the prover budget -- the plan's own fallback ("split rather than raise the timeout").
  NOTE: Busy is the expensive mask (its slips mint fresh terms); this profile sits near the budget.
  Run: check.py --prove ceremonies/secure_email/S9_transcribe_slip.spthy
*/

#define IF_SCREENS
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE

#define STRESS_ALEX
#define SIGMA1_LOAD

#include "base.spthy"

// ---- onset coverage (lesson 16) ----
lemma S9_load_onset:
  exists-trace "Ex #i. Load('Alex')@i"

// ---- the chain: a Busy field entry SLIPS -> a fresh wrong value is committed -> !Failed ----
lemma S9_slip_reachable:
  exists-trace "Ex #i. Slip('Alex')@i"

// ---- SAFE-FAIL: the slip does NOT export the secret. Every K(m) still traces to the SAME enumerated
// boundary list -- and a Slip is not on it. This is what makes the slip a usability failure, not a
// security one. ----
lemma S9_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)"

lemma S9_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

// ---- (C) T5 (fallback form): the ceremony still completes with the stressor armed ----
lemma S9_completes:
  exists-trace "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"

end
