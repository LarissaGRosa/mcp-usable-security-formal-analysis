/*
  protocol/deliver.spthy -- PROTOCOL LAYER, the crypto OUTCOMES shared by profiles S0 and S1.
  Factored out of pgp_pathway / pw_pathway so the interface-driven profile S1 (compose_ui poses the
  trigger facts) reuses the same send/decrypt rules as the declared-stressor profile S0. The masks
  decide HOW the trigger facts get answered; these rules turn the answered state into ciphertext on
  the wire and a recipient read.

    A_send_pgp   : encrypt the secret to whatever key survived verification (!KeyChecked).
    B_read_pgp   : only Blake's private key skB opens a ciphertext encrypted to pk(skB).
    B_read_pw    : the recipient needs the ciphertext (network) AND the password (Oob, to idB).
    B_phish_prompt : after reading, an adversary lure poses a SHARE_PW decision FOR BLAKE, so the
                     share masks degrade the recipient too (both-parties-masked).
*/

rule A_send_pgp:
    [ AlexVerifying(idA, vid, pkUsed), !KeyChecked('Alex', vid), Fr(~m) ]
  --[ Send('Alex','PGP', ~m), Secret(~m), EncTo(~m, pkUsed) ]->
    [ Out(aenc(~m, pkUsed)), Posted('Alex','PGP', ~m) ]

rule B_read_pgp:
    [ BlakeKeyed(idB, skB), In(aenc(m, pk(skB))) ]
  --[ Read('Blake', m), ReadVia('Blake','PGP') ]->
    [ ]

rule B_read_pw:
    [ BlakeKeyless(idB), In(senc(m, pw)), Oob(sender, idB, pw) ]
  --[ Read('Blake', m), ReadVia('Blake','PW') ]->
    [ BlakeHasSecret(idB, m, pw) ]

rule B_phish_prompt:
    [ BlakeHasSecret(idB, m, pw), In(lure), Fr(~rid2) ]
  --[ Phished('Blake'), UIStep('Blake','phish_confirm'), Request('Blake', ~rid2, 'SHARE_PW') ]->
    [ !Req('Blake', ~rid2, 'SHARE_PW', <'attacker', pw>, 'Easy'),
      // Layer-1 objective step (agnostic interface): confirming the password on the phishing page is
      // a 'confirm' action. sigma2 ExternalDistraction (action-generic) reads it -> Blake Careless ->
      // careless_share -> recipient-side LeakPw (S0_recipient_leak_reachable). No detector keys on
      // 'confirm' in this ceremony, so only sigma2 (any !Step) fires here.
      !Step('Blake', ~rid2, 'confirm') ]
