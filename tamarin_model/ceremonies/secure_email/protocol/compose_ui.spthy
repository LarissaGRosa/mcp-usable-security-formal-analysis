/*
  protocol/compose_ui.spthy -- the SENDER'S COMPOSER INTERFACE, step by step (profile S1).

  This is the analyzer direction (repo MEMORY.md lesson 12): instead of a designer flag, the
  ceremony records the OBJECTIVE operation each interface step performs, and the core/ inferred
  detectors read its tag and infer the stressor. Each composer box from the guide
  (secure-email-generic-guide.html, the "in webmail" steps) is one rule here that deposits BOTH
  the S0 trigger fact (so the real verify/share masks answer it and drive the real aenc/senc
  outcome in protocol/deliver.spthy) AND the objective fact the detector keys on:

    choose_method   -> !Decision x3 (weighing TLS / PGP / password)  -> sigma9 AlertVolume (Careless)
    confirm_key     -> !Op(_,'verify',_) + !VerifyReq (PGP key check) -> sigma6 Abstraction (Naive)
    set_passphrase  -> !Op(_,'kdf',_)   + !Req SHARE_PW (derive sym key)-> sigma1 HighCognitiveLoad (Busy)
    send            -> (the SHARE_PW !Req carries the deadline)        -> sigma3 TimePressure (Busy)

  Every step emits UIStep('Alex', <name>), so the analyzer lemma can prove each mask degradation is
  GENERATED BY a named interface step. AlexInit is linear -> one pathway per trace (bounded); the
  method menu is seeded once off !Party with three tokens (bounded counting for sigma9).
*/

// ===== choose_method : the encryption-method menu (three options to weigh) =====
rule UI_seed_method_menu:
    [ !Party('Alex', idA) ]
  --[ UIStep('Alex','choose_method'), SeedMenu('Alex') ]->
    [ MenuTok('Alex'), MenuTok('Alex'), MenuTok('Alex') ]

restriction OnceSeedMenu:
  "All p #i #j. SeedMenu(p)@i & SeedMenu(p)@j ==> #i = #j"

rule UI_method_option:
    [ MenuTok('Alex'), Fr(~did) ]
  --[ PoseDecision('Alex', ~did) ]->
    [ !Decision('Alex', ~did),
      // Layer-1 objective step (agnostic interface): weighing a method is a 'decide' action -- the
      // migrated sigma9 counts these (>=3 distinct -> Careless), not the handled !Did markers.
      !Step('Alex', ~did, 'decide') ]

// ===== confirm_key : PGP "enable encryption + confirm the recipient's key" (abstract crypto) =====
rule UI_confirm_key_genuine:
    [ AlexInit(idA), !RecipientKey('Blake', pkB), Fr(~vid) ]
  --[ Branch('Alex','PGP'), UIStep('Alex','confirm_key'), KeyOffered('Alex', ~vid, 'genuine') ]->
    [ AlexVerifying(idA, ~vid, pkB),
      !VerifyReq('Alex', ~vid, 'genuine'),
      !Op('Alex', ~vid, 'verify', ~vid),
      // Layer-1 objective step (agnostic interface): confirming the key is a 'compare' action the
      // lexicon marks high-Effort -> the migrated sigma6 reads it, not the 'verify' op.
      !Step('Alex', ~vid, 'compare') ]

rule UI_confirm_key_tampered:
    [ AlexInit(idA), !RecipientKey('Blake', pkB), In(badkey) ]
  --[ Branch('Alex','PGP'), UIStep('Alex','confirm_key'), KeyOffered('Alex', badkey, 'tampered'),
      Tampered(badkey) ]->
    [ AlexVerifying(idA, badkey, badkey),
      !VerifyReq('Alex', badkey, 'tampered'),
      !Op('Alex', badkey, 'verify', badkey),
      !Step('Alex', badkey, 'compare') ]

// ===== set_passphrase : password "set a passphrase + hint" (derive a symmetric key) =====
rule UI_set_passphrase:
    [ AlexInit(idA), !Keyless('Blake'), !Party('Blake', idB), Fr(~m), Fr(~pw), Fr(~rid) ]
  --[ Branch('Alex','PW'), UIStep('Alex','set_passphrase'), Send('Alex','PW', ~m), Secret(~m),
      Request('Alex', ~rid, 'SHARE_PW') ]->
    [ Out(senc(~m, ~pw)), Posted('Alex','PW', ~m),
      !Req('Alex', ~rid, 'SHARE_PW', <idB, ~pw>, 'Easy'),
      !Op('Alex', ~rid, 'kdf', ~rid),
      // Layer-1 objective step (agnostic interface): set_passphrase derives a symmetric key under a
      // deadline -- a 'compute' action that the migrated sigma3 reads via the lexicon (not 'SHARE_PW').
      !Step('Alex', ~rid, 'compute') ]

// ===== send : the final click (the SHARE_PW !Req carries the deadline that sigma3 reads) =====
rule UI_send:
    [ Posted('Alex', method, m) ]
  --[ UIStep('Alex','send'), Dispatched('Alex', method, m) ]->
    [ ]
