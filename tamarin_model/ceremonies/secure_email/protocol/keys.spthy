/*
  protocol/keys.spthy -- PROTOCOL LAYER (blue #1f6fd0): participants + the PK SUB-CEREMONY.

  LAYERING CONTRACT: protocol rules exchange only PReq_* requests / result facts with the
  interface, and In/Out/Oob with the channels. No rule here reads or writes a human-layer fact.

  Participants: Alex (sender), Blake (recipient), and EVE -- a first-class participant who is
  MALICIOUS: !Corrupt('Eve') marks that her endpoints belong to the adversary (her OOB inbox is
  DY-readable, protocol/mail.spthy). Nothing else distinguishes her: any phishing arises from the
  open channels, not from a dedicated lure rule.

  The PK sub-ceremony (modeled, not magic): Blake's key EXISTS only if the ceremony ran --
  keygen request -> P_keygen; publish request -> P_publish sends the public key over the PUBLIC
  channel (Out -- the keyserver/WKD is Dolev-Yao territory) and reads the FINGERPRINT out over
  the OOB channel (OobFp -- the Signal thread, private). What Alex later FETCHES is whatever the
  network answers (P_fetch reads In): the DY can forward Blake's genuine key or substitute its
  own -- tampering is the adversary's choice, never a producer branch.
*/

rule P_init_alex [color=#1f6fd0]:
    [ Fr(~idA) ] --[ Start('Alex') ]-> [ AlexInit(~idA), !Party('Alex', ~idA) ]

rule P_init_blake [color=#1f6fd0]:
    [ Fr(~idB) ] --[ Start('Blake') ]-> [ BlakeInit(~idB), !Party('Blake', ~idB) ]

// Eve: a participant like any other, except corrupt (adversary-controlled endpoints).
rule P_init_eve [color=#1f6fd0]:
    [ Fr(~idE) ] --[ Start('Eve'), CorruptParty('Eve') ]-> [ !Party('Eve', ~idE), !Corrupt('Eve') ]

// ---- keygen service ("Generate my keypair", either pane) ----

rule P_keygen [color=#1f6fd0]:
    [ PReq_keygen(P, id), Fr(~sk) ]
  --[ KeyGenerated(P), OwnSkGen(P, ~sk) ]->
    [ !OwnPk(P, pk(~sk)), !OwnSk(P, ~sk), KeyReady(P, id) ]

// ---- publish: public key to the WORLD (public channel), fingerprint to the OOB thread ----

rule P_publish [color=#1f6fd0]:
    [ PReq_publish(idB), !OwnPk('Blake', pkB) ]
  --[ Published('Blake') ]->
    [ Out(pkB),
      OobFp('Blake', 'Alex', pkB),
      BlakeReadyPGP(idB) ]

// ---- fetch: the keyserver answer IS the network's answer (single rule; DY decides) ----

rule P_fetch [color=#1f6fd0]:
    [ PReq_fetch(idA), In(k) ]
  --[ KeyArrived('Alex') ]->
    [ FetchedKey(idA, k) ]
