/*
  protocol/mail.spthy -- PROTOCOL LAYER (blue #1f6fd0): mail transport, storage, OOB delivery.

  Channels:
    * Out/In        -- email + keyserver: public, unauthenticated, Dolev-Yao. ANYONE (the DY,
                       hence also the malicious participant Eve) can inject mail claiming any
                       reply-to: P_mail_pwreq accepts <'pwreq', to, replyTo> from the network.
                       This is how phishing ARISES: no lure rule, just an open channel.
    * Oob(from,to,x)-- the Signal side channel, addressed by PARTY NAME, private to the DY --
                       EXCEPT delivery to a corrupt participant (P_oob_corrupt): Eve reads her
                       own Signal, and Eve is the adversary's.
*/

// ---- PGP: encrypt to whatever key survived the human's verification; recipient decrypts ----

rule P_send_pgp [color=#1f6fd0]:
    [ PReq_send_pgp(idA, kUsed), Fr(~m) ]
  --[ Send('Alex','PGP', ~m), Secret(~m), EncTo(~m, kUsed) ]->
    [ Out(aenc(~m, kUsed)) ]

rule P_decrypt_pgp [color=#1f6fd0]:
    [ PReq_decrypt(idB), !OwnSk('Blake', skB), In(aenc(m, pk(skB))) ]
  --[ Read('Blake', m), ReadVia('Blake','PGP') ]->
    [ ]

// ---- password method: store ciphertext server-side, email the bearer Unlock link ----

rule P_send_pw [color=#1f6fd0]:
    [ PReq_send_pw(idA, pw), !Party('Blake', idB), Fr(~m), Fr(~link) ]
  --[ Send('Alex','PW', ~m), Secret(~m) ]->
    [ !Stored(~link, senc(~m, pw)), Out(<'notif', idB, ~link>) ]

rule P_fetch_stored [color=#1f6fd0]:
    [ In(link), !Stored(link, ct) ]
  --[ Fetched(link) ]->
    [ Out(ct) ]

// unlock needs the emailed link AND the password delivered over the OOB channel.
rule P_unlock_pw [color=#1f6fd0]:
    [ PReq_unlock(idB), In(<'notif', idB, link>), !Stored(link, senc(m, pw)), Oob(s, 'Blake', pw) ]
  --[ Read('Blake', m), ReadVia('Blake','PW'), Unlocked('Blake', link) ]->
    [ BlakeHasPw(idB, pw) ]

// ---- the open mail channel: anyone can send Blake a password request claiming any reply-to ----

rule P_mail_pwreq [color=#1f6fd0]:
    [ In(<'pwreq', idB, replyTo>), !Party('Blake', idB) ]
  --[ MailDelivered('Blake') ]->
    [ MailPwReq(idB, replyTo) ]

restriction OneMailPwReq:
  "All p #i #j. MailDelivered(p)@i & MailDelivered(p)@j ==> #i = #j"

// ---- OOB delivery to a CORRUPT participant is delivery to the adversary ----

rule P_oob_corrupt [color=#1f6fd0]:
    [ Oob(p, e, x), !Corrupt(e) ]
  --[ OobToCorrupt(e) ]->
    [ Out(x) ]
