/*
  protocol/share_effects.spthy -- thin EFFECT ADAPTERS for the agnostic share behaviour (AGNOSTIC_MASKS.md).
  The core behaviour (core/masks/share_behavior.spthy) decided the outcome and emitted the action facts;
  here each outcome manifests as secure_email's wire/side-channel facts, reading the payload <recip,pw>
  from !StepData. Oob is the private side channel (adversary cannot read); Out is the network.
    oob          -> Oob(P,recip,pw)              (passphrase off the wire)
    inband-leak  -> Out(pw) + Oob(P,recip,pw)    (recipient still gets it; adversary decrypts -- silent)
    misdeliver   -> Out(pw)                       (wrong recipient; intended one locked out)
*/

rule Share_oob_effect:
    [ ShareOutcome(P, rid, 'oob'), !StepData(P, rid, <recip, pw>) ]
  -->
    [ Oob(P, recip, pw) ]

rule Share_inband_leak_effect:
    [ ShareOutcome(P, rid, 'inband-leak'), !StepData(P, rid, <recip, pw>) ]
  -->
    [ Out(pw), Oob(P, recip, pw) ]

rule Share_misdeliver_effect:
    [ ShareOutcome(P, rid, 'misdeliver'), !StepData(P, rid, <recip, pw>) ]
  -->
    [ Out(pw) ]
