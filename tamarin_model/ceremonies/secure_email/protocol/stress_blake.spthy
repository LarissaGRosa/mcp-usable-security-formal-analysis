/*
  protocol/stress_blake.spthy -- make the RECIPIENT (Blake) a stress target (Stage B targeting).
  Counterpart of stress_alex.spthy: produces !StressEnable('Blake') off !Party('Blake',_).
  Include it to put the recipient under stress (e.g. the phishing-page password-confirm step);
  omit it and no stressor can fire for Blake.
*/

rule Enable_Stress_Blake:
    [ !Party('Blake', id) ] --[ StressOn('Blake') ]-> [ !StressEnable('Blake') ]

restriction OnceStressBlake:
  "All #i #j. StressOn('Blake')@i & StressOn('Blake')@j ==> #i = #j"
