theory SecureEmail_S6_RecoveryHabituation
begin
/*
  S6 -- the HABITUATION recovery pair on Blake's Screen C. The two co-present badges habituate Blake into
  clicking through; a MODE-BREAK re-engagement recovers him to Attentive. The matched pair: the recovery
  is REACHABLE, and it REQUIRES the mode-break (no free recovery).
*/
#define MASK_TRANSCRIBE
#define MASK_COMPUTE
#define MASK_DECIDE
#define MASK_CONFIRM
#define PATH_PGP

#define STRESS_BLAKE
#define SIGMA8_HABITUATION
#define OUTCOME_HABITUATED_CLICKTHROUGH
#define MASK_RECOVERY
#define RECOVERY_WARNING
#define RECOVERY_MODEBREAK

#include "base.spthy"

lemma S6_habituate_onset: exists-trace "Ex #i. Habituate('Blake')@i"

lemma S6_recovers_to_attentive:
  exists-trace "Ex #h #r. Habituate('Blake')@h & SetMask('Blake','Attentive')@r & #h < #r"

lemma S6_only_correspondents_know:
  all-traces
  "All m #s #k. Secret(m)@s & K(m)@k
   ==> (Ex p vid #d. Mistake(p, vid)@d) | (Ex p #d. LeakPw(p)@d) | (Ex p #d. MisdeliveredPw(p)@d)
     | (Ex p #d. SubjectLeak(p)@d) | (Ex p #d. SendPremature(p)@d) | (Ex p #d. ForwardedOutside(p)@d)
     | (Ex p #d. MisaddressedSend(p)@d)"

lemma S6_read_only_blake:
  all-traces "All p m #r. Read(p, m)@r ==> p = 'Blake'"

lemma S6_completes: exists-trace "Ex m #s #r. Send('Alex','PGP', m)@s & Read('Blake', m)@r"
end
