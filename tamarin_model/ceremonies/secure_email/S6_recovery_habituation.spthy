theory SecureEmail_S6_RecoveryHabituation
begin

/*
  S6 -- MATCHED recovery, habituation case. Recovery must fit the degrade's driver. Habituation (sigma8,
  automaticity from repeated confirms) is recovered by a forcing-function MODE-BREAK (a challenge that
  cannot be reflex-clicked, resetting automaticity) but NOT by a re-engagement warning -- warnings
  habituate too (Anderson & Vance 2015). Both interventions are AVAILABLE here; the theorems show
  Habituated recovers ONLY via the mode-break.
  Run: check.py --prove ceremonies/secure_email/S6_recovery_habituation.spthy
*/

#define SIGMA8_HABITUATION
#define OUTCOME_HABITUATED_CLICKTHROUGH
#define MASK_RECOVERY
#define RECOVERY_WARNING
#define RECOVERY_MODEBREAK

#include "base.spthy"

// the mode-break restores Attentive after habituation -> the human then verifies attentively (reachable).
lemma S6_modebreak_recovers_habituated:
  exists-trace
  "Ex vid #h #r #v.
     Habituate('Alex')@h & RecoverVia('Alex','modebreak')@r
   & Verify('Alex', vid, 'Attentive')@v & #h < #r & #r < #v"

// MATCHING (all-traces): an Attentive verify after habituation REQUIRES a mode-break between -- an
// available warning is NOT enough to recover Habituated.
lemma S6_habituated_needs_modebreak_not_warning:
  all-traces
  "All vid #v #h.
     Verify('Alex', vid, 'Attentive')@v & Habituate('Alex')@h & #h < #v
   ==> (Ex #r. RecoverVia('Alex','modebreak')@r & #h < #r & #r < #v)"

end
