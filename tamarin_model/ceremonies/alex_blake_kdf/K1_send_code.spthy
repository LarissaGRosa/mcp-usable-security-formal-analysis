theory KDF_K1_SendCode
begin
/*
  K1 -- the SEND-CODE screen under load (sigma1 -> Busy). Two distinct field/channel mistakes:
    * a TYPO in the nonce entry (transcribe slip) ships a wrong code -> the partner derives a different
      key -> the key-confirmation SHUTDOWN catches it (safe-fail, no breach);
    * a WRONG CHAT (share misdeliver) exports the nonce -> Out(nonce).
  Leaking ONE nonce is still not enough for sk (H_sk_requires_both_leaks) -- the compositional payoff.
*/
#define KDF_INIT
#define KDF_MESSENGER
#define COMPUTE_KEYRESULT
#define MASK_COMPUTE
#define MASK_TRANSCRIBE
#define MASK_SHARE
#define MASK_COMPARE
#define MASK_AUTHORIZE
#define LEXICON_DEFAULT
#define STRESS_ALEX
#define SIGMA1_LOAD
#include "../../core/framework.spthy"
#include "protocol.spthy"
#include "../../core/demands.spthy"
#include "../../core/masks.spthy"
#include "../../core/stressors.spthy"
#include "../../core/knobs.spthy"
#include "../../core/properties.spthy"
#include "k_lemmas.spthy"

lemma K1_load_onset:
  exists-trace "Ex #i. Load('Alex')@i"

lemma K1_typo_slip_reachable:
  exists-trace "Ex #i. Slip('Alex')@i"

lemma K1_misdeliver_reachable:
  exists-trace "Ex #i. MisdeliveredNonce('Alex')@i"

lemma K1_only_correspondents_know_sk:
  all-traces
  "All na nb #s #k. Secret(kdf(na,nb))@s & K(kdf(na,nb))@k
   ==> ( (Ex #a. MisdeliveredNonce('Alex')@a) | (Ex #a. NonceLeaked('Alex')@a) )
     & ( (Ex #b. MisdeliveredNonce('Blake')@b) | (Ex #b. NonceLeaked('Blake')@b) )"

// ---- (C) T5, the STRONG (ordered) form: the ceremony completes DESPITE the onset. ----
// The weak form ("Ex Send & Read") is satisfied by a trace in which the stressor NEVER FIRED, so in a
// STRESSED profile it says almost nothing. These pin the onset strictly BEFORE the stressed party's own
// completion step, so the witness is a trace where the human was ALREADY degraded and still finished.

lemma K1_send_code_completes_under_sigma1:
  exists-trace
  "Ex #o #a #b.
     Load('Alex')@o & SessionUp('Alex')@a & SessionUp('Blake')@b
   & #o < #a"

end
