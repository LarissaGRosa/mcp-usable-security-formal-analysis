// -- 1f6fd0 BLUE: protocol layer (init + nonce wire; plain finish + session) --
#include "protocol/kdf.spthy"
#include "protocol/finish.spthy"

// -- f2994a ORANGE: interface layer (the compute prompts) + the compute effect adapter --
#include "interface/sender.spthy"
#include "interface/recipient.spthy"
#include "protocol/compute_keyresult.spthy"

// -- human plumbing: mask gates, one-answer, outcome matrix, lexicon, targeting (both parties) --
#include "bundles/human_common.spthy"

// -- 27ae60 GREEN: the compute behaviour that drives the outcome (Attentive -> correct) --
#include "../../core/masks/compute_behavior.spthy"

// -- eb5757 RED: no stressors in the baseline --

#include "experiments/P0_baseline.spthy"

end
