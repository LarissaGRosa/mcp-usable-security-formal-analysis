theory ToyCeremony_P0_Baseline
begin

/*
  P0 -- BASELINE: the layered pipeline, no stressor. Both parties derive SK = kdf(N_A,N_B)
  Attentively; the ceremony finishes and the keys agree.
  Arms: FINISH_PLAIN, LEXICON_DEFAULT, IF_CALC_BLAKE (Blake computes too).
  Run: check.py --prove ceremonies/alex_blake_kdf/P0_baseline.spthy
*/

#define FINISH_PLAIN
#define LEXICON_DEFAULT
#define IF_CALC_BLAKE

#include "base.spthy"

// sanity: the ceremony can finish.
lemma P0_completes:
  exists-trace
  "Ex #i. Finish('Alex') @ i"

// honest run => same SK (shared variable k forces equality on both Key facts).
lemma P0_agreement:
  exists-trace
  "Ex k #i #j. Key('Alex',k)@i & Key('Blake',k)@j"

end
