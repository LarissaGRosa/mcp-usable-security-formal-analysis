theory ToyCeremony_InferredAlertVolume
begin

/*
  ENTRY POINT -- Experiment 15 · sigma9 AlertVolume INFERRED (trace-inference by decision DENSITY).
  Closes the fully-inferable tier. A token-bounded stream of UI confirmations: while the user is
  fresh they handle decisions Attentively; once >=3 distinct decisions have been handled the sigma9
  detector infers decision fatigue and degrades the user to Careless, who then times out on a later
  decision. No declared stressor -- the density is read straight from the trace.
  Run: check.py --prove ceremonies/alex_blake_kdf/15_inferred_alert_volume.spthy
*/

#include "../../core/types.spthy"

// -- human layer: inferred sigma9 (decision density) + Attentive/Careless decision f_H --
#include "../../core/stressors/alert_volume_inferred.spthy"
#include "../../core/masks/attentive_confirm.spthy"
#include "../../core/masks/careless_confirm.spthy"
#include "../../core/transitions/mask_state.spthy"
#include "../../core/transitions/answered_once.spthy"

// -- protocol: init + token-bounded decision stream --
#include "protocol/init.spthy"
#include "protocol/decision_stream.spthy"

// -- experiment --
#include "experiments/15_inferred_alert_volume.spthy"

end
