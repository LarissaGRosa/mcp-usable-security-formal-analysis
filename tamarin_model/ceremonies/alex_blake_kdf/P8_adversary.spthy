theory ToyCeremony_P8_Adversary
begin

/*
  P8 -- adversary-INDUCED stressor. An Attentive KDF brings up the session; an APPROVE prompt is
  posed with NO environmental stressor. The only route to Busy is the adversary injecting urgency
  (adversary.spthy -> time_pressure_induced) -> the rushed user auto-approves the injected prompt.
  Attribution lemmas trace the auto-approval to the adversary.
  Run: check.py --prove ceremonies/alex_blake_kdf/P8_adversary.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline (Attentive)
#include "protocol/finish.spthy"
#include "bundles/human_common.spthy"

#include "phases/approve.spthy"           // APPROVE prompt + confirm behaviour (no environmental stressor)
#include "../../core/adversary.spthy"                     // urgency-injection capability
#include "../../core/stressors/time_pressure_induced.spthy"  // the ONLY route to Busy here

#include "experiments/P8_adversary.spthy"

end
