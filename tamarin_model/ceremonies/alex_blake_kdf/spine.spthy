/*
  spine.spthy -- the universal "Alex derives the key" pipeline (V3). One include for the boilerplate
  every KDF profile shares: crypto/framework + the nonce protocol + Alex's compute prompt + the
  compute adapter + the compute behaviour. A profile adds only its DELTAS on top: a finish variant
  (protocol/finish.spthy or finish_confirmed.spthy), a human layer (bundles/human_common.spthy or a
  manual swap), Blake's compute (interface/recipient.spthy) if a lemma needs it, the post-KDF phase
  kits (phases/ dir), the stressors it arms, and its lemmas. (P4 analyzer / P5 policy-only skip it.)
*/

#include "../../core/types.spthy"
#include "protocol/kdf.spthy"
#include "interface/sender.spthy"
#include "protocol/compute_keyresult.spthy"
#include "../../core/masks/compute_behavior.spthy"
