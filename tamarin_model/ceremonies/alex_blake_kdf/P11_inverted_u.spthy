theory ToyCeremony_P11_InvertedU
begin

/*
  P11 -- the INVERTED-U facilitating zone (Yerkes-Dodson). The AUTHORIZE control is MODERATE arousal
  ('med'), below SecurityAnxiety's 'hi' threshold -- so anxiety never fires, the user stays Attentive
  and GRANTS, and the Fearful abort is unreachable. Contrast P2/P3 at 'hi' (abort reachable): moderate
  stakes do not freeze the user, only high ones do.
  Run: check.py --prove ceremonies/alex_blake_kdf/P11_inverted_u.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline (Attentive)
#include "protocol/finish.spthy"
#include "bundles/human_manual.spthy"     // manual layer -- the moderate-arousal seed below is the profile

// moderate arousal seed (profile-local): authorize is 'med' -- the facilitating zone
rule Seed_moderate_arousal [color=#9b51e0]:
    [ ] --[ SeedModArousal() ]->
    [ !Demands('authorize', 'Arousal', 'med') ]
restriction OnceModArousal: "All #i #j. SeedModArousal()@i & SeedModArousal()@j ==> #i = #j"

#include "phases/authorize.spthy"
#include "../../core/stressors/security_anxiety.spthy"   // cannot fire at 'med' arousal

#include "experiments/P11_inverted_u.spthy"

end
