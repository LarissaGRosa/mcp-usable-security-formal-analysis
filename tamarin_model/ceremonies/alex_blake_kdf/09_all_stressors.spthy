theory ToyCeremony_AllStressors
begin

/*
  ENTRY POINT -- Experiment 09 · ALL stressors / masks / phases (the maximal ceremony).
  Profile (machinery §6.1):
      E_9 = < C0 + APPROVE + VERIFY + AUTHORIZE phases + recovery,
              {Attentive, Busy, Careless, Habituated, Naive, Fearful},
              {sigma1, sigma2, sigma3, sigma5, sigma6, sigma8} >.

  The deliberate worst case (§6a): every stressor, mask, phase and the recovery warning on one
  human. Persistent current mask carries across CALC_SK -> APPROVE_REQ -> VERIFY_KEY -> AUTHORIZE.
  Kept tractable by single-human + monotone + once-per-party events + the "active until recovery"
  gate (mask_state.spthy). If it ever stops terminating, that is the §6a blow-up -- narrow the set.
  Run: check.py --prove ceremonies/alex_blake_kdf/09_all_stressors.spthy
*/

#include "ceremony.base.spthy"

// -- masks (every f_H for every phase that a mask can reach) --
#include "../../core/masks/attentive_calc.spthy"
#include "../../core/masks/busy_calc.spthy"
#include "../../core/masks/careless_calc.spthy"
#include "../../core/masks/attentive_approve.spthy"
#include "../../core/masks/busy_approve.spthy"
#include "../../core/masks/careless_approve.spthy"
#include "../../core/masks/habituated_approve.spthy"
#include "../../core/masks/attentive_verify.spthy"
#include "../../core/masks/naive_verify.spthy"
#include "../../core/masks/attentive_authorize.spthy"
#include "../../core/masks/fearful_authorize.spthy"

// -- stressors (all six) --
#include "../../core/stressors/cognitive_load.spthy"
#include "../../core/stressors/external_distraction.spthy"
#include "../../core/stressors/time_pressure.spthy"
#include "../../core/stressors/habituation.spthy"
#include "../../core/stressors/abstraction.spthy"
#include "../../core/stressors/security_anxiety.spthy"

// -- transitions / gates --
#include "../../core/transitions/mask_state.spthy"
#include "../../core/transitions/answered_once.spthy"

// -- protocol: CALC_SK via request, then session + every post-KDF phase + the recovery warning --
#include "protocol/msg3_request.spthy"
#include "protocol/session.spthy"
#include "protocol/approval_ui.spthy"
#include "protocol/verify_ui.spthy"
#include "protocol/authorize_ui.spthy"
#include "protocol/warning_ui.spthy"

// -- experiment --
#include "experiments/09_all_stressors.spthy"

end
