/*
  protocol/msg3_inline.spthy -- PROTOCOL LAYER, Msg3 variant: INLINE.
  An Attentive Alex derives SK = kdf(N_A,N_B) himself and finishes -- no request
  indirection, no stressor on the KDF. Used by Experiment 00 (walking skeleton) and as the
  KDF baseline under Experiment 02 (whose stress is on the separate APPROVE_REQ UI phase).
  The request/ack variant is protocol/msg3_request.spthy.
*/

rule A_recv_Nb_ack:
    [ AlexWait(idA,Na), In(Nb) ]
  --[ Calc('Alex','Attentive'), Key('Alex', kdf(Na,Nb)), Finish('Alex') ]->
    [ AlexDone(idA, kdf(Na,Nb)), Out('ACK') ]
