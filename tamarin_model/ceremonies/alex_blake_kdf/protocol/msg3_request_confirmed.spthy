/*
  protocol/msg3_request_confirmed.spthy -- Msg3 variant: REQUEST / ACK WITH a key-confirmation
  shutdown (Experiment 16, the "fix verified" pair to Experiment 01). Same request indirection as
  msg3_request, but Alex does NOT ack unconditionally: a key-confirmation step compares the
  computed key against the expected kdf of the agreed nonces and only then finishes.

  shutdown (Poka-Yoke "Detection"): detect the error and HALT before harm. A Busy slip produces a
  key whose top symbol is not kdf, so the confirmation fails and the ceremony aborts (ShutdownAbort,
  no Finish) instead of completing with the wrong key. Restrictions kept LOCAL: a global "no Finish
  without key-confirmation" would break every experiment that legitimately finishes plainly.
*/

rule A_recv_Nb_request:
    [ AlexWait(idA,Na), In(Nb), Fr(~rid) ]
  --[ Request('Alex', ~rid, 'CALC_SK', 'Hard') ]->
    [ AlexAwaitKey(idA, ~rid),
      !Req('Alex', ~rid, 'CALC_SK', <Na,Nb>, 'Hard') ]

// keys match the expected derivation -> confirmed -> finish.
rule A_confirm_ok:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Req('Alex', rid, 'CALC_SK', <Na,Nb>, c) ]
  --[ KeyEq(sk, kdf(Na,Nb)), KeyConfirmed('Alex'), Finish('Alex') ]->
    [ AlexDone(idA, sk) ]

// mismatch detected -> shutdown halt (no AlexDone, no Finish).
rule A_confirm_abort:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Req('Alex', rid, 'CALC_SK', <Na,Nb>, c) ]
  --[ KeyNeq(sk, kdf(Na,Nb)), ShutdownAbort('Alex') ]->
    [ ]

restriction KeyEqHolds:
  "All x y #i. KeyEq(x,y)@i ==> x = y"

restriction KeyNeqHolds:
  "All x #i. KeyNeq(x,x)@i ==> F"
