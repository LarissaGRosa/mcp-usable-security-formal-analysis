/*
  protocol/op_tokens.spthy -- PROTOCOL LAYER, a token-bounded multi-operation harness.
  Seeds a FIXED number of operation tokens (here 2), so the human is posed at most that many
  compute operations -- bounded (no unbounded poser), which keeps the trace-counting detectors
  terminating (MEMORY.md). Each Pose records the objective operation !Op(...,'kdf',kdf(Na,Nb)).
*/

rule Seed_ops:
    [ AlexInit(idA) ]
  --[ Seeded('Alex') ]->
    [ OpToken(idA), OpToken(idA) ]

rule Pose_op:
    [ OpToken(idA), Fr(~rid), Fr(~Na), In(Nb) ]
  --[ PoseOp('Alex', 'kdf') ]->
    [ !Op('Alex', ~rid, 'kdf', kdf(~Na, Nb)), Pending(idA, ~rid) ]

rule Finish_op:
    [ Pending(idA, rid), OpResult('Alex', rid, m) ]
  --[ DoneOp('Alex', rid) ]->
    [ ]
