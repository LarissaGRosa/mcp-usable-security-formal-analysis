/*
  protocol/approval_shutout_ui.spthy -- the APPROVE_REQ phase WITH the number-matching shutout
  mitigation (Experiment 14). Mirrors approval_ui but the adversary-injected prompt is now
  Shutout-protected (number-matching). Reads the persistent !Session (loop-free); needs session.spthy.
    * UI_self_prompt   -- legitimate self prompt (drives habituation as before).
    * UI_inject_shutout -- adversary-injected prompt, but protected: marks Shutout(pid), so
      core/mitigations.spthy forbids auto_approve on it.
*/

// !Step('Alex',_,'confirm'): Layer-1 objective step (agnostic interface) -- the migrated sigma8
// counts these (>=2 distinct -> Habituated). Same as approval_ui; the injected one is also Shutout.
// !StepData = OBSERVABLES <claimed, own> (verdict derived in confirm_behavior, lesson 14).
rule UI_self_prompt:
    [ !Session('Alex', idA, sk), Fr(~pid) ]
  --[ PromptShown('Alex', ~pid, 'self') ]->
    [ !Step('Alex', ~pid, 'confirm'),
      !StepData('Alex', ~pid, <~pid, ~pid>) ]

rule UI_inject_shutout:
    [ !Session('Alex', idA, sk), In(pid), Fr(~own) ]
  --[ PromptShown('Alex', pid, 'injected'), Injected(pid), Shutout(pid) ]->
    [ !Step('Alex', pid, 'confirm'),
      !StepData('Alex', pid, <pid, ~own>) ]
