/*
  protocol/authorize_ui.spthy -- PROTOCOL LAYER, the AUTHORIZE phase (used by Experiment 07).
  After the session is up, Alex is asked to authorize a sensitive operation. Reads the
  persistent !Session (loop-free). Needs protocol/session.spthy.
*/

rule UI_authorize_request:
    [ !Session('Alex', idA, sk), Fr(~aid) ]
  --[ AuthPrompt('Alex', ~aid) ]->
    [ !AuthReq('Alex', ~aid) ]
