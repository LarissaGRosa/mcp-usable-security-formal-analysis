/*
  protocol/finish.spthy -- PROTOCOL LAYER (blue #1f6fd0): the PLAIN finish + session handle.
  Consumes the key the human's compute step produced (via compute_keyresult) and completes the
  ceremony unconditionally; the post-KDF session handle is derived from Alex's completion. A profile
  wanting the key-confirmation SHUTDOWN mitigation instead includes protocol/finish_confirmed.spthy
  (never both). Pairs with protocol/kdf.spthy.
*/

rule P_finish_alex [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk) ]
  --[ Finish('Alex') ]->
    [ AlexDone(idA, sk), Out('ACK') ]

// (Blake derives his key via the compute behaviour -- Key('Blake',_) -- but has no separate
//  "finish": no lemma needs Blake's completion, so his KeyResult is simply not consumed.)

// post-KDF session handle (read by the post-KDF interface prompts; loop-free).
rule P_enter_session [color=#1f6fd0]:
    [ AlexDone(idA, sk) ]
  --[ SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]
