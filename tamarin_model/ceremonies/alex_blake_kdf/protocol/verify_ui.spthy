/*
  protocol/verify_ui.spthy -- PROTOCOL LAYER, the VERIFY_KEY phase (used by Experiment 06).
  After the session is up, Alex is asked to verify a key fingerprint -- an abstract crypto
  check (the PGP-style "compare the fingerprints" step). Two sources, mirroring approval_ui:
    * UI_verify_genuine  -- the real fingerprint (fresh ~vid; never on the wire, unforgeable).
    * UI_verify_tampered -- an adversary-supplied fingerprint (vid from In); Tampered(vid) marks it.
  Reads the persistent !Session (loop-free). Needs protocol/session.spthy.
*/

// !Step('Alex',_,'compare'): Layer-1 objective step (agnostic interface). A fingerprint check is a
// 'compare' action the lexicon marks high-Effort -> the migrated sigma6 reads it, not !VerifyReq.
rule UI_verify_genuine:
    [ !Session('Alex', idA, sk), Fr(~vid) ]
  --[ VerifyPrompt('Alex', ~vid, 'genuine') ]->
    [ !Step('Alex', ~vid, 'compare'),
      // !StepData = OBSERVABLES <offered, reference>: here the displayed fingerprint IS the true one.
      // The verdict is derived in compare_behavior (Attentive matches offered = reference), not here.
      !StepData('Alex', ~vid, <~vid, ~vid>) ]

// Adversary substitutes the displayed fingerprint (vid from In); ~ref is the prompt's true
// fingerprint (fresh, never on the wire), so offered = reference is underivable for the adversary
// and Compare_attentive can never fire on this step. Tampered(vid) stays as provenance for lemmas.
rule UI_verify_tampered:
    [ !Session('Alex', idA, sk), In(vid), Fr(~ref) ]
  --[ VerifyPrompt('Alex', vid, 'tampered'), Tampered(vid) ]->
    [ !Step('Alex', vid, 'compare'),
      !StepData('Alex', vid, <vid, ~ref>) ]
