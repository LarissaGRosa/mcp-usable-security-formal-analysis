/*
  protocol/finish_confirmed.spthy -- PROTOCOL LAYER (blue #1f6fd0): finish WITH the key-confirmation
  SHUTDOWN mitigation (Poka-Yoke "Detection", P6). Instead of completing unconditionally
  (protocol/finish.spthy), Alex's client re-derives the key and checks it against the value the
  compute step should have produced (the persistent !StepData observable = kdf(Na,Nb)); on a mismatch
  the ceremony HALTS. So a Busy slip (a fresh wrong key) can never complete -- it is caught here.
  Include this INSTEAD of protocol/finish.spthy. Pairs with protocol/kdf.spthy.
*/

// keys match -> finish.
rule P_confirm_ok [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !StepData('Alex', rid, correct) ]
  --[ KeyEq(sk, correct), KeyConfirmed('Alex'), Finish('Alex') ]->
    [ AlexDone(idA, sk), Out('ACK') ]

// mismatch -> halt (the shutdown).
rule P_confirm_abort [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !StepData('Alex', rid, correct) ]
  --[ KeyNeq(sk, correct), ShutdownAbort('Alex') ]->
    [ ]

restriction KeyEqHolds:  "All x y #i. KeyEq(x,y)@i ==> x = y"
restriction KeyNeqHolds: "All x #i. KeyNeq(x,x)@i ==> F"

rule P_enter_session [color=#1f6fd0]:
    [ AlexDone(idA, sk) ]
  --[ SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]
