/*
  protocol/kdf.spthy -- PROTOCOL LAYER (blue #1f6fd0) for alex_blake_kdf, V3 layered template.

  LAYERING CONTRACT (mirrors secure_email): protocol rules exchange only the wire (Out/In) and
  result facts with the interface; they never read or write a human-layer fact. The interface poses
  the compute prompt and hands back AwaitKey; the human layer answers it (compute_behavior ->
  Respond -> compute_keyresult adapter -> KeyResult); this file consumes KeyResult to finish.

  The ceremony: Alex and Blake exchange two nonces over the public (Dolev-Yao) channel and each
  derives SK = kdf(N_A, N_B). Neither party computes inline any more -- the derivation is a 'compute'
  step the interface presents (interface/sender.spthy, interface/recipient.spthy), so BOTH parties
  are subject to the mask machinery. !Party(p,id) is the read-only handle the per-party stress
  enable reads (protocol/stress_alex.spthy / stress_blake.spthy).
*/

rule P_init_alex [color=#1f6fd0]:
    [ Fr(~idA) ] --[ Start('Alex') ]-> [ AlexInit(~idA), !Party('Alex', ~idA) ]

rule P_init_blake [color=#1f6fd0]:
    [ Fr(~idB) ] --[ Start('Blake') ]-> [ BlakeInit(~idB), !Party('Blake', ~idB) ]

// ---- nonce exchange over the public channel ----
//   Msg1  A->B : N_A
//   Msg2  B->A : N_B
rule P_send_na [color=#1f6fd0]:
    [ AlexInit(idA), Fr(~Na) ]
  --[ Send('Alex', ~Na) ]->
    [ AlexWait(idA, ~Na), Out(~Na) ]

rule P_recv_na_send_nb [color=#1f6fd0]:
    [ BlakeInit(idB), In(Na), Fr(~Nb) ]
  --[ Send('Blake', ~Nb) ]->
    [ BlakeHasNonces(idB, <Na, ~Nb>), !NoncesSeen('Blake', idB, <Na, ~Nb>), Out(~Nb) ]

rule P_recv_nb [color=#1f6fd0]:
    [ AlexWait(idA, Na), In(Nb) ]
  --[ Recv('Alex', Nb) ]->
    [ AlexHasNonces(idA, <Na, Nb>), !NoncesSeen('Alex', idA, <Na, Nb>) ]

// ---- finish + session live in protocol/finish.spthy (plain) or protocol/finish_confirmed.spthy
//      (the shutdown mitigation, P6). A profile includes exactly one of them. ----
