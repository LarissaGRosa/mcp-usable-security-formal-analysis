theory ToyCeremony_P6_Mitigations
begin

/*
  P6 -- three Poka-Yoke mitigations in one ceremony. The stressors still degrade the user, but each
  fix neutralizes the consequence: shutdown (key-confirmation finish) catches the sigma1 slip;
  shutout (number-matching MFA) blocks the sigma8 auto-approve; verify-shutout blocks the sigma6
  tampered acceptance. Run: check.py --prove ceremonies/alex_blake_kdf/P6_mitigations.spthy
*/

#include "spine.spthy"                        // crypto + KDF wire + Alex compute pipeline
#include "protocol/finish_confirmed.spthy"    // SHUTDOWN: key-confirmation finish
#include "bundles/human_common.spthy"
#include "../../core/mitigations.spthy"       // shutout + verify-shutout restrictions

#include "../../core/stressors/cognitive_load.spthy"   // sigma1 -> slip (caught by shutdown)
#include "phases/approve_shutout.spthy"
#include "../../core/stressors/habituation.spthy"      // sigma8 -> auto-approve (blocked by shutout)
#include "phases/verify.spthy"
#include "../../core/stressors/abstraction.spthy"      // sigma6 -> mistake (blocked by verify-shutout)

#include "experiments/P6_mitigations.spthy"

end
