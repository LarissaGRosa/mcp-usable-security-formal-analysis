/*
  protocol.spthy -- the alex_blake_kdf ceremony layer (crypto + wire + UI prompts), one file.
  Merges the former protocol and interface fragments. Each selectable piece is #ifdef-gated.

  RELAYER prompt/perform (step 3): the UI_* rules and the INFER_HARNESS poser only PROMPT -- they emit
  !Prompt/!Displayed; the user's mask (core/masks.spthy) performs and commits !StepData (+ action
  labels). The one consumer of a committed key is FINISH_CONFIRMED, and it reads the interface's
  !Displayed (the objective correct key) so the shutdown can still catch a slipped/wrong result.
  Sections/flags:

  KDF_INIT           participant init (Alex/Blake) -> AlexInit/BlakeInit + !Party
  KDF_WIRE           nonce exchange N_A/N_B over the public channel
  COMPUTE_KEYRESULT  Respond -> KeyResult adapter (the standard compute output)
  COMPUTE_OPRESULT   Respond -> OpResult adapter (the P4 harness output)   [EITHER/OR]
  FINISH_PLAIN       unconditional finish + session
  FINISH_CONFIRMED   key-confirmation shutdown finish + session           [EITHER/OR]
  UI_POLICY          set-policy prompt + finish
  UI_VERIFY          compare (fingerprint) prompt: genuine + tampered
  UI_AUTHORIZE       authorize prompt
  UI_APPROVE         approval prompts: self + injected
  UI_APPROVE_SHUTOUT approval prompts with number-matching shutout
  UI_WARNING         re-engagement warning -> recovery to Attentive (!EffectiveMask)
  STRESS_ALEX        !StressEnable('Alex')     STRESS_BLAKE  !StressEnable('Blake')
  IF_CALC_ALEX       Alex's key-derivation prompt (compute, under deadline)
  IF_CALC_BLAKE      Blake's key-derivation prompt (multi-party)
  IF_NONCE_ACK       exposure-only nonce acknowledgement (sigma2/additive)
  INFER_HARNESS      the P4 token-bounded op/verify/decision poser
*/

#ifdef KDF_INIT
// ===== participant init =====
rule P_init_alex [color=#1f6fd0]:
    [ Fr(~idA) ] --[ Start('Alex') ]-> [ AlexInit(~idA), !Party('Alex', ~idA) ]

rule P_init_blake [color=#1f6fd0]:
    [ Fr(~idB) ] --[ Start('Blake') ]-> [ BlakeInit(~idB), !Party('Blake', ~idB) ]
#endif

#ifdef KDF_WIRE
// ===== nonce exchange over the public (Dolev-Yao) channel =====
rule P_send_na [color=#1f6fd0]:
    [ AlexInit(idA), Fr(~Na) ]
  --[ Send('Alex', ~Na) ]->
    [ AlexWait(idA, ~Na), Out(~Na) ]

rule P_recv_na_send_nb [color=#1f6fd0]:
    [ BlakeInit(idB), In(Na), Fr(~Nb) ]
  --[ Send('Blake', ~Nb) ]->
    [ BlakeHasNonces(idB, <Na, ~Nb>), !NoncesSeen('Blake', idB, <Na, ~Nb>), Out(~Nb) ]

rule P_recv_nb [color=#1f6fd0]:
    [ AlexWait(idA, Na), In(Nb) ]
  --[ Recv('Alex', Nb) ]->
    [ AlexHasNonces(idA, <Na, Nb>), !NoncesSeen('Alex', idA, <Na, Nb>) ]
#endif

#ifdef COMPUTE_KEYRESULT
// ===== compute adapter: Respond -> KeyResult =====
rule Compute_to_KeyResult:
    [ Respond(P, rid, v) ]
  -->
    [ KeyResult(P, rid, v) ]
#endif

#ifdef COMPUTE_OPRESULT
// ===== compute adapter: Respond -> OpResult (P4) =====
rule Compute_to_OpResult:
    [ Respond(P, rid, v) ]
  -->
    [ OpResult(P, rid, v) ]
#endif

#ifdef FINISH_PLAIN
// ===== plain finish + session =====
rule P_finish_alex [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk) ]
  --[ Finish('Alex') ]->
    [ AlexDone(idA, sk), Out('ACK') ]

rule P_enter_session [color=#1f6fd0]:
    [ AlexDone(idA, sk) ]
  --[ SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]
#endif

#ifdef FINISH_CONFIRMED
// ===== key-confirmation SHUTDOWN finish (P6) + session =====
// The shutdown compares the human's COMMITTED key (KeyResult) against the objective correct key the
// interface DISPLAYED (kdf(Na,Nb)) -- not against the human's own commit, which would trivially match.
rule P_confirm_ok [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Displayed('Alex', rid, correct) ]
  --[ KeyEq(sk, correct), KeyConfirmed('Alex'), Finish('Alex') ]->
    [ AlexDone(idA, sk), Out('ACK') ]

rule P_confirm_abort [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Displayed('Alex', rid, correct) ]
  --[ KeyNeq(sk, correct), ShutdownAbort('Alex') ]->
    [ ]

restriction KeyEqHolds:  "All x y #i. KeyEq(x,y)@i ==> x = y"
restriction KeyNeqHolds: "All x #i. KeyNeq(x,x)@i ==> F"

rule P_enter_session_confirmed [color=#1f6fd0]:
    [ AlexDone(idA, sk) ]
  --[ SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]
#endif

#ifdef UI_POLICY
// ===== set-policy prompt + finish =====
rule UI_policy_prompt:
    [ !Party('Alex', idA), Fr(~pid) ]
  --[ PolicyPrompt('Alex', ~pid) ]->
    [ PolicyPending(idA, ~pid),
      Prompt('Alex', ~pid, 'set-policy'), !Demand('Alex', ~pid, 'set-policy') ]

restriction OnePolicyPromptPerParty:
  "All p pid1 pid2 #i #j. PolicyPrompt(p, pid1)@i & PolicyPrompt(p, pid2)@j ==> #i = #j"

rule A_finish_policy:
    [ PolicyPending(idA, pid), PolicyDone('Alex', pid) ]
  --[ Finish('Alex') ]->
    [ ]
#endif

#ifdef UI_VERIFY
// ===== compare (fingerprint) prompt: genuine + adversary-tampered =====
rule UI_verify_genuine:
    [ !Session('Alex', idA, sk), Fr(~vid) ]
  --[ VerifyPrompt('Alex', ~vid, 'genuine') ]->
    [ Prompt('Alex', ~vid, 'compare'), !Demand('Alex', ~vid, 'compare'),
      !Displayed('Alex', ~vid, <~vid, ~vid>) ]

rule UI_verify_tampered:
    [ !Session('Alex', idA, sk), In(vid), Fr(~ref) ]
  --[ VerifyPrompt('Alex', vid, 'tampered'), Tampered(vid) ]->
    [ Prompt('Alex', vid, 'compare'), !Demand('Alex', vid, 'compare'),
      !Displayed('Alex', vid, <vid, ~ref>) ]
#endif

#ifdef UI_AUTHORIZE
// ===== authorize prompt =====
rule UI_authorize_request:
    [ !Session('Alex', idA, sk), Fr(~aid) ]
  --[ AuthPrompt('Alex', ~aid) ]->
    [ Prompt('Alex', ~aid, 'authorize'), !Demand('Alex', ~aid, 'authorize') ]
#endif

#ifdef UI_APPROVE
// ===== approval prompts: legitimate self + adversary-injected =====
rule UI_issue_self_prompt:
    [ !Session('Alex', idA, sk), Fr(~pid) ]
  --[ PromptShown('Alex', ~pid, 'self') ]->
    [ Prompt('Alex', ~pid, 'confirm'), !Demand('Alex', ~pid, 'confirm'),
      !Displayed('Alex', ~pid, <~pid, ~pid>) ]

rule UI_inject_prompt:
    [ !Session('Alex', idA, sk), In(pid), Fr(~own) ]
  --[ PromptShown('Alex', pid, 'injected'), Injected(pid) ]->
    [ Prompt('Alex', pid, 'confirm'), !Demand('Alex', pid, 'confirm'),
      !Displayed('Alex', pid, <pid, ~own>) ]
#endif

#ifdef UI_APPROVE_SHUTOUT
// ===== approval prompts WITH number-matching shutout (P6) =====
rule UI_self_prompt:
    [ !Session('Alex', idA, sk), Fr(~pid) ]
  --[ PromptShown('Alex', ~pid, 'self') ]->
    [ Prompt('Alex', ~pid, 'confirm'), !Demand('Alex', ~pid, 'confirm'),
      !Displayed('Alex', ~pid, <~pid, ~pid>) ]

rule UI_inject_shutout:
    [ !Session('Alex', idA, sk), In(pid), Fr(~own) ]
  --[ PromptShown('Alex', pid, 'injected'), Injected(pid), Shutout(pid) ]->
    [ Prompt('Alex', pid, 'confirm'), !Demand('Alex', pid, 'confirm'),
      !Displayed('Alex', pid, <pid, ~own>) ]
#endif

#ifdef UI_WARNING
// ===== good-usability re-engagement warning -> recovery to Attentive =====
rule UI_warning_reengage:
    [ !Session('Alex', idA, sk), !EffectiveMask('Alex', m), !Compose(m, 'Attentive', m) ]
  --[ WarningShown('Alex'), InequalityMask(m, 'Attentive'), SetMask('Alex','Attentive'), Recover('Alex'), RecoveryDone('Alex') ]->
    [ !EffectiveMask('Alex', 'Attentive') ]

restriction OnceWarningShown:
  "All #i #j. WarningShown('Alex')@i & WarningShown('Alex')@j ==> #i = #j"

restriction OnceRecoveryDone:
  "All #i #j. RecoveryDone('Alex')@i & RecoveryDone('Alex')@j ==> #i = #j"
#endif

#ifdef STRESS_ALEX
// ===== stress targeting: Alex =====
rule Enable_Stress_Alex:
    [ !Party('Alex', id) ] --[ StressOn('Alex') ]-> [ !StressEnable('Alex') ]

restriction OnceStressAlex:
  "All #i #j. StressOn('Alex')@i & StressOn('Alex')@j ==> #i = #j"
#endif

#ifdef STRESS_BLAKE
// ===== stress targeting: Blake =====
rule Enable_Stress_Blake:
    [ !Party('Blake', id) ] --[ StressOn('Blake') ]-> [ !StressEnable('Blake') ]

restriction OnceStressBlake:
  "All #i #j. StressOn('Blake')@i & StressOn('Blake')@j ==> #i = #j"
#endif

#ifdef INFER_HARNESS
// ===== P4 token-bounded op/verify/decision harness =====
rule Seed_infer:
    [ AlexInit(idA) ]
  --[ Seeded('Alex') ]->
    [ OpToken(idA), OpToken(idA),
      DecToken(idA), DecToken(idA), DecToken(idA), DecToken(idA) ]

rule Pose_kdf:
    [ OpToken(idA), Fr(~rid), Fr(~Na), In(Nb) ]
  --[ PoseOp('Alex', 'kdf') ]->
    [ Pending(idA, ~rid),
      Prompt('Alex', ~rid, 'compute'), !Demand('Alex', ~rid, 'compute'),
      !Displayed('Alex', ~rid, kdf(~Na, Nb)) ]

rule Pose_verify_genuine:
    [ OpToken(idA), Fr(~vid) ]
  --[ PoseOp('Alex', 'verify'), GenuineFp('Alex', ~vid) ]->
    [ Pending(idA, ~vid),
      Prompt('Alex', ~vid, 'compare'), !Demand('Alex', ~vid, 'compare'),
      !Displayed('Alex', ~vid, <~vid, ~vid>) ]

rule Pose_verify_tampered:
    [ OpToken(idA), Fr(~vid), In(x) ]
  --[ PoseOp('Alex', 'verify'), TamperedFp('Alex', ~vid) ]->
    [ Pending(idA, ~vid),
      Prompt('Alex', ~vid, 'compare'), !Demand('Alex', ~vid, 'compare'),
      !Displayed('Alex', ~vid, <x, ~vid>) ]

rule Pose_decision:
    [ DecToken(idA), Fr(~did) ]
  --[ PoseDecision('Alex', ~did) ]->
    [ DecPending(idA, ~did),
      Prompt('Alex', ~did, 'decide'), !Demand('Alex', ~did, 'decide') ]

rule Finish_op:
    [ Pending(idA, rid), OpResult('Alex', rid, m) ]
  --[ DoneOp('Alex', rid) ]->
    [ ]

rule Finish_verify:
    [ Pending(idA, rid), VerifyDone('Alex', rid) ]
  --[ DoneVerify('Alex', rid) ]->
    [ ]

rule Finish_decision:
    [ DecPending(idA, did), DecisionDone('Alex', did) ]
  --[ DoneDecision('Alex', did) ]->
    [ ]
#endif

#ifdef IF_CALC_ALEX
rule IF_calc_alex [color=#f2994a]:
    [ AlexHasNonces(idA, <Na, Nb>), Fr(~rid) ]
  --[ UIStep('Alex', 'calc_sk') ]->
    [ Prompt('Alex', ~rid, 'compute'), !Demand('Alex', ~rid, 'compute'),
      !Displayed('Alex', ~rid, kdf(Na, Nb)),
      !UnderDeadline(~rid),
      AlexAwaitKey(idA, ~rid) ]
#endif

#ifdef IF_CALC_BLAKE
rule IF_calc_blake [color=#f2994a]:
    [ BlakeHasNonces(idB, <Na, Nb>), Fr(~rid) ]
  --[ UIStep('Blake', 'calc_sk') ]->
    [ Prompt('Blake', ~rid, 'compute'), !Demand('Blake', ~rid, 'compute'),
      !Displayed('Blake', ~rid, kdf(Na, Nb)),
      !UnderDeadline(~rid),
      BlakeAwaitKey(idB, ~rid) ]
#endif

#ifdef SIGMA2_CONCURRENCY
// concurrency surface: the calc + nonce-ack controls compete for attention -> the single sigma2 marker
// (dedicated surface; keeps sigma2 O(1) instead of an N^2 !Demand product).
rule IF_concurrency_surface [color=#f2994a]:
    [ !StressEnable(P) ] --[ UIStep(P,'concurrent_controls'), SeedCopresent(P) ]-> [ !Copresent(P) ]

restriction OnceCopresent:
  "All p #i #j. SeedCopresent(p)@i & SeedCopresent(p)@j ==> #i = #j"
#endif

#ifdef SIGMA9_ALERTVOLUME
// alert-volume surface: the harness poses a stream of decisions -> the single sigma9 marker (dedicated
// surface; keeps sigma9 O(1) instead of an N^3 !Demand product).
rule IF_alertvolume_surface [color=#f2994a]:
    [ !StressEnable(P) ] --[ UIStep(P,'decision_stream'), SeedCopresentDecide(P) ]-> [ !CopresentDecide(P) ]

restriction OnceCopresentDecide:
  "All p #i #j. SeedCopresentDecide(p)@i & SeedCopresentDecide(p)@j ==> #i = #j"
#endif

#ifdef IF_NONCE_ACK
rule IF_nonce_ack_alex [color=#f2994a]:
    [ !NoncesSeen('Alex', idA, <Na, Nb>), Fr(~pid) ]
  --[ UIStep('Alex', 'nonce_ack'), NonceAck('Alex') ]->
    [ Prompt('Alex', ~pid, 'confirm'), !Demand('Alex', ~pid, 'confirm'), !Displayed('Alex', ~pid, <Nb, Nb>) ]

rule IF_nonce_ack_blake [color=#f2994a]:
    [ !NoncesSeen('Blake', idB, <Na, Nb>), Fr(~pid) ]
  --[ UIStep('Blake', 'nonce_ack'), NonceAck('Blake') ]->
    [ Prompt('Blake', ~pid, 'confirm'), !Demand('Blake', ~pid, 'confirm'), !Displayed('Blake', ~pid, <Na, Na>) ]

restriction OnceNonceAckPerParty:
  "All p #i #j. NonceAck(p)@i & NonceAck(p)@j ==> #i = #j"
#endif

#ifdef KDF_MESSENGER
// ===== invented PRIVATE messenger interface (K-profiles) -- alternative to KDF_WIRE =====
// Each party manually TRANSCRIBES its own nonce and SHARES it over a PRIVATE Chat(); the correspondent
// reads it from the chat. The DY adversary learns a nonce ONLY on a human mistake (share misdeliver /
// inband-leak -> Out(nonce)). sk = kdf(Na,Nb): kdf/2 is FREE, so K(sk) needs BOTH nonces -- leaking ONE
// is provably insufficient. Arms only transcribe / share / compute -- ZERO new core rules. Both parties
// symmetric; a profile stresses ONE (STRESS_ALEX/BLAKE), or both to reach the full breach.
// Tractability: shallow anchors, single-source joins, the single sigma2 !Copresent marker.
// Proven (both-stress, ~17s): completion (both SessionUp), secrecy-absolute (no mistake -> no K(sk)),
// the compositional payoff "K(sk) => BOTH parties leaked a nonce" (one leak insufficient), breach
// reachable. DEFERRED to step 8 (added when arming K2_mitm / K4_confirm, with tractability checks):
// K2 incoming-nonce MITM compare, K3 key-entry transcribe (additive), K4 explicit start-session
// authorize + OUTCOME_PREMATURE (SessionUnconfirmed). K4 currently finishes via the compute-vs-DISPLAYED
// shutdown (lesson-19 trap).

// --- K1 send-code: transcribe own nonce (!Displayed = own nonce) + share to the correspondent's chat ---
rule IF_k1_alex [color=#f2994a]:
    [ AlexInit(idA), Fr(~Na), Fr(~nId), Fr(~shId) ]
  --[ PoseK1('Alex'), OwnNonce('Alex', ~Na) ]->
    [ Prompt('Alex', ~nId, 'transcribe'), !Demand('Alex', ~nId, 'transcribe'), !Displayed('Alex', ~nId, ~Na),
      Prompt('Alex', ~shId, 'share'),     !Demand('Alex', ~shId, 'share'),     !Displayed('Alex', ~shId, <'Blake','Blake','nonce'>),
      !Copresent('Alex'), !AlexNonce(idA, ~Na), K1Alex(idA, ~nId, ~shId) ]

rule IF_k1_blake [color=#f2994a]:
    [ BlakeInit(idB), Fr(~Nb), Fr(~nId), Fr(~shId) ]
  --[ PoseK1('Blake'), OwnNonce('Blake', ~Nb) ]->
    [ Prompt('Blake', ~nId, 'transcribe'), !Demand('Blake', ~nId, 'transcribe'), !Displayed('Blake', ~nId, ~Nb),
      Prompt('Blake', ~shId, 'share'),     !Demand('Blake', ~shId, 'share'),     !Displayed('Blake', ~shId, <'Alex','Alex','nonce'>),
      !Copresent('Blake'), !BlakeNonce(idB, ~Nb), K1Blake(idB, ~nId, ~shId) ]

restriction OncePoseK1: "All p #i #j. PoseK1(p)@i & PoseK1(p)@j ==> #i = #j"

// K1 send EFFECT: route the COMMITTED transcription (a Busy slip ships the typo) by the share outcome.
// oob -> private Chat; misdeliver -> Out(nonce) to the wrong contact; inband-leak -> Chat + Out(nonce).
rule IF_k1_alex_oob [color=#1f6fd0]:
    [ K1Alex(idA, nId, shId), !StepData('Alex', nId, val), ShareOutcome('Alex', shId, 'oob') ]
  --[ ShareRoute('Alex','oob') ]-> [ Chat('Blake', val) ]
rule IF_k1_alex_misdeliver [color=#c0392b]:
    [ K1Alex(idA, nId, shId), !StepData('Alex', nId, val), ShareOutcome('Alex', shId, 'misdeliver') ]
  --[ ShareRoute('Alex','misdeliver'), MisdeliveredNonce('Alex') ]-> [ Out(val) ]
rule IF_k1_alex_inband [color=#c0392b]:
    [ K1Alex(idA, nId, shId), !StepData('Alex', nId, val), ShareOutcome('Alex', shId, 'inband-leak') ]
  --[ ShareRoute('Alex','inband-leak'), NonceLeaked('Alex') ]-> [ Chat('Blake', val), Out(val) ]

rule IF_k1_blake_oob [color=#1f6fd0]:
    [ K1Blake(idB, nId, shId), !StepData('Blake', nId, val), ShareOutcome('Blake', shId, 'oob') ]
  --[ ShareRoute('Blake','oob') ]-> [ Chat('Alex', val) ]
rule IF_k1_blake_misdeliver [color=#c0392b]:
    [ K1Blake(idB, nId, shId), !StepData('Blake', nId, val), ShareOutcome('Blake', shId, 'misdeliver') ]
  --[ ShareRoute('Blake','misdeliver'), MisdeliveredNonce('Blake') ]-> [ Out(val) ]
rule IF_k1_blake_inband [color=#c0392b]:
    [ K1Blake(idB, nId, shId), !StepData('Blake', nId, val), ShareOutcome('Blake', shId, 'inband-leak') ]
  --[ ShareRoute('Blake','inband-leak'), NonceLeaked('Blake') ]-> [ Chat('Alex', val), Out(val) ]

// --- receive the correspondent's nonce from the private chat ---
rule IF_recv_alex [color=#1f6fd0]:
    [ !AlexNonce(idA, Na), Chat('Alex', Nb) ] --[ RecvNonce('Alex', Nb) ]-> [ AlexBoth(idA, Na, Nb) ]
rule IF_recv_blake [color=#1f6fd0]:
    [ !BlakeNonce(idB, Nb), Chat('Blake', Na) ] --[ RecvNonce('Blake', Na) ]-> [ BlakeBoth(idB, Na, Nb) ]

// --- K3 calculate: the interface DISPLAYS the correct key kdf(Na,Nb); the compute mask commits it
// (COMPUTE_KEYRESULT adapter -> KeyResult). Secret(sk) is born here (both nonces known). ---
// K3 also poses the K4 "start session" AUTHORIZE, co-present with the derivation (the two controls the
// human faces at once). The session normally requires the key-confirmation shutdown to have PASSED.
rule IF_k3_alex [color=#f2994a]:
    [ AlexBoth(idA, Na, Nb), Fr(~rid), Fr(~sid) ]
  --[ PoseK3('Alex'), Secret(kdf(Na, Nb)) ]->
    [ Prompt('Alex', ~rid, 'compute'),   !Demand('Alex', ~rid, 'compute'), !Displayed('Alex', ~rid, kdf(Na, Nb)), !UnderDeadline(~rid),
      Prompt('Alex', ~sid, 'authorize'), !Demand('Alex', ~sid, 'authorize'),
      !Copresent('Alex'),
      AlexAwaitKey(idA, ~rid), !AlexStart(idA, ~sid) ]
rule IF_k3_blake [color=#f2994a]:
    [ BlakeBoth(idB, Na, Nb), Fr(~rid), Fr(~sid) ]
  --[ PoseK3('Blake'), Secret(kdf(Na, Nb)) ]->
    [ Prompt('Blake', ~rid, 'compute'),   !Demand('Blake', ~rid, 'compute'), !Displayed('Blake', ~rid, kdf(Na, Nb)), !UnderDeadline(~rid),
      Prompt('Blake', ~sid, 'authorize'), !Demand('Blake', ~sid, 'authorize'),
      !Copresent('Blake'),
      BlakeAwaitKey(idB, ~rid), !BlakeStart(idB, ~sid) ]

restriction OncePoseK3: "All p #i #j. PoseK3(p)@i & PoseK3(p)@j ==> #i = #j"

// --- K4 confirm + session: the shutdown compares the COMMITTED key against the interface's DISPLAYED
// correct key (lesson-19 trap -- never against the human's own commit) -> session on match; abort else. ---
rule IF_k4_alex_ok [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Displayed('Alex', rid, correct) ]
  --[ KMKeyEq(sk, correct), KeyConfirmed('Alex'), Finish('Alex'), SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]
rule IF_k4_alex_abort [color=#1f6fd0]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !Displayed('Alex', rid, correct) ]
  --[ KMKeyNeq(sk, correct), ShutdownAbort('Alex') ]-> [ ]
rule IF_k4_blake_ok [color=#1f6fd0]:
    [ BlakeAwaitKey(idB, rid), KeyResult('Blake', rid, sk), !Displayed('Blake', rid, correct) ]
  --[ KMKeyEq(sk, correct), KeyConfirmed('Blake'), Finish('Blake'), SessionUp('Blake') ]->
    [ !Session('Blake', idB, sk) ]
rule IF_k4_blake_abort [color=#1f6fd0]:
    [ BlakeAwaitKey(idB, rid), KeyResult('Blake', rid, sk), !Displayed('Blake', rid, correct) ]
  --[ KMKeyNeq(sk, correct), ShutdownAbort('Blake') ]-> [ ]

restriction KMKeyEqHolds:  "All x y #i. KMKeyEq(x,y)@i ==> x = y"
restriction KMKeyNeqHolds: "All x #i. KMKeyNeq(x,x)@i ==> F"

// K4 PREMATURE (OUTCOME_PREMATURE): a degraded human presses "start session" BEFORE the key-confirmation
// read-back. The grant emits GrantedUnchecked, and THIS rule is its only consumer -- it starts the
// session WITHOUT the KMKeyEq shutdown join, so an unconfirmed (possibly slipped or MITM'd) key goes
// live: SessionUnconfirmed. This is the SAME order-violation lever proved in secure_email
// (SendPremature), which is the RFC-grade generality claim: one core lever, two ceremonies.
#ifdef OUTCOME_PREMATURE
rule IF_k4_alex_premature [color=#c0392b]:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk), !AlexStart(idA, sid), GrantedUnchecked('Alex', sid) ]
  --[ SessionUnconfirmed('Alex'), SessionUp('Alex'), Finish('Alex') ]->
    [ !Session('Alex', idA, sk) ]
rule IF_k4_blake_premature [color=#c0392b]:
    [ BlakeAwaitKey(idB, rid), KeyResult('Blake', rid, sk), !BlakeStart(idB, sid), GrantedUnchecked('Blake', sid) ]
  --[ SessionUnconfirmed('Blake'), SessionUp('Blake'), Finish('Blake') ]->
    [ !Session('Blake', idB, sk) ]
#endif
#endif
