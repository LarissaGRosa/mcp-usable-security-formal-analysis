/*
  ceremonies/alex_blake_kdf/requests.spthy -- PROTOCOL LAYER, Msg3 (Slice 1).
  Refactor of the inline Msg3: instead of computing SK itself, Alex ISSUES a Hard
  CALC_SK request (persistent !Req; §6.4 narrow interface -- only the 'complexity'
  field is carried), then consumes whatever key resulted and ACKs. The f_H that
  actually answers the request lives in core/masks/{attentive,busy}.spthy; the
  stressor/transition that decide WHICH answer live in core/stressors + core/transitions.
*/

rule A_recv_Nb_request:
    [ AlexWait(idA,Na), In(Nb), Fr(~rid) ]
  --[ Request('Alex', ~rid, 'CALC_SK', 'Hard') ]->
    [ AlexAwaitKey(idA, ~rid),
      !Req('Alex', ~rid, 'CALC_SK', <Na,Nb>, 'Hard') ]

rule A_send_ack:
    [ AlexAwaitKey(idA, rid), KeyResult('Alex', rid, sk) ]
  --[ Finish('Alex') ]->
    [ AlexDone(idA, sk), Out('ACK') ]
