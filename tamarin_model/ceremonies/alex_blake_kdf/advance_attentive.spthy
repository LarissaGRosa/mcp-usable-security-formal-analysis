/*
  ceremonies/alex_blake_kdf/advance_attentive.spthy -- PROTOCOL LAYER, Msg3 (Slice 0).
  Walking-skeleton form: an Attentive Alex derives SK = kdf(N_A,N_B) INLINE and finishes.
  No request indirection, no stressor. Slice 1 replaces this file with requests.spthy
  (a CALC_SK request answered by the core/masks f_H rules).
*/

rule A_recv_Nb_ack:
    [ AlexWait(idA,Na), In(Nb) ]
  --[ Calc('Alex','Attentive'), Key('Alex', kdf(Na,Nb)), Finish('Alex') ]->
    [ AlexDone(idA, kdf(Na,Nb)), Out('ACK') ]
