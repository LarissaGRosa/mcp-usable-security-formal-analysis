/*
  ceremonies/alex_blake_kdf/init.spthy -- PROTOCOL LAYER, participant initialization.
  Shared by every experiment of this ceremony. The mask is a label (§6.2), so Init
  carries no mask fact; Start(P) keys OneInstancePerHuman (core/types.spthy).
*/

rule Init_Alex:
    [ Fr(~idA) ] --[ Start('Alex') ]-> [ AlexInit(~idA) ]

rule Init_Blake:
    [ Fr(~idB) ] --[ Start('Blake') ]-> [ BlakeInit(~idB) ]
