/*
  ceremony.base.spthy -- shared spine for every alex_blake_kdf experiment.
  NOT a standalone theory (no theory/begin/end); it is #include-d by each NN_<name>.spthy entry.

  The always-on includes: framework types + the protocol steps common to ALL experiments
  (participant init + Msg1/Msg2 + Blake's DEFAULT Attentive CALC_SK). Each entry point then adds
  only its own DELTAS -- the mask(s)/stressor/transition it exercises, its Msg3 variant, and its
  experiment lemmas. A Blake-stressing experiment does not use this spine (it would pin Blake's
  CALC_SK to the Easy default); it assembles the pieces plus blake_calc_stressable.spthy directly.
  See README.md for the experiment index.
*/

#include "../../core/types.spthy"
#include "protocol/init.spthy"
#include "protocol/messages.spthy"
#include "protocol/blake_calc.spthy"
