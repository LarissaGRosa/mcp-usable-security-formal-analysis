theory ToyCeremony_P1_CalcPressure
begin

/*
  P1 -- CALC_SK under pressure, BOTH parties. The calc surface carries three stressors (sigma1 Load,
  sigma3 Deadline, sigma2 Concurrency via the nonce-ack second prompt), and both Alex and Blake are
  enabled, so either party can be driven Busy (slip) or Careless (timeout).
  Arms: FINISH_PLAIN, LEXICON_DEFAULT, IF_CALC_BLAKE, IF_NONCE_ACK, STRESS_BLAKE + sigma1/3/2.
  Run: check.py --prove ceremonies/alex_blake_kdf/P1_calc_pressure.spthy
*/

#define FINISH_PLAIN
#define LEXICON_DEFAULT
#define IF_CALC_BLAKE
#define IF_NONCE_ACK
#define STRESS_BLAKE
#define SIGMA1_LOAD
#define SIGMA3_DEADLINE
#define SIGMA2_CONCURRENCY

#include "base.spthy"

// sanity: an unstressed run completes with agreeing keys.
lemma P1_attentive_ok:
  exists-trace
  "Ex k #i #j #f. Key('Alex',k)@i & Key('Blake',k)@j & Finish('Alex')@f"

// each CALC failure mode is reachable (Busy slip, Careless timeout):
lemma P1_slip_reachable:
  exists-trace "Ex p #o. Slip(p)@o"

lemma P1_timeout_reachable:
  exists-trace "Ex p #o. Timeout(p)@o"

// MULTI-PARTY: Blake (not only Alex) degrades and slips.
lemma P1_blake_slips:
  exists-trace
  "Ex k #o. Calc('Blake','Busy')@o & Key('Blake',k)@o & not(Ex a b. k = kdf(a,b))"

// unsafe-success driven by EITHER party: a completed run whose keys disagree.
lemma P1_either_party_disagreement:
  exists-trace
  "Ex ka kb #i #j #f. Key('Alex',ka)@i & Key('Blake',kb)@j & Finish('Alex')@f & not(ka = kb)"

// THE GATE: a stressor onset happens only for an ENABLED party.
lemma P1_load_requires_enable:
  all-traces
  "All p #l. Load(p)@l ==> (Ex #s. StressOn(p)@s & #s < #l)"

// a Busy CALC can never produce a correct kdf key (either party).      [Protocol Vulnerability]
lemma P1_busy_no_correct_key:
  all-traces
  "All p k #i. (Calc(p,'Busy')@i & Key(p,k)@i) ==> not(Ex a b. k = kdf(a,b))"

end
