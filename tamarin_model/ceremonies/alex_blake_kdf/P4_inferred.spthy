theory ToyCeremony_P4_Inferred
begin

/*
  P4 -- the fully-inferred stressor tier (the usability-analyzer direction): every stressor is inferred
  from the ceremony itself, no declared flags. A token-bounded harness poses compute, verify and
  decision operations; the core detectors infer sigma1 (from a 'kdf' compute), sigma6 (from a 'verify'
  compare), sigma10 (chained off a slip's !Failed) and sigma9 (from decision density). Self-contained:
  does NOT use base.spthy (no KDF wire / finish) -- the infer harness is the poser.
  Run: check.py --prove ceremonies/alex_blake_kdf/P4_inferred.spthy
*/

#define KDF_INIT
#define STRESS_ALEX
#define INFER_HARNESS
#define COMPUTE_OPRESULT
#define LEXICON_DEFAULT
#define MASK_COMPUTE
#define MASK_COMPARE
#define MASK_COMPARE_VERIFYDONE
#define MASK_DECIDE
#define SIGMA1_LOAD
#define SIGMA6_ABSTRACTION
#define SIGMA10_REPEATFAIL
#define SIGMA9_ALERTVOLUME

#include "../../core/framework.spthy"
#include "protocol.spthy"
#include "../../core/demands.spthy"
#include "../../core/masks.spthy"
#include "../../core/stressors.spthy"

// sigma1 inferred -> Busy slip.
lemma P4_inferred_slip:
  exists-trace
  "Ex #l #o. Load('Alex')@l & Slip('Alex')@o & #l < #o"

// sigma6 inferred -> Naive mistake (on a tampered fingerprint).
lemma P4_inferred_mistake:
  exists-trace
  "Ex vid #a #o #t. Abstraction('Alex')@a & Mistake('Alex',vid)@o & TamperedFp('Alex',vid)@t"

// CHAINING: a slip (failure) -> inferred sigma10 -> Careless timeout.
lemma P4_chaining_escalation:
  exists-trace
  "Ex #f #r #t. Slip('Alex')@f & RepeatedFailure('Alex')@r & Timeout('Alex')@t
                & #f < #r & #r < #t"

// DECISION DENSITY: >=3 handled decisions -> inferred sigma9 fatigue.
lemma P4_inferred_fatigue:
  exists-trace
  "Ex #v. AlertVolume('Alex')@v"

// inference soundness: the sigma10 escalation arises only after a prior failure.
lemma P4_escalation_requires_failure:
  all-traces
  "All p #i. RepeatedFailure(p)@i ==> (Ex #f. Slip(p)@f & #f < #i)"

// every inferred onset is for an ENABLED party (the Stage B gate holds in the inferred tier too).
lemma P4_load_requires_enable:
  all-traces
  "All p #l. Load(p)@l ==> (Ex #s. StressOn(p)@s & #s < #l)"

end
