/*
  bundles/approve_phase.spthy -- the APPROVE_REQ phase repertoire in one include.
  Producer (the approval UI: self + injected prompts) + every mask that answers a prompt + the
  sigma8 Habituation stressor. The Busy/Careless approve answers are reachable only when a prior
  CALC stressor has carried that mask in (the persistent-mask design); Habituated arises from the
  in-phase history (two prior Attentive approvals).

  Requires a !Session, so pair with protocol/session.spthy and a CALC producer (calc_phase bundle
  or protocol/msg3_inline.spthy) plus bundles/human_common.spthy. Adding a new APPROVE stressor =
  one include line here.
*/

// -- producer --
#include "../protocol/approval_ui.spthy"

// -- masks (every f_H for APPROVE_REQ) --
#include "../../../core/masks/attentive_approve.spthy"
#include "../../../core/masks/busy_approve.spthy"
#include "../../../core/masks/careless_approve.spthy"
#include "../../../core/masks/habituated_approve.spthy"

// -- stressors targeting APPROVE_REQ --
#include "../../../core/stressors/habituation.spthy"
