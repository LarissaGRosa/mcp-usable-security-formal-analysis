theory ToyCeremony_P2_PostKdfRecovery
begin

/*
  P2 -- the post-KDF phases under stress, with recovery. An unstressed KDF brings up the session;
  then each control is posed with its stressor: APPROVE + sigma8 Habituation (auto-approve),
  VERIFY + sigma6 Abstraction (accept tampered), AUTHORIZE + SecurityAnxiety (Fearful abort), and
  warning_ui recovers the user to Attentive.
  Run: check.py --prove ceremonies/alex_blake_kdf/P2_postkdf_recovery.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline (Attentive here)
#include "protocol/finish.spthy"
#include "bundles/human_common.spthy"

// -- one phase kit + its stressor per line --
#include "phases/approve.spthy"
#include "../../core/stressors/habituation.spthy"       // sigma8
#include "phases/verify.spthy"
#include "../../core/stressors/abstraction.spthy"       // sigma6
#include "phases/authorize.spthy"
#include "../../core/stressors/security_anxiety.spthy"  // Anxiety
#include "protocol/warning_ui.spthy"                    // recovery -> Attentive

#include "experiments/P2_postkdf_recovery.spthy"

end
