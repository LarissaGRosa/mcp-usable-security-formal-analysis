theory ToyCeremony_P9_Population
begin

/*
  P9 -- per-population calibration. The CALC phase for the EXPERT population (population_expert rates
  compute demand 'lo'): 'lo' < the 'hi' threshold (!AtLeast band), so sigma1 cannot fire and the
  expert never slips. Contrast P1 (novice/baseline lexicon): slip reachable. The pair is the RFC
  population argument. Run: check.py --prove ceremonies/alex_blake_kdf/P9_population.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline
#include "protocol/finish.spthy"
#include "bundles/human_manual.spthy"     // manual layer -- population below is the demand profile
#include "../../core/population_expert.spthy"   // compute = low Mental+Temporal demand

#include "../../core/stressors/cognitive_load.spthy"   // sigma1 -- cannot fire at 'lo'

#include "experiments/P9_population.spthy"

end
