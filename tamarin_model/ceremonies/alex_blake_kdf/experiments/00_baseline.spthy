/*
  experiments/00_baseline.spthy -- Experiment 00 · Baseline lemmas (L0_*).
  Lemmas only; included last by 00_baseline.spthy.
*/

// sanity: the ceremony can finish
lemma L0_completes:
  exists-trace
  "Ex #i. Finish('Alex') @ i"

// honest run => same SK (shared variable k forces equality on both Key facts)
lemma L0_agreement:
  exists-trace
  "Ex k #i #j. Key('Alex',k)@i & Key('Blake',k)@j"
