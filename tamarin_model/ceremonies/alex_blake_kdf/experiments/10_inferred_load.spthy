/*
  experiments/10_inferred_load.spthy -- Experiment 10 · sigma1 HighCognitiveLoad, INFERRED.
  Proof-of-concept of the usability-analyzer approach (plan §"infer stressors from the steps"):
  the stressor is NOT declared by the designer -- it is INFERRED from the operation the human is
  asked to perform (producing a kdf), by a core detector that reads the term structure. Lemmas only.
*/

// sanity: an Attentive user computes the operation correctly.
lemma L10_attentive_ok:
  exists-trace
  "Ex k #i. Calc('Alex','Attentive')@i & Key('Alex',k)@i"

// the inferred load drives Busy -> slip (no usability flag was supplied).
lemma L10_inferred_load_causes_slip:
  exists-trace
  "Ex #s #o. Load('Alex')@s & Slip('Alex')@o & #s < #o"

// inference is GROUNDED in the step: load is inferred only when a kdf computation was posed.
//                                                                   [Safety: inference soundness]
lemma L10_load_grounded_in_kdf_op:
  all-traces
  "All p #i. Load(p)@i ==> (Ex #j. PoseOp(p, 'kdf')@j & #j < #i)"

// a Busy slip never yields the required kdf key.                    [Protocol Vulnerability]
lemma L10_busy_no_correct_key:
  all-traces
  "All p k #i. (Calc(p,'Busy')@i & Key(p,k)@i) ==> not(Ex a b. k = kdf(a,b))"
