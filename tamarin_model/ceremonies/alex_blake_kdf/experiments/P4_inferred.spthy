/*
  experiments/P4_inferred.spthy -- Profile P4 · the INFERRED-stressor tier (L_P4_*).
  Consolidates old 10 / 11 / 12 / 15: every stressor is inferred from the ceremony itself (the
  usability-analyzer direction), no declared flags. Operation-inference (sigma1 from 'kdf', sigma6
  from 'verify'), trace-inference by prior failure (sigma10, chained off a sigma1 slip), and
  trace-inference by decision density (sigma9). Broad lemmas: each inferred outcome reachable, plus
  the cheap inference-soundness groundings.
*/

// sigma1 inferred -> Busy slip.
lemma P4_inferred_slip:
  exists-trace
  "Ex #l #o. Load('Alex')@l & Slip('Alex')@o & #l < #o"

// sigma6 inferred -> Naive mistake (on a tampered fingerprint).
lemma P4_inferred_mistake:
  exists-trace
  "Ex vid #a #o #t. Abstraction('Alex')@a & Mistake('Alex',vid)@o & TamperedFp('Alex',vid)@t"

// CHAINING (old 12): a slip (failure) -> inferred sigma10 -> Careless timeout.
lemma P4_chaining_escalation:
  exists-trace
  "Ex #f #r #t. Slip('Alex')@f & RepeatedFailure('Alex')@r & Timeout('Alex')@t
                & #f < #r & #r < #t"

// DECISION DENSITY (old 15): >=3 handled decisions -> inferred sigma9 fatigue.
lemma P4_inferred_fatigue:
  exists-trace
  "Ex #v. AlertVolume('Alex')@v"

// inference soundness: the sigma10 escalation arises only after a prior failure.
lemma P4_escalation_requires_failure:
  all-traces
  "All p #i. RepeatedFailure(p)@i ==> (Ex #f. Slip(p)@f & #f < #i)"

// every inferred onset is for an ENABLED party (the Stage B gate holds in the inferred tier too).
lemma P4_load_requires_enable:
  all-traces
  "All p #l. Load(p)@l ==> (Ex #s. StressOn(p)@s & #s < #l)"
