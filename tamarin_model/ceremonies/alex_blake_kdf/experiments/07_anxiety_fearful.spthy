/*
  experiments/07_anxiety_fearful.spthy -- Experiment 07 · SecurityAnxiety -> Fearful -> abort.
  sigma5 SecurityAnxiety on the AUTHORIZE phase drives Attentive -> Fearful, who ABORTS the
  authorization (withdrawal). A safe-fail (the operation is not authorized), but by active
  refusal rather than Careless's passive timeout. Lemmas only.
*/

// sanity: an Attentive user authorizes the request.
lemma L7_attentive_ok:
  exists-trace
  "Ex p aid #i. Authorize(p, aid, 'Attentive')@i"

// failure reachable: anxiety -> Fearful -> abort.
lemma L7_anxiety_causes_abort:
  exists-trace
  "Ex p aid #s #o. SecurityAnxiety(p)@s & Abort(p,aid)@o & #s < #o"

// every abort is preceded by its stressor (Fearful sets in via SecurityAnxiety).  [Safety: causality]
lemma L7_abort_requires_anxiety:
  all-traces
  "All p aid #o. Abort(p,aid)@o ==> (Ex #s. SecurityAnxiety(p)@s & #s < #o)"

// once anxious (Fearful), the sensitive operation is never authorized.            [§2 safe-fail]
lemma L7_anxiety_blocks_authorization:
  all-traces
  "All p aid #i. Authorized(p,aid)@i ==> not (Ex #s. SecurityAnxiety(p)@s & #s < #i)"
