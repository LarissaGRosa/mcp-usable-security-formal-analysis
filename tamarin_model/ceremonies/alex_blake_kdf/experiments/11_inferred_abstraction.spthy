/*
  experiments/11_inferred_abstraction.spthy -- Experiment 11 · sigma6 Abstraction, INFERRED.
  The stressor is inferred from the operation (a 'verify' over an opaque fingerprint), not
  declared: a core detector reads op='verify' and sets Naive, who then makes a mistake --
  accepting an adversary-tampered fingerprint. Lemmas only.
*/

// sanity: an Attentive user accepts a genuine fingerprint.
lemma L11_attentive_ok:
  exists-trace
  "Ex p vid #i. Verify(p, vid, 'Attentive')@i"

// inferred abstraction -> Naive -> mistake: accepts an adversary-TAMPERED fingerprint.
lemma L11_inferred_abstraction_causes_mistake:
  exists-trace
  "Ex p vid #s #t #o. Abstraction(p)@s & TamperedFp(p,vid)@t & Mistake(p,vid)@o & #s < #o"

// inference is GROUNDED in the step: abstraction is inferred only when a verify op was posed.
//                                                                   [Safety: inference soundness]
lemma L11_abstraction_grounded_in_verify:
  all-traces
  "All p #i. Abstraction(p)@i ==> (Ex #j. PoseOp(p, 'verify')@j & #j < #i)"

// an Attentive user NEVER accepts a tampered fingerprint (it requires the genuine marker).
//                                                                   [§2 safe]
lemma L11_attentive_never_accepts_tampered:
  all-traces
  "All p vid #i. Verify(p, vid, 'Attentive')@i ==> not (Ex #j. TamperedFp(p,vid)@j)"
