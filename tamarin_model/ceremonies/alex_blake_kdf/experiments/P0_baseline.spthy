/*
  experiments/P0_baseline.spthy -- Profile P0 · baseline walking skeleton (Attentive only).
  The unperturbed ceremony the failure profiles are measured against. Lemmas only.
*/

// sanity: the ceremony can finish.
lemma P0_completes:
  exists-trace
  "Ex #i. Finish('Alex') @ i"

// honest run => same SK (shared variable k forces equality on both Key facts).
lemma P0_agreement:
  exists-trace
  "Ex k #i #j. Key('Alex',k)@i & Key('Blake',k)@j"
