/*
  experiments/09_all_stressors.spthy -- Experiment 09 · EVERYTHING (all stressors, masks, phases).
  The maximal worst-case profile: all six stressors, all five degraded masks, all four phases
  (CALC_SK, APPROVE_REQ, VERIFY_KEY, AUTHORIZE) + recovery, on one human. Studies that every
  failure remains REACHABLE and the per-stressor safety properties still compose. Lemmas only.
  (Mostly exists-trace -- cheap; plus two recovery-safe all-traces invariants.)
*/

// sanity: a fully-attentive user can still complete through to authorization.
lemma L9_happy_path:
  exists-trace
  "Ex aid #i. Authorized('Alex', aid)@i"

// every degraded outcome is still reachable in the unified ceremony:
lemma L9_slip_reachable:
  exists-trace "Ex p #o. Slip(p)@o"

lemma L9_mistake_reachable:
  exists-trace "Ex p vid #o #t. Mistake(p,vid)@o & Tampered(vid)@t"

lemma L9_autoapprove_injected_reachable:
  exists-trace "Ex p pid #o #j. AutoApprove(p,pid)@o & Injected(pid)@j"

lemma L9_abort_reachable:
  exists-trace "Ex p aid #o. Abort(p,aid)@o"

// composition preserves per-stressor safety (holds even with recovery present):
lemma L9_mistake_requires_abstraction:
  all-traces
  "All p vid #o. Mistake(p,vid)@o ==> (Ex #s. Abstraction(p)@s & #s < #o)"

lemma L9_attentive_never_accepts_tampered:
  all-traces
  "All p vid #i. Verify(p,vid,'Attentive')@i ==> not (Ex #j. Tampered(vid)@j)"
