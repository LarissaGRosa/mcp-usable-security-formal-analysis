/*
  experiments/08_timepressure_busy.spthy -- Experiment 08 · TimePressure -> Busy -> slip.
  sigma3 TimePressure is a second route to the Busy mask (besides sigma1): a deadline on the
  CALC_SK step makes the user rush and slip. Reuses the Busy CALC f_H; no new phase. Lemmas only.
*/

// sanity: the unrushed Attentive path still computes a correct key.
lemma L8_attentive_ok:
  exists-trace
  "Ex p k #i. Calc(p,'Attentive')@i & Key(p,k)@i"

// failure reachable: time pressure -> Busy -> slip.
lemma L8_timepressure_causes_slip:
  exists-trace
  "Ex p #s #o. TimePressure(p)@s & Slip(p)@o & #s < #o"

// in this experiment Busy comes only from time pressure: every slip is preceded by it.
//                                                                   [Safety: stressor causality]
lemma L8_slip_requires_timepressure:
  all-traces
  "All p #o. Slip(p)@o ==> (Ex #s. TimePressure(p)@s & #s < #o)"

// a Busy CALC_SK never yields a correct kdf key (same vulnerability as sigma1).
//                                                                   [Protocol Vulnerability]
lemma L8_busy_no_correct_key:
  all-traces
  "All p k #i. (Calc(p,'Busy')@i & Key(p,k)@i) ==> not(Ex a b. k = kdf(a,b))"
