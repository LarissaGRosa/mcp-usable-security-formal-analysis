/*
  experiments/P6_mitigations.spthy -- Profile P6 · three mitigations, one ceremony (L_P6_*).
  Consolidates the failure<->fix pairs old 16 / 14 / 17. The degradations still arise (Busy slip,
  Habituated, Naive), but each Poka-Yoke neutralizes its consequence:
    * shutdown   (key-confirmation, msg3_request_confirmed): a slip is caught -> ShutdownAbort.
    * shutout    (number-matching MFA, approval_shutout_ui + mitigations): no injected approval.
    * verify-shutout (device fingerprint compare, mitigations): no tampered acceptance.
  Broad lemmas: each degradation still reachable, each consequence proven unreachable.
*/

// the degradations still arise:
lemma P6_shutdown_catches_slip:
  exists-trace "Ex #s #a. Slip('Alex')@s & ShutdownAbort('Alex')@a"

lemma P6_habituation_still_happens:
  exists-trace "Ex #h. Habituate('Alex')@h"

lemma P6_naive_still_arises:
  exists-trace "Ex p vid #i. Verify(p, vid, 'Naive')@i"

// FIX 1 (shutdown): a slip can never complete the ceremony.
lemma P6_no_slip_completion:
  all-traces
  "not (Ex #s #f. Slip('Alex')@s & Finish('Alex')@f)"

// FIX 2 (shutout): no adversary-injected prompt is ever approved.
lemma P6_shutout_blocks_injected:
  all-traces
  "All p pid m #i. Approve(p,pid,m)@i ==> not (Ex #j. Injected(pid)@j)"

// FIX 3 (verify-shutout): a mistake can never land on a tampered fingerprint.
lemma P6_no_tampered_mistake:
  all-traces
  "All p vid #o. Mistake(p,vid)@o ==> not (Ex #j. Tampered(vid)@j)"
