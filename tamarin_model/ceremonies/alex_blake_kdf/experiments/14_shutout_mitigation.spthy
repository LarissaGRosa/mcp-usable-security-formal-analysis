/*
  experiments/14_shutout_mitigation.spthy -- Experiment 14 · the σ₈ shutout MITIGATION.
  The "fix verified" half of the MFA-fatigue pair: same habituation as Experiment 02, but the
  injected prompt is number-matching (Shutout-protected). The user STILL habituates, yet a
  Habituated user can no longer auto-approve the injected prompt -- the prompt-bombing breach of
  Experiment 02 (`L2_habituated_autoapproves_injected`) is neutralized. Lemmas only.
*/

// sanity: an Attentive user still verifies a self prompt.
lemma L14_attentive_ok:
  exists-trace
  "Ex pid #a. Approve('Alex', pid, 'Attentive')@a"

// the mitigation does NOT prevent the cognitive state: the user still becomes Habituated.
lemma L14_habituation_still_happens:
  exists-trace
  "Ex #h. Habituate('Alex')@h"

// THE FIX: with number-matching shutout, no adversary-injected prompt is ever approved
// (auto-approve is blocked on shutout prompts; Attentive only approves its own 'self' prompts).
//                                                                   [mitigation neutralizes the breach]
lemma L14_shutout_blocks_injected:
  all-traces
  "All p pid m #i. Approve(p,pid,m)@i ==> not (Ex #j. Injected(pid)@j)"
