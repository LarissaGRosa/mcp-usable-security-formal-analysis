/*
  experiments/slice2_habituation.spthy -- Phase 1 · Slice 2 lemmas (L2_*).
  sigma8 Habituation -> Habituated mask -> auto_approve, on the APPROVE_REQ UI phase.
  Lemmas only; included last by ceremony_slice2.spthy.
*/

// sanity: an Attentive (verified) approval is reachable -- the careful baseline.
lemma L2_approve_attentive_ok:
  exists-trace
  "Ex p pid #i. Approve(p, pid, 'Attentive')@i"

// failure chain reachable: after habituation, an adversary-INJECTED prompt is auto-approved
// (the MFA prompt-bombing breach).                                  [feedback-loop §4]
lemma L2_habituated_autoapproves_injected:
  exists-trace
  "Ex p pid #h #j #o.
      Habituate(p)@h & Injected(pid)@j & AutoApprove(p, pid)@o & #h < #o"

// every habituation is preceded by >= 2 DISTINCT prior Attentive approvals.
//                                                                   [Safety: Stressor Causality]
lemma L2_habituation_causality:
  all-traces
  "All p #h. Habituate(p)@h ==>
      (Ex pid1 pid2 #a #b. Approve(p, pid1, 'Attentive')@a
                         & Approve(p, pid2, 'Attentive')@b
                         & #a < #h & #b < #h & not(pid1 = pid2))"

// auto_approve can only happen once the party is habituated (derived mask).
//                                                                   [Protocol Vulnerability]
lemma L2_autoapprove_requires_habituation:
  all-traces
  "All p pid #i. AutoApprove(p, pid)@i ==> (Ex #h. Habituate(p)@h & #h < #i)"

// contrast: an Attentive user NEVER approves an injected prompt (it verifies).
//                                                                   [§2 safe vs unsafe]
lemma L2_attentive_never_injected:
  all-traces
  "All p pid #i. Approve(p, pid, 'Attentive')@i ==> not (Ex #j. Injected(pid)@j)"
