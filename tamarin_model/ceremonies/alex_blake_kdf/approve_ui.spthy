/*
  ceremonies/alex_blake_kdf/approve_ui.spthy -- PROTOCOL LAYER, the APPROVE_REQ UI phase.
  This is the "extra ceremony steps / UI" that surfaces sigma8 Habituation: after the KDF
  completes, the ceremony enters an approval phase in which Alex is shown approval prompts
  (think MFA push notifications) that he must consent to.

  Enter_Approval_Phase turns the one-shot AlexDone into a PERSISTENT !Session, so prompts
  can be issued repeatedly by READING it -- no consume-and-reproduce of a linear fact, so
  no sources loop (the §6.2 lesson). Two prompt sources:
    * UI_issue_self_prompt -- a legitimate, session-bound prompt (kind 'self'); fresh ~pid
      is never sent on the wire, so the adversary cannot forge it.
    * UI_inject_prompt     -- an adversary-crafted prompt (kind 'injected'; pid from In),
      modelling MFA prompt-bombing. Injected(pid) marks it for the lemmas.
*/

rule Enter_Approval_Phase:
    [ AlexDone(idA, sk) ]
  --[ SessionUp('Alex') ]->
    [ !Session('Alex', idA, sk) ]

rule UI_issue_self_prompt:
    [ !Session('Alex', idA, sk), Fr(~pid) ]
  --[ PromptShown('Alex', ~pid, 'self') ]->
    [ !Prompt('Alex', ~pid, 'self') ]

rule UI_inject_prompt:
    [ !Session('Alex', idA, sk), In(pid) ]
  --[ PromptShown('Alex', pid, 'injected'), Injected(pid) ]->
    [ !Prompt('Alex', pid, 'injected') ]
