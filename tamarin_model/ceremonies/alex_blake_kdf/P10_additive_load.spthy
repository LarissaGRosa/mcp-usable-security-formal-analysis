theory ToyCeremony_P10_AdditiveLoad
begin

/*
  P10 -- ADDITIVE cognitive load (Sweller). The compute and the nonce-ack are each MODERATE demand
  ('med'), individually below sigma1's 'hi' threshold -- so sigma1 never fires -- yet the two
  moderate loads presented together SUM past it: additive_load fires -> Busy -> the compute slips.
  The contrast (P10_no_solo_load vs P10_additive_busy) is the point.
  Run: check.py --prove ceremonies/alex_blake_kdf/P10_additive_load.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline
#include "protocol/finish.spthy"
#include "interface/nonce_ack.spthy"      // the SECOND moderate step
#include "bundles/human_manual.spthy"     // manual layer -- the moderate seed below is the demand profile

// moderate demand seed (profile-local): compute + confirm are 'med', each sub-threshold for sigma1
rule Seed_moderate_demand [color=#9b51e0]:
    [ ] --[ SeedModerate() ]->
    [ !Demands('compute', 'MentalDemand', 'med'), !Demands('confirm', 'MentalDemand', 'med') ]
restriction OnceModerate: "All #i #j. SeedModerate()@i & SeedModerate()@j ==> #i = #j"

#include "../../core/stressors/cognitive_load.spthy"   // sigma1 -- never fires (nothing is 'hi')
#include "../../core/stressors/additive_load.spthy"    // two 'med' -> Busy

#include "experiments/P10_additive_load.spthy"

end
