/*
  interface/recipient.spthy -- INTERFACE LAYER (orange #f2994a), Blake's pane, V3 layered template.
  Blake's key-derivation control, symmetric to Alex's (interface/sender.spthy). Posing the compute
  step through the interface -- rather than deriving inline -- is what makes Blake ALSO subject to
  the mask machinery (the multi-party story: either party can be driven Busy/Careless on CALC_SK).
*/

rule IF_calc_blake [color=#f2994a]:
    [ BlakeHasNonces(idB, <Na, Nb>), Fr(~rid) ]
  --[ UIStep('Blake', 'calc_sk') ]->
    [ !Step('Blake', ~rid, 'compute'),
      !StepData('Blake', ~rid, kdf(Na, Nb)),
      !UnderDeadline(~rid),
      BlakeAwaitKey(idB, ~rid) ]
