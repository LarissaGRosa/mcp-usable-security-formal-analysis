/*
  interface/nonce_ack.spthy -- INTERFACE LAYER (orange #f2994a): the nonce-acknowledgement control.
  After receiving the peer's nonce, the client shows it for the user to acknowledge/review before
  deriving the key ("you received code XYZ from Blake -- continue?"). This is an EXPOSURE-ONLY
  prompt (state-space discipline, repo MEMORY.md lesson 15): it is POSED (a !Step density detectors
  count) but drives no outcome, so no behaviour answers it and it needs no adapter.

  Its purpose in the model: the CALC surface then has TWO concurrent prompts per party -- the nonce
  acknowledgement AND the key derivation -- which is what sigma2 distraction_concurrent (Wickens'
  Multiple Resource Theory: performance drops under COMPETING demands) reads (k=2, any actions).
  Without a second prompt the concurrency detector cannot fire, so a CALC-only profile that wants
  sigma2 includes this. Bounded once per party.
*/

// reads the PERSISTENT nonce handle (!NoncesSeen from protocol/kdf) so it does not compete with the
// compute prompt for the linear AlexHasNonces token -- both prompts co-exist (the k=2 sigma2 reads).
rule IF_nonce_ack_alex [color=#f2994a]:
    [ !NoncesSeen('Alex', idA, <Na, Nb>), Fr(~pid) ]
  --[ UIStep('Alex', 'nonce_ack'), NonceAck('Alex') ]->
    [ !Step('Alex', ~pid, 'confirm'), !StepData('Alex', ~pid, <Nb, Nb>) ]

rule IF_nonce_ack_blake [color=#f2994a]:
    [ !NoncesSeen('Blake', idB, <Na, Nb>), Fr(~pid) ]
  --[ UIStep('Blake', 'nonce_ack'), NonceAck('Blake') ]->
    [ !Step('Blake', ~pid, 'confirm'), !StepData('Blake', ~pid, <Na, Na>) ]

restriction OnceNonceAckPerParty:
  "All p #i #j. NonceAck(p)@i & NonceAck(p)@j ==> #i = #j"
