theory ToyCeremony_P3_WorstCase
begin

/*
  P3 -- the maximal worst case (§6a): the CALC trio + all post-KDF phases + all their stressors, on
  BOTH parties. Every failure mode stays reachable and the per-stressor safety properties still
  compose. If this stops terminating, narrow the enabled set.
  Run: check.py --prove ceremonies/alex_blake_kdf/P3_worstcase.spthy
*/

#include "spine.spthy"                    // crypto + KDF wire + Alex compute pipeline
#include "protocol/finish.spthy"
#include "interface/recipient.spthy"      // Blake computes (P3_blake_slips)
#include "interface/nonce_ack.spthy"      // second prompt -> sigma2
#include "bundles/human_common.spthy"
#include "protocol/stress_blake.spthy"    // multi-party

// -- CALC trio --
#include "../../core/stressors/cognitive_load.spthy"           // sigma1
#include "../../core/stressors/time_pressure_deadline.spthy"   // sigma3
#include "../../core/stressors/distraction_concurrent.spthy"   // sigma2
// -- post-KDF phases + their stressors --
#include "phases/approve.spthy"
#include "../../core/stressors/habituation.spthy"              // sigma8
#include "phases/verify.spthy"
#include "../../core/stressors/abstraction.spthy"              // sigma6
#include "phases/authorize.spthy"
#include "../../core/stressors/security_anxiety.spthy"         // Anxiety

#include "../../core/usability_properties.spthy"               // generic invariants (proven here)

#include "experiments/P3_worstcase.spthy"

end
