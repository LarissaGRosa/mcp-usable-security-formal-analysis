theory ToyCeremony_Slice3
begin

/*
  ENTRY POINT -- Phase 1 · Slice 3 (third stressor + third mask).
  Profile (mask_machinery_formalization.md §6.1):
      E_3 = < C0, {Attentive, Careless}, {sigma2 ExternalDistraction} >, one f_M edge.

  Built on the SAME CALC_SK request flow as Slice 1 (reuses attentive_calc + the request/ack
  protocol), but swaps the stressor/mask/outcome: distraction drives Attentive -> Careless,
  whose response is a timeout (disengagement) rather than Busy's slip. This makes the failure
  SAFE-FAIL (the ceremony stalls) instead of unsafe-success. §6.5: one stressor per slice.
  §6.2 derived-mask throughout.
  Run:  python3 .claude/skills/model-tamarin/check.py --prove \
          tamarin_model/ceremonies/alex_blake_kdf/ceremony_slice3.spthy
*/

#include "../../core/types.spthy"
#include "../../core/masks/attentive_calc.spthy"
#include "../../core/masks/careless_calc.spthy"
#include "../../core/stressors/external_distraction.spthy"
#include "../../core/transitions/from_attentive_distraction.spthy"

#include "init.spthy"
#include "messages.spthy"
#include "requests.spthy"

#include "experiments/slice3_distraction.spthy"

end
