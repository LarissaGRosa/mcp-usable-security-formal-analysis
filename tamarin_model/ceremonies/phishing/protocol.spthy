/*
  ceremonies/phishing/protocol.spthy -- shared protocol for the BELIEF-STATE demonstration (ROADMAP #5).

  The human layer so far models degraded EXECUTION (slip / timeout / auto-approve / no-mental-model
  mistake). It does NOT model wrong BELIEFS -- the human acting CORRECTLY on a false picture of the
  world. This is the phishing / spoofed-origin class: the human believes the peer is Blake and shares
  the secret accordingly, but the displayed identity was spoofed, so the secret reaches the adversary.
  Crucially the human is ATTENTIVE and behaves consistently with its belief -- the breach is the
  belief<->reality gap, ORTHOGONAL to the mask layer (no degradation needed).

  Belief(P, id, ch) = P believes it is dealing with identity `id`, over channel `ch`. How that belief
  is FORMED is the identity interface (identity_weak / identity_strong) -- the #2 demand-transformer idea
  applied to authentication. Here: Present sets up the session (honest -> real channel + a verifiable
  binding; spoofed -> adversary channel, no valid binding); the Attentive human shares with whomever it
  BELIEVES is Blake; delivery to the real channel keeps the secret off the wire, to the adversary leaks it.
*/

// honest presentation: the peer really is Blake (real channel) and a verifiable binding exists.
rule Present_honest:
    [ ]
  --[ Present('honest') ]->
    [ Claimed('Alex', 'Blake'), Channel('Alex', 'real'), Verified('Blake', 'real') ]

// spoofed presentation: the adversary stands up a channel but the display still claims 'Blake'.
// No valid binding is produced -- the adversary cannot forge the credential (the PKI assumption).
rule Present_spoofed:
    [ In(lure) ]
  --[ Present('spoofed'), Spoofed() ]->
    [ Claimed('Alex', 'Blake'), Channel('Alex', 'adversary') ]

restriction OncePresent:
  "All x y #i #j. Present(x)@i & Present(y)@j ==> #i = #j"

// an ATTENTIVE human shares the secret with the peer it BELIEVES is Blake (correct FOR ITS BELIEF).
rule Share_attentive:
    [ Belief('Alex', 'Blake', ch), Fr(~m) ]
  --[ Secret(~m), RespMask('Alex','Attentive'), SharesBelieving('Alex','Blake') ]->
    [ Deliver(ch, ~m) ]

// delivery: the real channel keeps the secret off the wire; the adversary channel leaks it.
rule Deliver_real:
    [ Deliver('real', m) ] --[ DeliveredTo('real', m) ]-> [ ]
rule Deliver_adversary:
    [ Deliver('adversary', m) ] --[ DeliveredTo('adversary', m) ]-> [ Out(m) ]
