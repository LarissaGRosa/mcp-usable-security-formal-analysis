theory PhishStrong
begin

/*
  PROFILE PhishStrong -- the same ceremony under a STRONG identity interface (ROADMAP #5; the #2 fix).
  The human forms its belief ONLY from a verified binding, so a spoofed display cannot produce the false
  belief: the Attentive human does not proceed, and the secret never leaks -- EVEN though the adversary
  may still attempt a spoofed presentation. Contrast PhishWeak (breach reachable): the proof pair yields
  the RFC requirement -- "implementations MUST bind the displayed peer identity to a verified credential
  (not a raw displayed claim)."
  Run: check.py --prove ceremonies/phishing/PhishStrong.spthy
*/

#include "protocol.spthy"
#include "identity_strong.spthy"

// the ceremony still works honestly: the Attentive human shares believing in Blake.
lemma PhishStrong_honest_ok:
  exists-trace
  "Ex #s. SharesBelieving('Alex','Blake')@s"

// the secret NEVER leaks -- the strong identity interface prevents the false belief, so no breach,
// even under adversary spoofing attempts.
lemma PhishStrong_no_phish:
  all-traces
  "All m #s. Secret(m)@s ==> not (Ex #k. K(m)@k)"

end
