/*
  sigma8 Habituation (density) -- fires on >=2 distinct 'confirm' prompts -> Habituated (reflexive
  auto-approve, incl. an injected prompt). Anderson & Vance CHI 2015; MFA prompt-bombing.
  Distinctness restriction is named InequalityHabituation so it can co-exist with sigma9.
*/

rule Trigger_Habituation [color=#eb5757]:
    [ !Step(P, pid1, 'confirm'), !Step(P, pid2, 'confirm'), !StressEnable(P) ]
  --[ Habituate(P), Neq(pid1, pid2), SetMask(P,'Habituated') ]->
    [ ]

restriction InequalityHabituation:
  "All x #i. Neq(x,x)@i ==> F"

restriction OnceHabituate:
  "All p #i #j. Habituate(p)@i & Habituate(p)@j ==> #i = #j"
