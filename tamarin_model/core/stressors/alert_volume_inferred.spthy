/*
  core/stressors/alert_volume_inferred.spthy -- f_U for sigma9 AlertVolume / DecisionFatigue, INFERRED.
  Trace-inference by DECISION DENSITY: being asked to handle many decisions in one ceremony fatigues
  the user. When >=3 DISTINCT decisions have been handled (three distinct persistent !Did facts), the
  detector infers decision fatigue and sets Careless (disengagement). Reads !Did read-only (no
  consume-reproduce). Distinctness via the standard Inequality restriction; bounded once per party
  (OneAlertVolume) so the count reasoning terminates. (MFA prompt-bombing / alert-fatigue anchor.)
*/

rule Detect_AlertVolume:
    [ !Did(P, r1), !Did(P, r2), !Did(P, r3) ]
  --[ AlertVolume(P), Neq(r1,r2), Neq(r1,r3), Neq(r2,r3), SetMask(P,'Careless') ]->
    [ ]

restriction Inequality:
  "All x #i. Neq(x,x)@i ==> F"

restriction OneAlertVolume:
  "All p #i #j. AlertVolume(p)@i & AlertVolume(p)@j ==> #i = #j"
