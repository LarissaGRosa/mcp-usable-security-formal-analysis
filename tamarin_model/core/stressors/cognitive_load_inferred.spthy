/*
  core/stressors/cognitive_load_inferred.spthy -- f_U for sigma1 HighCognitiveLoad, INFERRED.
  Instead of a designer-supplied 'Hard' flag, this detector INSPECTS THE OPERATION the human is
  asked to perform and infers the stressor: a step whose operation is 'kdf' (a key derivation --
  a function the human cannot evaluate in their head) is high cognitive load. The ceremony states
  (objectively) which operation the human performs; the HCI knowledge "kdf is hard" lives HERE.
  At onset it emits SetMask(P,'Busy'). OneLoadPerParty bounds it to one onset per party (else,
  reading the persistent !Op, it would re-fire and blow up mask_state.spthy's interval reasoning).

  NB: we key on the operation NAME (a public constant), not by destructuring the result term --
  matching into a function term like kdf(x,y) trips Tamarin's message-derivation check
  ("unintended pattern matching"); the tag is objectively the same protocol content.
*/

rule Detect_HighCognitiveLoad:
    [ !Op(P, rid, 'kdf', m) ]
  --[ Load(P), SetMask(P,'Busy') ]->
    [ ]

restriction OneLoadPerParty:
  "All p #i #j. Load(p)@i & Load(p)@j ==> #i = #j"
