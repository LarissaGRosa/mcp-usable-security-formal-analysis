/*
  sigma1 HighCognitiveLoad -- reads !Step + a MentalDemand level, fires when it is at least 'hi'
  (the !AtLeast band) -> SetMask Busy. Ceremony-agnostic (names no task). Sweller 1988; NASA-TLX.
*/

rule Trigger_HighCognitiveLoad [color=#eb5757]:
    [ !Step(P, sid, action),
      !Demands(action, 'MentalDemand', lvl), !AtLeast(lvl, 'hi'),
      !StressEnable(P) ]
  --[ Load(P), SetMask(P,'Busy') ]->
    [ ]

restriction OneStressPerParty:
  "All p #i #j. Load(p)@i & Load(p)@j ==> #i = #j"
