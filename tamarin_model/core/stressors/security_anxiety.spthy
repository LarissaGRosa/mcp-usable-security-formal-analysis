/*
  SecurityAnxiety (inverted-U, Yerkes-Dodson 1908) -- fires only at Arousal >= 'hi' (over-arousal,
  right arm of the curve) -> Fearful. 'med' is the facilitating zone below threshold (no fire).
*/

rule Trigger_SecurityAnxiety [color=#eb5757]:
    [ !Step(P, sid, action),
      !Demands(action, 'Arousal', lvl), !AtLeast(lvl, 'hi'),
      !StressEnable(P) ]
  --[ SecurityAnxiety(P), SetMask(P,'Fearful') ]->
    [ ]

restriction OnceSecurityAnxiety:
  "All p #i #j. SecurityAnxiety(p)@i & SecurityAnxiety(p)@j ==> #i = #j"
