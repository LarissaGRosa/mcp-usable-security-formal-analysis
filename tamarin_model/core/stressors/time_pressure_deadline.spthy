/*
  sigma3 TimePressure (situational) -- fires on a prompt the interface presents !UnderDeadline
  -> Busy. Reads interface CONTEXT, not a task or a demand level. Maule & Svenson 1993; TLX Temporal.
*/

rule Trigger_TimePressureDeadline [color=#eb5757]:
    [ !Step(P, pid, action),
      !UnderDeadline(pid),
      !StressEnable(P) ]
  --[ TimePressure(P), SetMask(P,'Busy') ]->
    [ ]

restriction OneTimePressure:
  "All p #i #j. TimePressure(p)@i & TimePressure(p)@j ==> #i = #j"
