/*
  core/stressors/abstraction_inferred.spthy -- f_U for sigma6 Abstraction, INFERRED.
  Infers the stressor from the operation the human is posed: a 'verify' operation over an opaque
  crypto object (a key fingerprint) has no physical analog (Whitten & Tygar #2; the PGP key
  metaphor), so the human cannot meaningfully check it. Keys on the operation TAG 'verify'
  (objective protocol content; NOT by destructuring the operand -- see MEMORY.md #11). At onset
  emits SetMask(P,'Naive'). OneAbstractionPerParty bounds it to one onset per party.
*/

rule Detect_Abstraction:
    [ !Op(P, rid, 'verify', m) ]
  --[ Abstraction(P), SetMask(P,'Naive') ]->
    [ ]

restriction OneAbstractionPerParty:
  "All p #i #j. Abstraction(p)@i & Abstraction(p)@j ==> #i = #j"
