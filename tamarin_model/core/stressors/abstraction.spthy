/*
  sigma6 Abstraction -- fires on a step whose Effort is at least 'hi' (the band) -> Naive.
  Crypto has no physical analog (Whitten & Tygar 1999); NASA-TLX Effort.
*/

rule Trigger_Abstraction [color=#eb5757]:
    [ !Step(P, sid, action),
      !Demands(action, 'Effort', lvl), !AtLeast(lvl, 'hi'),
      !StressEnable(P) ]
  --[ Abstraction(P), SetMask(P,'Naive') ]->
    [ ]

restriction OnceAbstraction:
  "All p #i #j. Abstraction(p)@i & Abstraction(p)@j ==> #i = #j"
