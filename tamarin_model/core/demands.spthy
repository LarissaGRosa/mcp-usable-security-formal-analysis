/*
  core/demands.spthy -- the DEMAND-PROFILE layer: how much workload each action imposes. A profile
  picks exactly one baseline (the novice lexicon) OR a population/interface variant that shifts a
  level, so the lookup detectors (sigma1/3/6) fire or not accordingly. Was:
    core/lexicon_tlx.spthy, core/population_expert.spthy,
    core/interface_hardened_verify.spthy, core/interface_clear_policy.spthy,
    core/interface_misleading_policy.spthy

  flag            was                              effect
  LEXICON_DEFAULT lexicon_tlx.spthy                novice baseline: compute/compare/authorize/share = hi
  POP_EXPERT      population_expert.spthy          expert: compute Mental+Temporal -> lo (sigma1/3 cannot fire)
  IF_HARDENED     interface_hardened_verify.spthy  compare Effort -> lo (sigma6 cannot fire)
  IF_CLEAR        interface_clear_policy.spthy      set-policy control 'clear' (Policy_misleading unreachable)
  IF_MISLEADING   interface_misleading_policy.spthy set-policy control 'misleading' (Policy_misleading fires)
*/

#ifdef LEXICON_DEFAULT
// ===== the novice/default demand lexicon (maps action -> demand dimension + level). =====
rule Seed_lexicon_tlx [color=#9b51e0]:
    [ ]
  --[ SeedLexicon() ]->
    [ !Demands('compute',   'TemporalDemand', 'hi'),
      !Demands('compute',   'MentalDemand',   'hi'),
      !Demands('compare',   'Effort',         'hi'),
      !Demands('authorize', 'Arousal',        'hi'),
      !Demands('share',     'MentalDemand',   'hi'),
      !Demands('share',     'TemporalDemand', 'hi'),
      // field entry is a 'med' step: one field can't fire sigma1/sigma3 (need 'hi'), but two
      // co-present fields feed SIGMA_ADDITIVE (two 'med' prompts -> Busy).
      !Demands('transcribe','MentalDemand',   'med'),
      !Demands('transcribe','TemporalDemand', 'med') ]

restriction OnceLexicon:
  "All #i #j. SeedLexicon()@i & SeedLexicon()@j ==> #i = #j"
#endif

#ifdef POP_EXPERT
// ===== expert population -- LOWERS compute demand to 'lo' so sigma1/sigma3 cannot fire. =====
rule Seed_population_expert [color=#9b51e0]:
    [ ]
  --[ SeedPopulation('expert') ]->
    [ !Demands('compute', 'MentalDemand',   'lo'),
      !Demands('compute', 'TemporalDemand', 'lo'),
      !Population('expert') ]

restriction OncePopulationExpert:
  "All #i #j. SeedPopulation('expert')@i & SeedPopulation('expert')@j ==> #i = #j"
#endif

#ifdef IF_HARDENED
// ===== hardened verify interface -- a REPLACEMENT demand profile, not an addition. !Demands is a
// PERSISTENT fact and demand rows are ADDITIVE, so seeding compare/Effort/'lo' alongside LEXICON_DEFAULT's
// 'hi' row would leave BOTH present and sigma6 would still fire on the 'hi' one. A profile therefore arms
// LEXICON_DEFAULT *xor* IF_HARDENED: this block seeds the SAME lexicon with the ONE row the lever changes
// (the fingerprint view becomes a visual diff -> compare Effort 'lo' -> sigma6 cannot fire). =====
rule Seed_interface_hardened_verify [color=#9b51e0]:
    [ ]
  --[ SeedInterface('hardened_verify') ]->
    [ !Demands('compare',   'Effort',         'lo'),   // <-- the lever
      !Demands('compute',   'TemporalDemand', 'hi'),
      !Demands('compute',   'MentalDemand',   'hi'),
      !Demands('authorize', 'Arousal',        'hi'),
      !Demands('share',     'MentalDemand',   'hi'),
      !Demands('share',     'TemporalDemand', 'hi'),
      !Demands('transcribe','MentalDemand',   'med'),
      !Demands('transcribe','TemporalDemand', 'med'),
      !Interface('hardened_verify') ]

restriction OnceHardenedVerify:
  "All #i #j. SeedInterface('hardened_verify')@i & SeedInterface('hardened_verify')@j ==> #i = #j"
#endif

#ifdef IF_CLEAR
// ===== clear policy control -- honest terminology; Policy_misleading is UNREACHABLE. =====
rule Seed_interface_clear_policy [color=#9b51e0]:
    [ ]
  --[ SeedInterface('clear_policy') ]->
    [ !ControlDesign('set-policy', 'clear'),
      !Interface('clear_policy') ]

restriction OnceClearPolicy:
  "All #i #j. SeedInterface('clear_policy')@i & SeedInterface('clear_policy')@j ==> #i = #j"
#endif

#ifdef IF_MISLEADING
// ===== misleading policy control -- confusing terminology; Policy_misleading fires (task-mediated). =====
rule Seed_interface_misleading_policy [color=#9b51e0]:
    [ ]
  --[ SeedInterface('misleading_policy') ]->
    [ !ControlDesign('set-policy', 'misleading'),
      !Interface('misleading_policy') ]

restriction OnceMisleadingPolicy:
  "All #i #j. SeedInterface('misleading_policy')@i & SeedInterface('misleading_policy')@j ==> #i = #j"
#endif

// ===== the FIELD-DESIGN lever (always seeded, one way or the other) =====
// A text field either carries a standing reminder that its contents are NOT protected, or it does not.
// This is a property of the INTERFACE, so exactly one of the two designs holds in every run -- hence
// #ifdef/#else rather than an opt-in seed (the same shape as LEXICON_DEFAULT xor IF_HARDENED). The key
// names the ACTION CLASS ('transcribe'), never a ceremony field, so core stays agnostic.
//
//   default            -> !ControlDesign('transcribe','plain')  : a careless entry EXPORTS the value
//   IF_FIELD_REMINDER  -> !ControlDesign('transcribe','clear')  : it does not (Transcribe_leak cannot fire)
#ifdef IF_FIELD_REMINDER
rule Seed_field_reminder [color=#9b51e0]:
    [ ] --[ SeedInterface('field_reminder') ]->
    [ !ControlDesign('transcribe', 'clear'), !Interface('field_reminder') ]

restriction OnceFieldReminder:
  "All #i #j. SeedInterface('field_reminder')@i & SeedInterface('field_reminder')@j ==> #i = #j"
#else
rule Seed_field_plain [color=#9b51e0]:
    [ ] --[ SeedInterface('field_plain') ]->
    [ !ControlDesign('transcribe', 'plain') ]

restriction OnceFieldPlain:
  "All #i #j. SeedInterface('field_plain')@i & SeedInterface('field_plain')@j ==> #i = #j"
#endif

#ifdef CUE_PHISH
// ===== phishing lure: the fingerprint-verify step carries a high AUTHORITY persuasion cue ("your admin
// vouches for this key") -- feeds SIGMA_CUE -> Naive on the compare. Same seed mechanism as !Demands. =====
rule Seed_cue_phish [color=#9b51e0]:
    [ ] --[ SeedCue('phish') ]-> [ !Cue('compare', 'authority', 'hi') ]

restriction OnceCuePhish:
  "All #i #j. SeedCue('phish')@i & SeedCue('phish')@j ==> #i = #j"
#endif
