/*
  core/transitions/answered_once.spthy -- shared "answer discipline" restriction.

  Every f_H rule (CALC_SK in core/masks/*_calc, APPROVE_REQ in core/masks/*_approve)
  emits Answered(id) when it consumes a persistent, read-only request/prompt. This single
  restriction keeps each id answered AT MOST ONCE, so the same !Req / !Prompt cannot be
  answered by two different masks (e.g. both an Attentive key and a Busy slip for one rid,
  or both an Attentive and a Habituated response to one prompt).

  Factored out of the per-edge transition files so that several edges can be composed in
  one experiment without a duplicate-restriction-name clash (see 04_multi_stressor).
*/

restriction AnsweredOnce:
  "All x #i #j. Answered(x)@i & Answered(x)@j ==> #i = #j"
