/*
  core/transitions/from_attentive.spthy -- f_M edges out of Attentive.

  The single Phase-0 edge  Attentive --HighCognitiveLoad--> Busy, realized in the
  §6.2 derived-mask style: rather than a MaskShift rule mutating stored state, an
  Attentive (correct) response is forbidden once the party has been stressed, so
  after a Load only the Busy response (core/masks/busy.spthy) remains enabled.
  Monotone: no recovery edge.

  OneAnswer keeps the persistent, read-only !Req from being answered twice (it would
  otherwise admit both an Attentive and a Busy response to the same request).
*/

restriction AttentiveOnlyBeforeLoad:
  "All p #i. RespAttentive(p)@i ==> not (Ex #s. Load(p)@s & #s < #i)"

restriction OneAnswer:
  "All rid #i #j. Answered(rid)@i & Answered(rid)@j ==> #i = #j"
