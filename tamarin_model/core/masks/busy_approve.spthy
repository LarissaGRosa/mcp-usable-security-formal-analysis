/*
  core/masks/busy_approve.spthy -- f_H for the Busy mask, APPROVE_REQ action.
  (Plan §3 matrix: Busy on APPROVE_REQ = auto_approve.)

  A Busy user is rushing: at an approval prompt she clicks through without verifying --
  auto-approving a prompt of ANY kind (self OR injected). This is what makes the
  persist-rule bite: a user driven Busy on the KDF carries that into the approval step and
  auto-approves there too (not a fresh Attentive verify). Current-mask gated by RespMask
  (core/transitions/mask_state.spthy) -> fires only while Busy is the current mask.
*/

rule Approve_Busy_auto:
    [ !Prompt(P, pid, kind) ]
  --[ Approve(P, pid, 'Busy'), RespMask(P,'Busy'), AutoApprove(P, pid),
      Mask(P,'Attentive','Busy'), Answered(pid) ]->
    [ !Approved(P, pid, 'Busy') ]
