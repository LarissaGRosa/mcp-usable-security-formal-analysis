/*
  core/masks/careless_op.spthy -- f_H for the Careless mask, generic OPERATION action.
  A Careless user disengages and times out on the operation: no OpResult (the step stalls,
  safe-fail). RespMask(P,'Careless') is gated by the current-mask restrictions: Careless must be
  the current mask (set e.g. by the inferred RepeatedFailure escalation).
*/

rule Op_Careless_timeout:
    [ !Op(P, rid, op, m) ]
  --[ Calc(P,'Careless'), RespMask(P,'Careless'), Mask(P,'Attentive','Careless'), Timeout(P), Answered(rid) ]->
    [ ]
