/*
  core/masks/policy_behavior.spthy -- f_H for the SET_POLICY action class, CEREMONY-AGNOSTIC (AGNOSTIC_MASKS.md).
  PATHWAY B: a TASK-MEDIATED mistake with NO mask change. Unlike every other behaviour file, this one
  does NOT read !OutcomePolicy -- the outcome is determined by the TASK (the option's terminology
  honesty, carried in !StepData), not by the human's mask. The SAME Attentive user sets a SAFE policy
  under 'clear' terminology and an UNSAFE one (a Mistake) under 'misleading' terminology (the AWS S3
  "Any Authenticated Users" case; sigma4 MisleadingTerminology). It reads the agnostic !Step interface
  for uniformity, but is the task-mediated analogue of the (mask, action) matrix -- the boundary that
  sigma10 has on the detector side (a failure outcome, not a presented-step lookup).

  RespMask(P,'Attentive') is gated by mask_state.spthy: the user is genuinely un-degraded, yet errs.
*/

rule Policy_clear:
    [ !Step(P, pid, 'set-policy'), !StepData(P, pid, 'clear') ]
  --[ SetPolicy(P, pid, 'safe'), RespMask(P,'Attentive'), Answered(pid) ]->
    [ PolicyDone(P, pid) ]

rule Policy_misleading:
    [ !Step(P, pid, 'set-policy'), !StepData(P, pid, 'misleading') ]
  --[ SetPolicy(P, pid, 'unsafe'), Mistake(P, pid), RespMask(P,'Attentive'), Answered(pid) ]->
    [ PolicyDone(P, pid) ]
