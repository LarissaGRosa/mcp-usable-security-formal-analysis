/*
  f_H for AUTHORIZE (granting a sensitive op). Attentive grant (Authorized); Fearful abort (active refusal).
*/

rule Authorize_grant [color=#27ae60]:
    [ !Step(P, aid, 'authorize'), !OutcomePolicy(mask, 'authorize', 'grant') ]
  --[ Authorize(P, aid, mask), RespMask(P, mask), Authorized(P, aid), Answered(aid) ]->
    [ Granted(P, aid) ]

rule Authorize_abort [color=#27ae60]:
    [ !Step(P, aid, 'authorize'), !OutcomePolicy(mask, 'authorize', 'abort') ]
  --[ Authorize(P, aid, mask), RespMask(P, mask), Abort(P, aid), Answered(aid) ]->
    [ ]
