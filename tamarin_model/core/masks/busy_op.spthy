/*
  core/masks/busy_op.spthy -- f_H for the Busy mask, generic OPERATION action.
  A Busy user slips on the posed operation: it emits a FRESH wrong result (top symbol != kdf,
  so it can never equal the required kdf(_,_)). RespMask(P,'Busy') is gated by the current-mask
  restrictions: Busy must be the current mask (set by the inferred HighCognitiveLoad detector).
*/

rule Op_Busy_slip:
    [ !Op(P, rid, op, m), Fr(~wrong) ]
  --[ Calc(P,'Busy'), RespMask(P,'Busy'), Mask(P,'Attentive','Busy'), Slip(P), Key(P, ~wrong), Answered(rid) ]->
    [ OpResult(P, rid, ~wrong) ]
