/*
  f_H for DECIDE (decision-stream items). Attentive handle; Careless fatigue (timeout). No genuineness.
*/

rule Decide_handle [color=#27ae60]:
    [ !Step(P, did, 'decide'), !OutcomePolicy(mask, 'decide', 'handle') ]
  --[ Confirm(P, did, mask), RespMask(P, mask), Handled(P, did), Answered(did) ]->
    [ DecisionDone(P, did) ]

rule Decide_timeout [color=#27ae60]:
    [ !Step(P, did, 'decide'), !OutcomePolicy(mask, 'decide', 'fatigue') ]
  --[ Confirm(P, did, mask), RespMask(P, mask), Timeout(P), Handled(P, did), Answered(did) ]->
    [ DecisionDone(P, did) ]
