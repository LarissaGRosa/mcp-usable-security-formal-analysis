/*
  f_H for COMPARE (ceremony-agnostic). Attentive PERFORMS the check -- fires only when offered =
  reference (the <k,k> pattern), so a substituted artifact stalls. Naive accepts ANY artifact -> a
  Mistake. The verdict is DERIVED here, never producer-declared. Emits a generic Checked (adapter-wrapped).
*/

// Attentive: performs the comparison -- fires only when the offered artifact equals the reference.
rule Compare_attentive [color=#27ae60]:
    [ !Step(P, vid, 'compare'), !StepData(P, vid, <k, k>), !OutcomePolicy(mask, 'compare', 'discerning') ]
  --[ Verify(P, vid, mask), RespMask(P, mask), Accept(P, vid), Answered(vid) ]->
    [ Checked(P, vid) ]

// Naive: accepts ANY artifact -> a Mistake (harmful iff the producer marked the vid Tampered).
rule Compare_naive [color=#27ae60]:
    [ !Step(P, vid, 'compare'), !OutcomePolicy(mask, 'compare', 'credulous') ]
  --[ Verify(P, vid, mask), RespMask(P, mask), Mask(P,'Attentive',mask), Mistake(P, vid), Accept(P, vid), Answered(vid) ]->
    [ Checked(P, vid) ]
