/*
  core/masks/attentive_policy.spthy -- f_H for the Attentive mask, SET_POLICY action.
  PATHWAY B (plan §1): a TASK-MEDIATED mistake with NO mask change. The SAME Attentive user sets a
  SAFE policy when the option terminology is 'clear', but makes a MISTAKE (sets an UNSAFE policy)
  when the terminology is 'misleading' -- e.g. AWS S3 "Any Authenticated Users" actually meaning
  public. The failure is read directly from the request's terminology flag (sigma4
  MisleadingTerminology); it is NOT produced by any stressor/SetMask. RespMask(P,'Attentive') is
  gated by mask_state -- the user is genuinely Attentive (un-degraded), yet errs.
*/

rule Policy_Attentive_clear:
    [ !PolicyReq(P, pid, 'clear') ]
  --[ SetPolicy(P, pid, 'safe'), RespMask(P,'Attentive'), Answered(pid) ]->
    [ PolicyDone(P, pid) ]

rule Policy_Attentive_misleading:
    [ !PolicyReq(P, pid, 'misleading') ]
  --[ SetPolicy(P, pid, 'unsafe'), Mistake(P, pid), RespMask(P,'Attentive'), Answered(pid) ]->
    [ PolicyDone(P, pid) ]
