/*
  core/masks/attentive_verify.spthy -- f_H for the Attentive mask, VERIFY_KEY action.
  An Attentive user actually checks the key fingerprint: it accepts ONLY a genuine one
  (kind 'genuine') and would reject a tampered fingerprint. RespMask(P,'Attentive') is
  gated by the current-mask restrictions (core/transitions/mask_state.spthy).
*/

rule Verify_Attentive:
    [ !VerifyReq(P, vid, 'genuine') ]
  --[ Verify(P, vid, 'Attentive'), RespMask(P,'Attentive'), Accept(P, vid), Answered(vid) ]->
    [ !KeyChecked(P, vid) ]
