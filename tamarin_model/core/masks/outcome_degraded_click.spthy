/*
  Opt-in outcome row: a degraded-but-engaged mask still clicks the final authorize (only Fearful refuses).
*/

rule Seed_degraded_click [color=#9b51e0]:
    [ ]
  --[ SeedDegradedClick() ]->
    [ !OutcomePolicy('Busy',      'authorize', 'grant'),
      !OutcomePolicy('Habituated','authorize', 'grant'),
      !OutcomePolicy('Naive',     'authorize', 'grant'),
      !OutcomePolicy('Careless',  'authorize', 'grant') ]

restriction OnceDegradedClick:
  "All #i #j. SeedDegradedClick()@i & SeedDegradedClick()@j ==> #i = #j"
