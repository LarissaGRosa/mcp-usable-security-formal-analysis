/*
  core/masks/attentive_verify_op.spthy -- f_H for the Attentive mask, VERIFY operation.
  An Attentive user genuinely checks the fingerprint: accepts ONLY a genuine one (marked
  !Genuine by the posing step) and would reject a tampered one. RespMask(P,'Attentive') is
  gated by the current-mask restrictions (core/transitions/mask_state.spthy).
*/

rule Verify_Op_Attentive:
    [ !Op(P, rid, 'verify', m), !Genuine(rid) ]
  --[ Verify(P, rid, 'Attentive'), RespMask(P,'Attentive'), Answered(rid) ]->
    [ VerifyDone(P, rid) ]
