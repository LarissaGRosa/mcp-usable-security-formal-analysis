/*
  core/masks/outcome_policy.spthy -- the human-model OUTCOME MATRIX (agnostic masks, AGNOSTIC_MASKS.md).
  Maps (mask, action-class) -> outcome, the way core/lexicon_tlx.spthy maps action -> demand. This is the
  one place the f_H behaviour knowledge lives; the generic behaviour rules (core/masks/<class>_behavior.spthy)
  read it and bind the mask + outcome, so a ceremony adds no per-action mask files.

  COMPUTE action class (collapses the old Calc_* and Op_* masks).
    Attentive + compute -> correct   (produce the genuine value)
    Busy     + compute -> slip       (a fresh wrong value; top symbol != kdf)
    Careless + compute -> timeout    (no response; safe-fail stall)

  COMPARE action class (collapses the old *_verify and *_verify_op masks). The disposition, not a
  single outcome, because the result depends on whether the artifact is genuine (carried in !StepData):
    Attentive + compare -> discerning  (accepts ONLY a genuine artifact; rejects/stalls on tampered)
    Naive    + compare -> credulous   (accepts ANY artifact -> a process Mistake; harmful iff tampered)

  CONFIRM action class = approval prompts (collapses attentive/busy/careless/habituated_approve). Kind
  in !StepData is 'self' | 'injected'; only Attentive inspects it.
    Attentive  + confirm -> verify-self  (approves ONLY a self prompt; rejects/stalls on injected)
    Busy/Habituated + confirm -> autoapprove (reflexively approves ANY prompt -> AutoApprove)
    Careless   + confirm -> dismiss      (times out; no approval)
  DECIDE action class = decision-stream items (collapses attentive/careless_confirm). No genuineness.
    Attentive + decide -> handle    Careless + decide -> fatigue (timeout)
  AUTHORIZE action class = granting a sensitive op (collapses attentive/fearful_authorize). Unconditional.
    Attentive + authorize -> grant (Authorized)    Fearful + authorize -> abort (active refusal)
  SHARE action class = disclosing a secret over a side channel (collapses attentive/careless/busy_share).
    Attentive -> oob (pw off the wire)   Careless -> inband-leak (LeakPw)   Busy -> misdeliver (MisdeliveredPw)

  Seeded unconditionally so any theory using a behaviour rule stays CLOSED; persistent + read-only ->
  no sources loop (repo MEMORY.md S6.2). OnceOutcomePolicy bounds the seed. As more action classes are
  migrated (compare/confirm/decide/authorize/share), add their rows here -- one table, reused.
*/

rule Seed_outcome_policy:
    [ ]
  --[ SeedOutcomePolicy() ]->
    [ !OutcomePolicy('Attentive', 'compute', 'correct'),
      !OutcomePolicy('Busy',      'compute', 'slip'),
      !OutcomePolicy('Careless',  'compute', 'timeout'),
      !OutcomePolicy('Attentive', 'compare', 'discerning'),
      !OutcomePolicy('Naive',     'compare', 'credulous'),
      // confirm = an approval prompt (MFA push); kind in !StepData is 'self' | 'injected'
      !OutcomePolicy('Attentive', 'confirm', 'verify-self'),
      !OutcomePolicy('Busy',      'confirm', 'autoapprove'),
      !OutcomePolicy('Habituated','confirm', 'autoapprove'),
      !OutcomePolicy('Careless',  'confirm', 'dismiss'),
      // decide = choosing among options (a decision-stream item); no genuineness, so no !StepData
      !OutcomePolicy('Attentive', 'decide',  'handle'),
      !OutcomePolicy('Careless',  'decide',  'fatigue'),
      // authorize = granting a sensitive operation; unconditional (no genuineness)
      !OutcomePolicy('Attentive', 'authorize', 'grant'),
      !OutcomePolicy('Fearful',   'authorize', 'abort'),
      // share = disclosing a secret over a side channel; the outcome manifests differently per mask
      // (a thin per-ceremony effect adapter turns the outcome into the Out/Oob facts)
      !OutcomePolicy('Attentive', 'share', 'oob'),
      !OutcomePolicy('Careless',  'share', 'inband-leak'),
      !OutcomePolicy('Busy',      'share', 'misdeliver') ]

restriction OnceOutcomePolicy:
  "All #i #j. SeedOutcomePolicy()@i & SeedOutcomePolicy()@j ==> #i = #j"
