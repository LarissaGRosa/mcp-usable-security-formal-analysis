/*
  core/masks/busy_calc.spthy -- f_H for the Busy mask, CALC_SK action.

  §6.2 derived-mask: Busy is the CURRENT mask (gated by core/transitions/mask_state.spthy via
  RespMask, which requires a prior SetMask(P,'Busy') that is still latest -- itself produced by
  the Shift rule once HighCognitiveLoad is active). Busy slips: emits a FRESH wrong key whose
  top symbol is not kdf, so it can never equal kdf(_,_). Mask(...) labels the shift for lemmas.
*/

rule Calc_Busy_slip:
    [ !Req(P, rid, 'CALC_SK', <Na,Nb>, c), Fr(~wrong) ]
  --[ Calc(P,'Busy'), RespMask(P,'Busy'), Mask(P,'Attentive','Busy'), Slip(P), Answered(rid), Key(P, ~wrong) ]->
    [ KeyResult(P, rid, ~wrong) ]
