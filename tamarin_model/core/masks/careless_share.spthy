/*
  core/masks/careless_share.spthy -- f_H for the Careless mask, SHARE_PW action.

  The DISENGAGEMENT failure for password sharing: a Careless user takes the convenient shortcut
  and sends the passphrase IN-BAND -- in the same email thread / reply (Out) -- violating the
  guide's rule that the password must travel out-of-band. The recipient STILL gets it (Oob too),
  so the ceremony completes normally and the compromise is SILENT: the adversary, who sees both
  senc(m,pw) and pw on the wire, decrypts the message. LeakPw(P) marks the unsafe disclosure.
  RespMask(P,'Careless') is gated by mask_state.spthy: Careless must be the current mask (set by
  sigma2 ExternalDistraction).
*/

rule Share_Careless_leak:
    [ !Req(P, rid, 'SHARE_PW', <recip, pw>, c) ]
  --[ Share(P,'Careless'), RespMask(P,'Careless'), Answered(rid),
      LeakPw(P), Mask(P,'Attentive','Careless') ]->
    [ Out(pw), Oob(P, recip, pw) ]
