/*
  core/masks/attentive_authorize.spthy -- f_H for the Attentive mask, AUTHORIZE action.
  An Attentive user authorizes a legitimate sensitive request. RespMask(P,'Attentive') is
  gated by the current-mask restrictions (core/transitions/mask_state.spthy).
*/

rule Authorize_Attentive:
    [ !AuthReq(P, aid) ]
  --[ Authorize(P, aid, 'Attentive'), RespMask(P,'Attentive'), Authorized(P, aid), Answered(aid) ]->
    [ !AuthDone(P, aid) ]
