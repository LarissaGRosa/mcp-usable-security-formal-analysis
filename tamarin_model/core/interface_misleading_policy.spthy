/*
  core/interface_misleading_policy.spthy -- the BASELINE design-quality declaration for a
  'set-policy' control: MISLEADING terminology (sigma4). Counterpart of interface_clear_policy;
  see that file's header for the design rationale (interface-level !ControlDesign row, never a
  !StepData tag).

  THIS interface: the control is CONFUSING as commonly shipped -- the AWS-S3 "Any Authenticated
  Users" option (reads as "my org", means "any AWS account"), or a message-expiration control left
  at an over-long default. Under it, Policy_misleading fires: the SAME Attentive user sets an
  UNSAFE policy (a task-mediated Mistake, no mask change). Reachable in P5/S0/S1; contrast P7
  (clear interface -> unsafe policy unreachable). The seed action SeedInterface('misleading_policy')
  is the attribution anchor: a policy Mistake is provable only in traces where this interface was
  in scope (P5_mistake_requires_misleading).
*/

rule Seed_interface_misleading_policy [color=#9b51e0]:
    [ ]
  --[ SeedInterface('misleading_policy') ]->
    [ !ControlDesign('set-policy', 'misleading'),
      !Interface('misleading_policy') ]

restriction OnceMisleadingPolicy:
  "All #i #j. SeedInterface('misleading_policy')@i & SeedInterface('misleading_policy')@j ==> #i = #j"
